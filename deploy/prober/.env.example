# Copy to .env in this directory and fill in.

# The PUBLIC key verge rendered under Probers at provisioning. One line,
# starting with e.g. "ssh-ed25519 AAAA...". This is NOT a secret and is NOT a
# private key — the recipe refuses a private key.
PROBER_PUBKEY=

# The host port the instance connects to (what you type into verge as "port").
# Defaults to 22. Map a different one if 22 is taken on this host.
# PROBER_SSH_PORT=22

# Optional. Once verge renders your instance's egress address, set it here to
# pin the key to that source with from= (§3). Leave empty until then.
# PROBER_FROM=203.0.113.5
