{
  "$comment": "Per-screen capture states. Each state: route + JS run before capture. The SAME scripts drive golden rendering and repo capture. Crop to `main` until shell (#22) lands.",
  "inventory": {
    "route": "/inventory",
    "crop": "main",
    "states": [
      {
        "id": "default",
        "js": ""
      },
      {
        "id": "expanded",
        "js": "document.querySelectorAll('.inv-exp').forEach(function(b){ b.click(); })"
      },
      {
        "id": "gaps-only",
        "js": "var g=document.getElementById('inv-gaps'); g.checked=true; g.dispatchEvent(new Event('change',{bubbles:true}))"
      },
      {
        "id": "filtered-empty",
        "js": "var q=document.getElementById('inv-q'); q.value='zzz'; q.dispatchEvent(new Event('input',{bubbles:true}))"
      },
      {
        "id": "columns-open",
        "js": "document.getElementById('inv-cols-btn').click()"
      }
    ]
  },
  "error": {
    "crop": "main",
    "states": [
      {
        "id": "404",
        "route": "/this-route-does-not-exist",
        "session": "admin",
        "js": ""
      },
      {
        "id": "403",
        "route": "/dev/403",
        "session": "viewer",
        "js": ""
      },
      {
        "id": "500",
        "route": "/dev/panic",
        "session": "admin",
        "js": ""
      },
      {
        "id": "missing-subject",
        "route": "/asset/stagng-5.acmecorp.io",
        "session": "admin",
        "js": ""
      },
      {
        "id": "missing-run",
        "route": "/runs/1408",
        "session": "admin",
        "js": ""
      },
      {
        "id": "settings-forbidden",
        "route": "/settings",
        "session": "viewer",
        "js": ""
      }
    ]
  },
  "profile": {
    "crop": "main",
    "states": [
      {
        "id": "default",
        "route": "/profile",
        "session": "admin",
        "js": ""
      },
      {
        "id": "new-token",
        "route": "/profile?new=1",
        "session": "admin",
        "js": ""
      },
      {
        "id": "minted",
        "route": "/profile?new=1",
        "session": "admin",
        "js": "var i=document.querySelector('#pr-tokform input[name=name]'); i.value='ci-golden'; document.getElementById('pr-tokform').submit();",
        "delay": 900
      },
      {
        "id": "revoke-token",
        "route": "/profile?revoke=t1",
        "session": "admin",
        "js": ""
      },
      {
        "id": "end-session",
        "route": "/profile?endsession=1",
        "session": "admin",
        "js": ""
      },
      {
        "id": "signout-others",
        "route": "/profile?signoutothers=1",
        "session": "admin",
        "js": ""
      }
    ]
  },
  "signin": {
    "crop": "body",
    "states": [
      {
        "id": "login",
        "route": "/login",
        "session": "none",
        "js": ""
      },
      {
        "id": "login-sso-none",
        "route": "/login",
        "session": "none",
        "variant": "no-sso",
        "js": ""
      },
      {
        "id": "totp",
        "route": "/login",
        "session": "none",
        "js": "document.querySelector('input[name=username]').value='ola.perez'; document.querySelector('input[name=password]').value='verge-dev-1'; document.querySelector('form.vg-form').submit();",
        "delay": 900
      },
      {
        "id": "forgot",
        "route": "/forgot",
        "session": "none",
        "js": ""
      },
      {
        "id": "forgot-sent",
        "route": "/forgot",
        "session": "none",
        "js": "document.querySelector('input[name=username]').value='ola.perez'; document.querySelector('form.vg-form').submit();",
        "delay": 900
      },
      {
        "id": "reset",
        "route": "/reset?token=fixture-reset-token",
        "session": "none",
        "js": ""
      },
      {
        "id": "reset-invalid",
        "route": "/reset?token=bad",
        "session": "none",
        "js": ""
      },
      {
        "id": "invite",
        "route": "/invite?token=fixture-invite-token",
        "session": "none",
        "js": ""
      },
      {
        "id": "invite-invalid",
        "route": "/invite?token=bad",
        "session": "none",
        "js": ""
      },
      {
        "id": "enroll",
        "route": "/account/totp/enroll",
        "session": "viewer",
        "js": ""
      },
      {
        "id": "recovery",
        "route": "/account/totp/enroll",
        "session": "viewer",
        "js": "var h=document.getElementById('vg-ecode-h'); h.value='482913'; h.form.submit();",
        "delay": 900
      }
    ]
  },
  "setup": {
    "crop": "body",
    "seed": "empty",
    "states": [
      {
        "id": "default",
        "route": "/setup",
        "session": "none",
        "js": ""
      },
      {
        "id": "error",
        "route": "/setup",
        "session": "none",
        "js": "document.querySelector('input[name=token]').value='wrong'; document.querySelector('input[name=username]').value='ola.perez'; document.querySelector('input[name=password]').value='fixture-password-12'; document.querySelector('form.vg-form').submit();",
        "delay": 900
      }
    ]
  },
  "coverage": {
    "crop": "main",
    "states": [
      {
        "id": "default",
        "route": "/coverage",
        "session": "admin",
        "js": ""
      },
      {
        "id": "empty",
        "route": "/coverage",
        "session": "admin",
        "seed": "empty-authed",
        "js": ""
      }
    ]
  }
}