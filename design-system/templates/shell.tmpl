.sh-toast .td { width: 8px; height: 8px; border-radius: 999px; flex: none; margin-top: 5px; background: var(--neutral-400); }
.sh-toast.ok .td { background: var(--ok-solid); }
.sh-toast.warn .td { background: var(--warn-solid); }
.sh-toast.danger .td { background: var(--danger-solid); }
.sh-toast .tb { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
.sh-toast .tt { font: 600 13px var(--font-ui); color: var(--text-ink); }
.sh-toast .tdsc { font: 400 12.5px/1.45 var(--font-ui); color: var(--text-secondary); }
.sh-toast .tx { flex: none; margin: -2px -4px 0 0; width: 22px; height: 22px; padding: 0; border: none; background: transparent; color: var(--text-secondary); cursor: pointer; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; transition: background var(--dur-fast) var(--ease-out); }
.sh-toast .tx:hover { background: var(--surface-sunken); color: var(--text-ink); }
.sh-footer { display: flex; align-items: center; gap: 16px; padding: 14px 32px; border-top: 1px solid var(--border-default); margin-top: auto; font-family: var(--font-ui); }
.sh-footer .note { font: 400 12px var(--font-ui); color: var(--text-muted); }
.sh-footer .links { margin-left: auto; display: flex; gap: 16px; align-items: center; }
.sh-footer .links a { font: 400 12px var(--font-ui); color: var(--text-secondary); text-decoration: none; }
.sh-footer .links a:hover { color: var(--text-ink); text-decoration: none; }
</style></head><body>{{end}}

{{/* The submitting-URL field (ADR-0130 §3, cmd/web/backurl.go). A mutating form
     opts in with one line — {{template "backfield" $}} inside the <form> — and the
     handler then 303s the operator back to the exact URL they submitted from, query
     and all, instead of to a bare path. Pass the ROOT context ($), because .BackURL
     is stamped on the page data, not on a row. The server rejects any value that is
     not a same-origin relative path it serves a GET at, so this field cannot become
     an open redirect. It is plain markup: the act works with JavaScript off. */}}
{{define "backfield"}}<input type="hidden" name="return" value="{{.BackURL}}">{{end}}

