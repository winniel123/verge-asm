.cmdk-item:hover .iic, .cmdk-item.active .iic { color: var(--link); }
.cmdk-item .lbl { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmdk-item .cmdk-hint { font: 400 11px var(--font-mono); color: var(--text-muted); }
