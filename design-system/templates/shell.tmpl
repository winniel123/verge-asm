-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>{{else if eq . "search"}}<circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>{{else if eq . "eye"}}<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle>{{else if eq . "gauge"}}<path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path>{{else if eq . "database"}}<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path>{{else if eq . "monitor-smartphone"}}<rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line>{{else if eq . "layout-grid"}}<rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect>{{else if eq . "puzzle"}}<path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z"></path>{{else if eq . "settings"}}<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle>{{else if eq . "play"}}<path d="M8 5v14l11-7z" fill="currentColor" stroke="none"></path>{{else if eq . "plus"}}<path d="M5 12h14"></path><path d="M12 5v14"></path>{{else if eq . "flag"}}<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" x2="4" y1="22" y2="15"></line>{{else if eq . "moon"}}<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>{{else}}<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>{{end}}</svg>{{end}}

{{define "chrome"}}{{with .Chrome}}<header class="sh-topnav">
<a class="sh-brand" href="/" aria-label="Verge ASM home">
<svg width="20" height="20" viewBox="0 0 44 44" style="flex:none;display:block" aria-hidden="true"><circle cx="22" cy="22" r="19" fill="none" stroke="var(--accent)" stroke-width="3" opacity="0.4"></circle><circle cx="22" cy="22" r="12" fill="none" stroke="var(--accent)" stroke-width="3.5" opacity="0.75"></circle><circle cx="22" cy="22" r="5.5" fill="var(--accent)"></circle></svg>
<span class="wm"><span class="w1">verge</span><span class="w2">ASM</span></span>
</a>
<span class="sh-orgchip">{{.Org}}</span>
<nav class="sh-pills" aria-label="Primary">
{{range .Nav}}<a class="sh-pill{{if .Active}} on{{end}}" href="{{.Href}}"{{if .Active}} aria-current="page"{{end}}>{{.Label}}{{if .Count}}<span class="ct">{{.Count}}</span>{{end}}</a>{{end}}
</nav>
<span class="sh-actions">
{{if .ScanRunning}}<a class="sh-scan" href="/settings?tab=scans" title="A scan is in flight — open Running now"><span class="d"></span>Scan running</a>{{end}}
<button type="button" class="sh-iconbtn" id="sh-cmdk-btn" title="Search (Ctrl+K)" aria-label="Command palette"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></button>
<details class="sh-pop" id="sh-bell">
<summary><span class="sh-bell"><span class="sh-iconbtn" role="button" aria-label="Messages"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"></path><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg></span>{{if .Unread}}<span class="ud"></span>{{end}}</span></summary>
<div class="sh-panel right sh-msgs">
<span class="sh-micro" style="padding:0 4px">Messages</span>
{{range .Messages}}
<a class="sh-msgrow{{if .Unread}} unread{{end}}" href="{{.Href}}">
<span class="dot"></span>
<span class="bd">
<span class="top"><span class="cls">{{.Class}}</span><span class="when">{{.Rel}}</span></span>
<span class="tx">{{.Headline}}</span>
</span>
</a>
{{else}}<span style="padding:8px;font:400 12.5px var(--font-ui);color:var(--text-muted)">No messages.</span>{{end}}
<a class="sh-msgall" href="/inbox">All messages</a>
</div>
</details>
<span class="sh-ver">{{.Version}}</span>
<button type="button" class="sh-iconbtn" id="sh-theme" aria-label="Toggle theme"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></button>
<a class="sh-gh" href="https://github.com/winniel123/verge-asm" rel="noreferrer">GitHub</a>
<details class="sh-pop" id="sh-acct">
<summary><span class="sh-avatar" role="button" aria-label="Account menu" title="{{.UserName}}">{{.UserInitials}}</span></summary>
<div class="sh-panel right sh-acct" role="menu">
<a class="sh-mi" role="menuitem" href="/profile"><span class="mic">{{template "cmdkicon" "user"}}</span>Profile</a>
<a class="sh-mi" role="menuitem" href="/settings"><span class="mic">{{template "cmdkicon" "settings"}}</span>Settings</a>
<button type="button" class="sh-mi" role="menuitem" data-open-cmdk><span class="mic">{{template "cmdkicon" "search"}}</span>Command palette<span class="hint">Ctrl+K</span></button>
<div class="sh-sep"></div>
<form method="post" action="/signout" style="margin:0"><button type="submit" class="sh-mi" role="menuitem"><span class="mic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg></span>Sign out</button></form>
</div>
</details>
</span>
</header>
<div id="cmdk" hidden>
<button type="button" class="cmdk-scrim" data-close-cmdk aria-label="Close"></button>
<div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="Command palette">
<div class="cmdk-inputrow">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></span>
<input class="cmdk-input" placeholder="Type a command or search…" aria-label="Command palette" autocomplete="off" spellcheck="false">
<span class="sh-kbd">esc</span>
</div>
<div class="cmdk-list">
{{range .PaletteGroups}}
<div class="cmdk-group">
<div class="glabel">{{.Label}}</div>
{{range .Items}}
{{if .ThemeToggle}}<button type="button" class="cmdk-item" data-theme-item>{{if .Icon}}<span class="iic">{{template "cmdkicon" .Icon}}</span>{{end}}<span class="lbl">{{.Label}}</span>{{if .Hint}}<span class="cmdk-hint">{{.Hint}}</span>{{end}}</button>
{{else}}<a class="cmdk-item" href="{{.Href}}"{{if .Search}} data-cmdk-search{{end}}>{{if .Icon}}<span class="iic">{{template "cmdkicon" .Icon}}</span>{{end}}<span class="lbl">{{.Label}}</span>{{if .Hint}}<span class="cmdk-hint">{{.Hint}}</span>{{end}}</a>{{end}}
{{end}}
</div>
{{end}}
<div class="cmdk-empty" hidden>No matches.</div>
</div>
<div class="cmdk-foot">
<span class="h"><span class="sh-kbd">↑</span><span class="sh-kbd">↓</span> navigate</span>
<span class="h"><span class="sh-kbd">↵</span> run</span>
</div>
</div>
</div>
{{if .Toasts}}
<div class="sh-toasts" aria-live="polite">
{{range .Toasts}}
<div class="sh-toast {{.Tone}}">
<span class="td"></span>
<span class="tb"><span class="tt">{{.Title}}</span>{{if .Description}}<span class="tdsc">{{.Description}}</span>{{end}}</span>
<button type="button" class="tx" data-toast-x aria-label="Dismiss"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button>
</div>
{{end}}
</div>
{{end}}
{{end}}{{end}}

{{define "foot"}}{{if .Chrome}}<footer class="sh-footer"><span class="note">verge asm · self-hosted · AGPL-3.0</span><span class="links"><a href="https://github.com/winniel123/verge-asm/tree/main/docs" rel="noreferrer">Docs</a><a href="https://github.com/winniel123/verge-asm" rel="noreferrer">GitHub</a><span class="sh-ver">{{.Chrome.Version}}</span></span></footer>{{end}}<script>
/* Preserve the scroll position across the navigations the console runs
   (ADR-0130 §2 and §3). Each mutating handler answers 303 to the URL the form was
   submitted from, so a naive reload lands at the top — jarring on a long screen.
   On submit we stash scrollY keyed by the full URL, pathname plus search, so a
   ?tab=, ?filter= or ?sev= variant of one path never inherits another variant's
   offset. On the next load of that same URL we restore it, but only when the
   navigation type is "navigate": an ordinary navigation, never a reload and
   never a back/forward. Native back/forward scroll restoration is left alone.
   There is no short freshness budget, because a slow handler can outrun one. The
   stash is single-consume — we remove it before we restore — and a wide 5-minute
   TTL discards a stash the operator abandoned.

   A form is not the only control that re-lists a screen. A tab, a severity
   filter, a sort header, a pager, a "clear filters" and a drawer open or close
   are plain <a> links. They never reach the submit listener, so they never
   stashed. That is ADR-0130 failure class B. A click now stashes too, when the
   clicked <a>, type=button control or [data-href] row targets this same list:
   same origin, same pathname, any query.

   The stash goes under the TARGET's key, because the landing page reads that
   key. A target on another path stashes nothing. That page holds different
   content, and a scroll reset there is correct. We convert no control to a form,
   and every control this covers still works with JavaScript off. */
(function () {
  var STALE_MS = 300000;
  /* `toast` is a single-consume PRG receipt (shell.go toastRedirect), never part of
     the page's identity: /settings?tab=channels and that same URL with a receipt
     appended are the same list, at the same offset. So the key drops it and keeps
     every other pair byte for byte, in the order it arrived — the server's own rule
     (backurl.go stripToastParam), now agreed on both ends. Without this a toasting
     act stashes under one key and lands under another, and the restore misses. That
     is every toastRedirect in the tree, not only the acts ADR-0130 §3 migrated. */
  function keyFor(u) {
    var q = u.search.replace(/^\?/, ""), kept = [], parts = q ? q.split("&") : [], i;
    for (i = 0; i < parts.length; i++) {
      if (parts[i] && parts[i].split("=")[0] !== "toast") kept.push(parts[i]);
    }
    q = kept.join("&");
    return "verge:scroll:" + u.pathname + (q ? "?" + q : "");
  }
  var K = keyFor(location);
  function isNavigate() {
    try {
      var nav = performance.getEntriesByType("navigation")[0];
      return !!nav && nav.type === "navigate";
    } catch (e) {
      return false;
    }
  }
  function stash(k) {
    try {
      sessionStorage.setItem(k, JSON.stringify({ y: window.scrollY, t: Date.now() }));
    } catch (e) {}
  }
  try {
    var raw = sessionStorage.getItem(K);
    if (raw) {
      sessionStorage.removeItem(K);
      var s = JSON.parse(raw);
      if (s && typeof s.y === "number" && Date.now() - s.t < STALE_MS && isNavigate()) window.scrollTo(0, s.y);
    }
  } catch (e) {}
  document.addEventListener("submit", function (ev) {
    var f = ev.target;
    if (f && (f.method || "").toLowerCase() === "post") stash(K);
  }, true);
  /* A modified click opens a new tab. A target= link and a download= link do
     the same. A bare "#" href is a script hook the page rewires. None of them
     navigates this document, so none of them earns a stash. The type=button
     clause in the selector guards a second case: a kebab or a copy button inside
     a [data-href] row must not stash the row's target, because that button opens
     a menu and never navigates. No type=button control in the tree navigates
     today, so the clause covers the contract rather than a live control. */
  document.addEventListener("click", function (ev) {
    if (ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
    var el = ev.target && ev.target.closest ? ev.target.closest("a[href], button[type=button], [data-href]") : null;
    if (!el) return;
    var href = el.getAttribute("data-href") || (el.tagName === "A" ? el.getAttribute("href") : "");
    if (!href || href.charAt(0) === "#" || el.hasAttribute("download")) return;
    var tgt = el.getAttribute("target");
    if (tgt && tgt !== "_self") return;
    var u;
    try {
      u = new URL(href, location.href);
    } catch (e) {
      return;
    }
    if (u.origin !== location.origin || u.pathname !== location.pathname) return;
    stash(keyFor(u));
  }, true);
})();
/* Shell affordances: theme toggle (explicit data-theme override, persisted), the
   details-popovers (bell, org, account — outside click + Escape close), the toast
   stack (5s auto-dismiss with the leave animation), and the command palette
   (Cmd/Ctrl-K; filter, arrow nav, Enter; the [data-cmdk-search] item stays visible
   and its href tracks the typed query to /search?q=…). All guarded to no-op on the
   chrome-less auth pages. */
(function () {
  var themeBtns = [document.getElementById("sh-theme")].concat([].slice.call(document.querySelectorAll("[data-theme-item]")));
  themeBtns.forEach(function (b) {
    if (!b) return;
    b.addEventListener("click", function () {
      var cur = document.documentElement.getAttribute("data-theme");
      var next = cur === "dark" ? "light" : cur === "light" ? "dark" : (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "light" : "dark");
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("verge-theme", next); } catch (e) {}
      closeCmdk();
    });
  });
  ["sh-org", "sh-bell", "sh-acct"].forEach(function (id) {
    var d = document.getElementById(id);
    if (!d) return;
    document.addEventListener("mousedown", function (e) { if (d.open && !d.contains(e.target)) d.removeAttribute("open"); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && d.open) d.removeAttribute("open"); });
  });
  [].forEach.call(document.querySelectorAll(".sh-toast"), function (t) {
    var kill = function () { t.classList.add("leaving"); setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 260); };
    var timer = setTimeout(kill, 5000);
    var x = t.querySelector("[data-toast-x]");
    if (x) x.addEventListener("click", function () { clearTimeout(timer); kill(); });
  });
  var cmdk = document.getElementById("cmdk");
  if (!cmdk) return;
  var input = cmdk.querySelector(".cmdk-input");
  var searchItem = cmdk.querySelector("[data-cmdk-search]");
  var searchBase = searchItem ? searchItem.getAttribute("href").split("?")[0] : "/search";
  function items() { return [].slice.call(cmdk.querySelectorAll(".cmdk-item")); }
  function visible() { return items().filter(function (el) { return !el.hasAttribute("hidden"); }); }
  function openCmdk() { cmdk.removeAttribute("hidden"); input.value = ""; filter(""); input.focus(); }
  function closeCmdk() { cmdk.setAttribute("hidden", ""); }
  function setActive(i) {
    var vis = visible();
    items().forEach(function (el) { el.classList.remove("active"); });
    if (!vis.length) return;
    if (i < 0) i = vis.length - 1; if (i >= vis.length) i = 0;
    vis[i].classList.add("active");
    var box = cmdk.querySelector(".cmdk-list"), el = vis[i];
    if (el.offsetTop < box.scrollTop) box.scrollTop = el.offsetTop - 6;
    else if (el.offsetTop + el.offsetHeight > box.scrollTop + box.clientHeight) box.scrollTop = el.offsetTop + el.offsetHeight - box.clientHeight + 6;
  }
  function activeIndex() {
    var vis = visible();
    for (var i = 0; i < vis.length; i++) { if (vis[i].classList.contains("active")) return i; }
    return -1;
  }
  function filter(q) {
    var ql = q.toLowerCase();
    items().forEach(function (el) {
      if (el.hasAttribute("data-cmdk-search")) {
        el.removeAttribute("hidden");
        el.setAttribute("href", q ? searchBase + "?q=" + encodeURIComponent(q) : searchBase);
        return;
      }
      var t = (el.textContent || "").toLowerCase();
      if (!ql || t.indexOf(ql) !== -1) el.removeAttribute("hidden"); else el.setAttribute("hidden", "");
    });
    [].forEach.call(cmdk.querySelectorAll(".cmdk-group"), function (g) {
      var any = [].some.call(g.querySelectorAll(".cmdk-item"), function (el) { return !el.hasAttribute("hidden"); });
      if (any) g.removeAttribute("hidden"); else g.setAttribute("hidden", "");
    });
    var empty = cmdk.querySelector(".cmdk-empty");
    if (empty) { if (visible().length) empty.setAttribute("hidden", ""); else empty.removeAttribute("hidden"); }
    setActive(0);
  }
  input.addEventListener("input", function () { filter(input.value); });
  input.addEventListener("keydown", function (e) {
    if (e.key === "ArrowDown") { e.preventDefault(); setActive(activeIndex() + 1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); setActive(activeIndex() - 1); }
    else if (e.key === "Enter") { e.preventDefault(); var vis = visible(), i = activeIndex(); var el = vis[i < 0 ? 0 : i]; if (el) el.click(); }
  });
  document.addEventListener("keydown", function (e) {
    if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) { e.preventDefault(); if (cmdk.hasAttribute("hidden")) openCmdk(); else closeCmdk(); }
    else if (e.key === "Escape" && !cmdk.hasAttribute("hidden")) closeCmdk();
  });
  var btn = document.getElementById("sh-cmdk-btn");
  if (btn) btn.addEventListener("click", openCmdk);
  [].forEach.call(document.querySelectorAll("[data-open-cmdk]"), function (b) {
    b.addEventListener("click", function () { var acct = document.getElementById("sh-acct"); if (acct) acct.removeAttribute("open"); openCmdk(); });
  });
  [].forEach.call(cmdk.querySelectorAll("[data-close-cmdk]"), function (b) { b.addEventListener("click", closeCmdk); });
})();
</script></body></html>{{end}}
