.cmdk-empty[hidden] { display: none; }
.cmdk-foot { display: flex; align-items: center; gap: 14px; padding: 8px 16px; border-top: 1px solid var(--row-sep); background: var(--surface-sunken); }
.cmdk-foot .h { display: inline-flex; align-items: center; gap: 6px; font: 400 11px var(--font-ui); color: var(--text-muted); }
.sh-toasts { position: fixed; right: 24px; bottom: 24px; z-index: 110; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; width: 340px; max-width: calc(100vw - 40px); pointer-events: none; }
