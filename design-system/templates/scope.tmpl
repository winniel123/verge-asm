.sc-refusal .reach .mono { font: 500 12px var(--font-mono); color: var(--text-body); }
.sc-switchrow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.sc-switchrow form { margin: 0; display: inline-flex; }
