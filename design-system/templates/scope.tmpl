.sc-stale { display: inline-flex; align-items: center; gap: 4px; height: 18px; padding: 0 6px; border-radius: 8px; background: var(--stale-bg); border: 1px solid var(--stale-border); color: var(--stale-fg); font: 600 10px var(--font-mono); letter-spacing: 0.04em; white-space: nowrap; line-height: 1; }
.sc-stale .b { font-weight: 400; opacity: 0.8; }
.sc-lede { margin: 0 0 14px; font: 400 12.5px/1.5 var(--font-ui); color: var(--text-secondary); }
.sc-census { display: flex; flex-direction: column; font-family: var(--font-ui); }
.sc-crow { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; padding: 11px 0; }
