.sc-crow .ct { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.sc-crow .nm { font: 600 12px var(--font-mono); color: var(--text-ink); overflow-wrap: anywhere; }
.sc-crow .det { font: 400 12.5px/1.5 var(--font-ui); color: var(--text-secondary); }
.sc-crow .det .mono { font: 500 12px var(--font-mono); color: var(--text-body); }
.sc-declined { display: inline-flex; align-items: center; height: 18px; padding: 0 6px; border-radius: 8px; background: var(--surface-sunken); border: 1px solid var(--border-strong); color: var(--text-secondary); font: 600 10px var(--font-mono); letter-spacing: 0.04em; white-space: nowrap; }
.sc-input { display: flex; flex-direction: column; gap: 6px; font-family: var(--font-ui); }
.sc-input .il { font-size: 12.5px; font-weight: 500; color: var(--text-body); }
.sc-input .iw { display: flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px; background: var(--surface); border: 1px solid var(--border-default); border-radius: 12px; transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
.sc-input .iw:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 18%, transparent); }
.sc-input input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; color: var(--text-ink); font: 400 13px var(--font-ui); }
.sc-cb { position: relative; display: inline-flex; cursor: pointer; }
.sc-cb input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.sc-cb .box { width: 18px; height: 18px; flex: none; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; background: var(--surface); border: 1px solid var(--border-strong); transition: background var(--dur-fast) var(--ease-out); }
.sc-cb input:checked + .box { background: var(--accent); border-color: var(--accent); }
.sc-cb .box svg { display: none; }
.sc-cb input:checked + .box svg { display: block; }
.sc-cb input:focus-visible + .box { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus-ring); }
.sc-prow { display: flex; align-items: center; gap: 12px; padding: 10px 2px; }
.sc-prow + .sc-prow { border-top: 1px solid var(--row-sep); }
.sc-prow .pv { font: 500 12.5px var(--font-mono); color: var(--text-ink); }
.sc-prow .psrc { font: 400 11.5px var(--font-ui); color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sc-prow form { margin: 0 0 0 auto; flex: none; }
.sc-xrow { display: flex; align-items: center; gap: 10px; padding: 7px 10px; background: var(--surface-sunken); border-radius: 10px; }
.sc-xrow .xv { font: 400 12.5px var(--font-mono); color: var(--text-body); overflow-wrap: anywhere; }
.sc-xrow form { margin: 0 0 0 auto; }
.sc-xrow .rm { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border: none; border-radius: 999px; background: transparent; color: var(--text-muted); cursor: pointer; padding: 0; }
.sc-xrow .rm:hover { background: var(--border-strong); }
.sc-listbox { position: relative; display: inline-flex; width: 150px; }
.sc-listbox .trig { display: flex; align-items: center; gap: 8px; width: 100%; height: 30px; padding: 0 12px; background: var(--surface); color: var(--text-ink); font: 400 13px var(--font-ui); text-align: left; border: 1px solid var(--border-default); border-radius: 12px; cursor: pointer; }
.sc-listbox .trig .cv { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
