.sc-listbox .panel { position: absolute; top: 100%; left: 0; margin-top: 6px; width: 100%; z-index: 95; background: var(--surface-raised); border: 1px solid var(--border-default); border-radius: 12px; box-shadow: var(--shadow-md); padding: 5px; animation: sc-pop var(--dur-base) var(--ease-out); }
.sc-listbox .panel[hidden] { display: none; }
.sc-listbox .opt { display: flex; align-items: center; gap: 8px; width: 100%; height: 30px; padding: 0 10px; border: none; border-radius: 8px; text-align: left; cursor: pointer; background: transparent; color: var(--text-body); font: 500 12.5px var(--font-ui); }
.sc-listbox .opt:hover { background: var(--surface-sunken); }
.sc-listbox .opt.on { color: var(--link); font-weight: 600; }
.sc-xadd input.val { flex: 1; height: 30px; padding: 0 10px; background: var(--surface); color: var(--text-ink); font: 400 12px var(--font-mono); border: 1px solid var(--border-default); border-radius: 10px; outline: none; }
.sc-xadd input.val:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 18%, transparent); }
.sc-receipt { padding: 12px 14px; background: var(--surface-sunken); border-radius: 12px; font-family: var(--font-ui); display: flex; flex-direction: column; gap: 4px; }
.sc-receipt .hl { margin: 0; font: 600 13px var(--font-ui); color: var(--text-ink); }
.sc-receipt .ls { margin: 0; font: 400 12.5px/1.5 var(--font-ui); color: var(--text-body); }
.sc-notice { display: flex; align-items: flex-start; gap: 10px; padding: 11px 14px; background: var(--ok-soft); border: 1px solid var(--ok-border); border-radius: 12px; font-family: var(--font-ui); font-size: 12.5px; line-height: 1.5; color: var(--text-body); }
.sc-notice .ic { color: var(--ok); display: inline-flex; margin-top: 1px; flex: none; }
.sc-error { padding: 10px 14px; background: var(--danger-soft); border: 1px solid var(--danger-border); border-radius: 12px; font: 400 12.5px/1.5 var(--font-ui); color: var(--danger); }
</style>
<main class="sc-main" data-screen-label="Scope">
{{if .Notice}}<div class="sc-notice"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span><span>{{.Notice}}</span></div>{{end}}
<header style="display:flex;flex-direction:column;gap:2px">
<h1>Scope</h1>
<span class="sc-sub">What Verge is allowed to look at: seeds, proposals, exclusions, custody.</span>
</header>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start">
<div style="display:flex;flex-direction:column;gap:24px">
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Seeds</span><h3>Declared scopes</h3></div></div>
<div class="sc-body">
<div style="display:flex;flex-direction:column;gap:12px">
<div style="display:flex;flex-direction:column;gap:6px">
<div class="sc-fieldrow">
<div class="sc-field{{if .FormError}} err{{end}}" data-focus-input>
{{range .Seeds}}<span class="sc-tag" id="seed-{{.Anchor}}">{{.Scope}}{{if $.IsAdmin}}<form method="post" action="/seeds/delete"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button class="rm" type="submit" aria-label="Remove seed"><svg viewBox="0 0 10 10" width="8" height="8"><path d="M2 2l6 6M8 2l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button></form>{{end}}</span>{{end}}
{{if .IsAdmin}}<form method="post" action="/seeds" id="sc-declare">{{template "backfield" $}}<input name="scope" value="{{.FormScope}}" placeholder="{{if not .Seeds}}acmecorp.io or 203.0.113.0/24{{end}}" autocomplete="off" aria-label="Declare a scope" data-declare-input></form>{{end}}
</div>
{{if .IsAdmin}}<button type="submit" form="sc-declare" class="sc-btn" data-declare-confirm>Confirm</button>{{end}}
</div>
{{if .IsAdmin}}<span class="sc-live" data-declare-live data-cap="{{.AddressCap}}" aria-live="polite" hidden></span>{{end}}
{{if .FormError}}<span class="sc-errline">{{.FormError}}</span>{{else}}<span class="sc-hint">Names or address scopes · paste several — commas, spaces, or newlines split · a block wider than the {{.AddressCap}}-address cap is refused, never auto-corrected.</span>{{end}}
</div>
{{range .Refusals}}
<div class="sc-refusal">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86z"></path><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg></span>
<div class="ct">
<span class="t">Declaration refused: <span class="mono">{{.Input}}</span></span>
<span class="r">{{.Reason}}</span>
{{if .Reachable}}<span class="reach">Raise your cap in <span class="mono">Settings · Scans</span> to sweep it whole, or declare a block within your cap like <span class="mono">{{.Reachable}}</span> — nothing is auto-corrected.</span>{{end}}
</div>
</div>
{{end}}
</div>
</div>
</section>
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Custody</span><h3>Adjacent infrastructure</h3></div></div>
<div class="sc-body">
{{if .CustodyError}}<div class="sc-error" style="margin-bottom:12px">{{.CustodyError}}</div>{{end}}
{{if .CustodyScopes}}
<div style="display:flex;flex-direction:column;gap:16px">
{{range .CustodyScopes}}
<div style="display:flex;flex-direction:column;gap:12px">
<div class="sc-switchrow">
{{if $.IsAdmin}}
<form method="post" action="/seeds/custody"><input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="extend" value="{{if .CustodyExtension}}false{{else}}true{{end}}">{{template "backfield" $}}<button type="submit" role="switch" aria-checked="{{if .CustodyExtension}}true{{else}}false{{end}}" class="sc-switch{{if .CustodyExtension}} on{{end}}" aria-label="Extend custody — {{.Scope}}"><span class="knob"></span></button></form>
{{else}}<span class="sc-switch{{if .CustodyExtension}} on{{end}}" role="switch" aria-checked="{{if .CustodyExtension}}true{{else}}false{{end}}"><span class="knob"></span></span>{{end}}
<span class="lbl">Extend custody to adjacent infrastructure — <span class="mono">{{.Scope}}</span></span>
</div>
{{if .CustodyExtension}}
<div class="sc-meter">
<div class="top"><span class="sc-micro">Custody extension</span><span class="val">census · {{.Census}} addresses</span></div>
<div class="census" aria-label="Census — no denominator"></div>
<span class="det">recomputed each batch — read-only, never per-address approval</span>
</div>
{{end}}
</div>
{{end}}
</div>
{{else}}
<span style="font:400 12.5px var(--font-ui);color:var(--text-muted)">A custody extension is a property of a name scope. Declare a name scope, then extend custody to the addresses it resolves into.</span>
{{end}}
</div>
</section>
{{/* The custody-extension census (#987, ADR-0129 §5): the companion section to the census
     above. Each row names one in-zone Name whose direct-A edge the extension does not
     reach, why, and the address-scope remedy. The register is DISPLAY — a veto withholds
     a probe, which is the safe direction, so nothing here fires a message. No row carries
     a count or a threshold: both are versioned parameters of the Custody derivation. */}}
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Custody extension</span><h3>Edges not reached</h3></div>{{if .CustodyCensus}}<span class="sc-count">{{len .CustodyCensus}}</span>{{end}}</div>
<div class="sc-body">
{{if .CustodyCensusFailed}}
<span class="sc-hint">The fan-out measurement did not resolve on this load. Nothing is listed rather than a guessed edge. Reload to read it again.</span>
{{else if .CustodyCensus}}
<p class="sc-lede">These in-zone names front an edge the custody extension does not reach. Declare the origin addresses as an address scope, and the true origin is monitored directly.</p>
<div class="sc-census">
{{range .CustodyCensus}}
<div class="sc-crow">
{{if .Declined}}<span class="sc-declined">declined</span>{{else}}<span class="sc-stale">pending</span>{{end}}
<div class="ct">
<span class="nm">{{.Name}}</span>
{{if .Declined}}
<span class="det">Its direct A record cites <span class="mono">{{.Address}}</span>, measured as a shared edge{{if .Scope}}, and covered by address scope <span class="mono">{{.Scope}}</span>. The declaration stands, so that address is still probed. Withdraw the scope and the decline takes effect.{{else}}. Declare the origin addresses as an address scope, to monitor the true origin.{{end}}</span>
{{else}}
<span class="det">Its direct A record cites <span class="mono">{{.Address}}</span>, which the daily <span class="mono">edge-fanout</span> scan has not measured yet{{if .Scope}}, and which address scope <span class="mono">{{.Scope}}</span> covers{{end}}. The extension holds the reach until it does.</span>
{{end}}
</div>
</div>
{{end}}
</div>
{{else}}
<span class="sc-hint">No in-zone name fronts an edge the extension declined. A declined edge appears here with the address-scope remedy.</span>
{{end}}
</div>
</section>
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Removal detection</span><h3>Zone file</h3></div></div>
<div class="sc-body">
<div style="display:flex;flex-direction:column;gap:12px">
{{range .ZoneErrors}}<div class="sc-error"><span style="font-family:var(--font-mono);font-size:12px">{{.File}}</span> — {{.Reason}}</div>{{end}}
{{range .ZoneScopes}}
<div class="sc-zrow">
{{if .HasFile}}
<span class="zname">{{.Domain}}.zone</span>
<span class="zmeta">uploaded {{.SuppliedAt}}{{if .IntervalLabel}} · re-supply {{.IntervalLabel}}{{end}}</span>
{{if .AgingLabel}}<span style="margin-left:auto"><span class="sc-badge-warn"><span class="dot"></span>{{.AgingLabel}}</span></span>{{end}}
{{else}}
<span class="zname">{{.Domain}}</span>
<span class="zmeta">no zone file supplied</span>
{{end}}
</div>
{{end}}
{{if .IsAdmin}}
<form method="post" action="/seeds/zone" enctype="multipart/form-data" style="margin:0">
{{template "backfield" $}}
<label class="sc-drop" id="sc-zone-drop">
<span class="ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg></span>
<span class="l">Re-supply zone files</span>
<span class="h">Upload is a dated act — the upload instant is the observation instant. Drop several — each file is its own act. An apex outside your name scopes is refused, with the reason.</span>
<input type="file" name="zonefile" accept=".zone,.txt" multiple style="display:none">
</label>
<button type="submit" class="sc-btn-sm" data-zone-submit style="margin-top:10px">Upload</button>
</form>
<div class="sc-introw">
<span class="sc-micro">Re-supply interval</span>
<form method="post" action="/seeds/zone/interval" style="margin:0 0 0 auto;display:flex;align-items:center;gap:8px">
{{template "backfield" $}}<input name="interval_days" inputmode="numeric" value="{{.ZoneIntervalDays}}" aria-label="Re-supply interval in days"><span class="unit">days</span>
<button type="submit" class="sc-btn-sm">Save</button>
</form>
</div>
{{if .ZoneIntervalError}}<div class="sc-error">{{.ZoneIntervalError}}</div>{{end}}
{{end}}
</div>
</div>
</section>
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Names</span><h3>Declared name tree</h3></div></div>
<div class="sc-body">
{{if .NameTree}}
<div class="sc-tree">
{{range .NameTree}}
<div>
<button type="button" class="sc-trow" aria-expanded="true">
<svg class="chev" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
{{if .Sev}}<span class="dot" style="background:var(--sev-{{.Sev}}-dot)"></span>{{end}}
<span class="tl">{{.Label}}</span>
{{if .Count}}<span class="tc">{{.Count}}</span>{{end}}
</button>
<div class="sc-tkids"><div>
{{range .Children}}
<div class="sc-trow">
<span class="spacer"></span>
{{if .Sev}}<span class="dot" style="background:var(--sev-{{.Sev}}-dot)"></span>{{end}}
<span class="tl">{{.Label}}</span>
</div>
{{end}}
</div></div>
</div>
{{end}}
</div>
{{else}}
<span style="font:400 12.5px var(--font-ui);color:var(--text-muted)">A name tree grows under a declared name scope. Declare a domain above; each name that resolves under it appears here with its severity.</span>
{{end}}
</div>
</section>
</div>
<div style="display:flex;flex-direction:column;gap:24px">
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Coverage</span><h3>Coverage messages</h3></div></div>
<div class="sc-body">
{{if .CoverageMsgs}}
<div class="sc-msgs">
{{range .CoverageMsgs}}
<div class="sc-msg">
<span style="padding-top:1px">{{if eq .Kind "gap"}}<span class="sc-gapbadge"><svg viewBox="0 0 10 10" width="9" height="9" style="flex:none"><rect x="1.6" y="1.6" width="6.8" height="6.8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.6 1.6"></rect></svg>{{.Badge}}</span>{{else}}<span class="sc-stale"><svg viewBox="0 0 10 10" width="9" height="9" style="flex:none"><circle cx="5" cy="5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M5 3.2V5l1.4 1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>{{.Badge}}{{if .Bound}}<span class="b">· {{.Bound}}</span>{{end}}</span>{{end}}</span>
<span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span class="sbj">{{.Subject}}</span><span class="txt">{{.Text}}</span></span>
{{if .When}}<span class="sc-when" title="{{.ISO}}">{{.When}}</span>{{end}}
</div>
{{end}}
</div>
{{else}}
<span style="font:400 12.5px var(--font-ui);color:var(--text-muted)">Every vantage is reporting and no gap, staleness or silence stands.</span>
{{end}}
</div>
</section>
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Proposals</span><h3>From the registry</h3></div><span class="sc-count">{{len .Proposals}}</span></div>
<div class="sc-body">
{{if .IsAdmin}}
<form method="post" action="/proposals/search" style="display:flex;gap:8px;align-items:flex-end;margin:0 0 14px">
{{template "backfield" $}}<span class="sc-input" style="flex:1"><span class="il">Org-name search</span><span class="iw"><input name="org" value="{{.OrgQuery}}" placeholder="Acme Corporation" autocomplete="off"></span></span>
<button type="submit" class="sc-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>Search registries</button>
</form>
{{end}}
<span style="display:block;font:400 11.5px/1.6 var(--font-ui);color:var(--text-muted);margin-bottom:14px">Proposers answer an org-name search with address scopes — never subdomains. A proposal asserts nothing until confirmed into a seed; declines are recorded as exclusions.</span>
{{if .Proposals}}
<form method="post" action="/proposals/decline" id="sc-decline-form" style="margin:0">{{template "backfield" $}}</form>
<div style="display:flex;flex-direction:column">
{{range .Proposals}}
<div class="sc-prow">
<label class="sc-cb"><input type="checkbox" name="ids" value="{{.ID}}" form="sc-decline-form" data-decline><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></label>
<span class="pv">{{.Value}}</span>
<span class="sc-tag">{{.Kind}}</span>
<span class="psrc">{{.Source}}</span>
{{if $.IsAdmin}}<form method="post" action="/proposals/confirm"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="sc-btn-sm">Confirm</button></form>{{end}}
</div>
{{end}}
<div style="display:flex;align-items:center;gap:10px;padding-top:12px;border-top:1px solid var(--row-sep)">
<span style="font:400 11.5px var(--font-ui);color:var(--text-muted)">Confirm one at a time; decline in bulk.</span>
{{if .IsAdmin}}<button type="submit" form="sc-decline-form" class="sc-btn-ghost" id="sc-decline-btn" style="margin-left:auto">Decline selected</button>{{end}}
</div>
</div>
{{else}}
<span style="font:400 12.5px var(--font-ui);color:var(--text-muted)">No open proposals. The registry suggests scopes as it sees them.</span>
{{end}}
</div>
</section>
<section class="sc-card">
<div class="sc-cardhead"><div class="hd"><span class="sc-micro">Exclusions</span><h3>Never scanned</h3></div></div>
<div class="sc-body">
<div style="display:flex;flex-direction:column;gap:12px">
{{if .ExclError}}<div class="sc-error">{{.ExclError}}</div>{{end}}
<div style="display:flex;flex-direction:column;gap:6px">
{{range .Exclusions}}
<div class="sc-xrow">
<span class="sc-tag">{{.Kind}}</span>
<span class="xv">{{if eq .Kind "subtree"}}*.{{end}}{{.Value}}</span>
{{if $.IsAdmin}}<form method="post" action="/exclusions/delete"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button class="rm" type="submit" aria-label="Remove exclusion"><svg viewBox="0 0 10 10" width="9" height="9"><path d="M2 2l6 6M8 2l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button></form>{{end}}
</div>
{{else}}
<span style="font:400 12.5px var(--font-ui);color:var(--text-muted)">No exclusions. Everything declared is in scope.</span>
{{end}}
</div>
{{if .IsAdmin}}
<form method="post" action="/exclusions" style="display:flex;gap:8px;align-items:center;margin:0" class="sc-xadd">
<input type="hidden" name="kind" value="{{if .ExclKind}}{{.ExclKind}}{{else}}subtree{{end}}" id="sc-xkind">{{template "backfield" $}}
<span class="sc-listbox">
<button type="button" class="trig" id="sc-xkind-btn" aria-haspopup="listbox" aria-expanded="false"><span class="cv">Subtree</span><svg class="chev" viewBox="0 0 16 16" width="14" height="14"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
<div class="panel" id="sc-xkind-panel" hidden>
<button type="button" class="opt" data-kind="name">Exact name</button>
<button type="button" class="opt on" data-kind="subtree">Subtree</button>
<button type="button" class="opt" data-kind="address">Address scope</button>
</div>
</span>
<input class="val" name="value" value="{{.ExclValue}}" placeholder="old-blog.acmecorp.io" autocomplete="off" aria-label="Exclusion value">
<button type="submit" formaction="/exclusions/preview" class="sc-btn-ghost" style="flex:none">Preview</button>
<button type="submit" class="sc-btn-sm" style="flex:none">Add exclusion</button>
</form>
{{with .ExclPreview}}
<div class="sc-receipt">
<span class="sc-micro">What this exclusion would withdraw</span>
{{if .Fires}}<p class="hl">{{.Headline}}</p><p class="ls">{{.Loss}}</p>{{else}}<p class="ls">Nothing is withdrawn. No subject leaves the estate, so no message fires — an excluded name that still resolves survives, and its Gap carries it.</p>{{end}}
</div>
{{end}}
{{end}}
</div>
</div>
</section>
</div>
</div>
</main>
<script>
(function(){
  [].forEach.call(document.querySelectorAll("[data-focus-input]"),function(f){
    f.addEventListener("click",function(e){if(e.target.closest("form")&&e.target.tagName!=="INPUT")return;var i=f.querySelector("input[name=scope]");if(i&&e.target!==i)i.focus();});
  });
  [].forEach.call(document.querySelectorAll(".sc-tree .sc-trow[aria-expanded]"),function(b){
    b.addEventListener("click",function(){
      var open=b.getAttribute("aria-expanded")==="true";
      b.setAttribute("aria-expanded",open?"false":"true");
      var kids=b.parentNode.querySelector(".sc-tkids");
      if(kids){if(open)kids.classList.add("closed");else kids.classList.remove("closed");}
    });
  });
  var boxes=[].slice.call(document.querySelectorAll("[data-decline]")),db=document.getElementById("sc-decline-btn");
  function recount(){if(!db)return;var n=boxes.filter(function(b){return b.checked;}).length;db.textContent="Decline selected"+(n?" ("+n+")":"");if(n)db.removeAttribute("disabled");else db.setAttribute("disabled","");}
  boxes.forEach(function(b){b.addEventListener("change",recount);});
  /* The button ships ENABLED and the script disables it on load (ADR-0130 §3 ticket
     #976, the ruling #971 and #975 each made on their own surface). A control disabled
     in the markup and enabled only by script is a control that does not work with
     JavaScript off. Enabled markup plus this call is the same affordance for a
     scripted browser, and a working one for every other. An empty selection is already
     a no-op redirect on the server (declineLookup). */
  recount();
  var drop=document.getElementById("sc-zone-drop");
  if(drop){
    var fi=drop.querySelector("input[type=file]");
    /* The form ships a real submit control, because the drop zone's own submit is a
       `change` / `drop` handler and neither fires with JavaScript off — the label still
       opens the picker, but nothing would send the file (ADR-0130 §3 ticket #976). The
       script hides it once it has taken that job, so a scripted browser keeps the
       design's drop-only card. */
    var zb=fi.form.querySelector("[data-zone-submit]");
    if(zb)zb.style.display="none";
    var zsub=function(){if(fi.form.requestSubmit)fi.form.requestSubmit();else fi.form.submit();};
    fi.addEventListener("change",function(){if(fi.files.length)zsub();});
    drop.addEventListener("dragover",function(e){e.preventDefault();drop.classList.add("over");});
    drop.addEventListener("dragleave",function(){drop.classList.remove("over");});
    drop.addEventListener("drop",function(e){e.preventDefault();drop.classList.remove("over");if(e.dataTransfer.files.length){fi.files=e.dataTransfer.files;zsub();}});
  }
  var kb=document.getElementById("sc-xkind-btn"),kp=document.getElementById("sc-xkind-panel"),kh=document.getElementById("sc-xkind");
  if(kb&&kp&&kh){
    var labels={name:"Exact name",subtree:"Subtree",address:"Address scope"},vi=document.querySelector(".sc-xadd input.val");
    function sync(){kb.querySelector(".cv").textContent=labels[kh.value]||kh.value;[].forEach.call(kp.querySelectorAll(".opt"),function(o){o.classList.toggle("on",o.getAttribute("data-kind")===kh.value);});if(vi)vi.placeholder=kh.value==="address"?"203.0.113.128/25":"old-blog.acmecorp.io";}
    sync();
    kb.addEventListener("click",function(e){e.stopPropagation();var open=kp.hasAttribute("hidden");if(open)kp.removeAttribute("hidden");else kp.setAttribute("hidden","");kb.setAttribute("aria-expanded",open?"true":"false");});
    [].forEach.call(kp.querySelectorAll(".opt"),function(o){o.addEventListener("click",function(){kh.value=o.getAttribute("data-kind");sync();kp.setAttribute("hidden","");kb.setAttribute("aria-expanded","false");});});
    document.addEventListener("mousedown",function(e){if(!kp.hasAttribute("hidden")&&!kp.contains(e.target)&&!kb.contains(e.target)){kp.setAttribute("hidden","");kb.setAttribute("aria-expanded","false");}});
    document.addEventListener("keydown",function(e){if(e.key==="Escape"&&!kp.hasAttribute("hidden")){kp.setAttribute("hidden","");kb.setAttribute("aria-expanded","false");}});
  }
  // #889: the flat confirm carries the count. As the operator types a single in-cap
  // address scope, a live line reads "N addresses · within your cap of M". Nothing
  // branches on the number — the Confirm control is identical whatever N is — and the
  // line stays a client preview; the server (declareSeed) is authoritative and refuses
  // an over-cap or malformed value on submit. No cadence line, no completion warning.
  var di=document.querySelector("[data-declare-input]"),dl=document.querySelector("[data-declare-live]");
  if(di&&dl){
    var cap=BigInt(dl.getAttribute("data-cap")||"0");
    function grp(s){return s.replace(/\B(?=(\d{3})+(?!\d))/g,",");}
    function count(v){
      v=v.trim();
      if(!v||/[\s,]/.test(v))return null;               // empty, or a multi-token paste
      var fam=v.indexOf(":")>=0?128:32,slash=v.indexOf("/"),addr=slash<0?v:v.slice(0,slash),host;
      if(fam===32&&!/^\d{1,3}(\.\d{1,3}){3}$/.test(addr))return null;
      if(fam===128&&!/^[0-9a-fA-F:]+$/.test(addr))return null;
      if(slash<0){host=0;}                              // a bare address is one host
      else{var p=v.slice(slash+1);if(!/^\d+$/.test(p))return null;var plen=+p;if(plen<0||plen>fam)return null;host=fam-plen;}
      return 1n<<BigInt(host);
    }
    function sync(){
      var n=count(di.value);
      if(n===null||n>cap){dl.hidden=true;return;}       // a name, an over-cap block, or unparsed: no line
      dl.innerHTML="address scope &middot; <b>"+grp(n.toString())+"</b> addresses &middot; within your cap of <b>"+grp(cap.toString())+"</b>";
      dl.hidden=false;
    }
    di.addEventListener("input",sync);
    sync();
  }
})();
</script>
{{template "foot" .}}{{end}}
