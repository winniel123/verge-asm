.sc-msg .txt { font: 400 12.5px/1.5 var(--font-ui); color: var(--text-secondary); }
.sc-when { font: 500 12.5px var(--font-mono); color: var(--text-body); border-bottom: 1px dashed var(--border-strong); cursor: default; white-space: nowrap; }
