
{{define "coverage"}}{{template "head" .}}
{{template "chrome" .}}
<style>
.cv-main { max-width: 1440px; width: 100%; margin: 0 auto; padding: 32px; display: flex; flex-direction: column; gap: 20px; }
.cv-main h1 { margin: 0; font: 600 21px var(--font-ui); letter-spacing: var(--heading-tracking); color: var(--text-ink); }
.cv-sub { font: 400 12.5px var(--font-ui); color: var(--text-muted); white-space: nowrap; }
.cv-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
.cv-col { display: flex; flex-direction: column; gap: 24px; }
.cv-card { background: var(--surface); border: 1px solid var(--border-default); border-radius: 16px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
.cv-card.flush { overflow: hidden; }
.cv-cardhead { display: flex; flex-direction: column; gap: 3px; padding: 20px 20px 0; }
.cv-card.flush .cv-cardhead { padding: 20px 20px 14px; }
.cv-micro { font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
.cv-cardhead h3 { margin: 0; font: 600 15px var(--font-ui); letter-spacing: var(--heading-tracking); color: var(--text-ink); }
.cv-body { padding: 20px; }
.cv-meter { display: flex; flex-direction: column; gap: 6px; font-family: var(--font-ui); }
.cv-meter .top { display: flex; align-items: baseline; gap: 8px; }
.cv-meter .top .lbl { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
.cv-meter .top .val { margin-left: auto; flex: none; font: 400 11.5px var(--font-mono); color: var(--text-secondary); white-space: nowrap; }
.cv-meter .track { height: 6px; border-radius: 999px; background: var(--surface-sunken); overflow: hidden; }
.cv-meter .track .fill { display: block; height: 100%; border-radius: 999px; background: var(--accent); transition: width var(--dur-slow) var(--ease-out); }
.cv-meter .census { height: 6px; border-radius: 999px; overflow: hidden; background: repeating-linear-gradient(45deg, var(--accent-soft) 0 5px, var(--surface-sunken) 5px 10px); }
.cv-meter .det { font: 400 11px var(--font-ui); color: var(--text-muted); }
.cv-meter .evid { display: flex; flex-direction: column; gap: 4px; margin-top: 2px; padding: 10px 12px; border-radius: var(--r-sm); background: var(--surface-sunken); border: 1px solid var(--border-default); }
.cv-meter .evid .hd { font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
.cv-meter .evid .tx { font: 400 12px/1.55 var(--font-ui); color: var(--text-secondary); }
.cv-meter .evid a { color: var(--accent); text-decoration: none; }
.cv-meter .evid a:hover { text-decoration: underline; }
.cv-msgs { display: flex; flex-direction: column; font-family: var(--font-ui); }
.cv-msg { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: start; padding: 11px 0; }
.cv-msg + .cv-msg { border-top: 1px solid var(--row-sep); }
.cv-msg .sbj { font: 600 12px var(--font-mono); color: var(--text-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cv-msg .txt { font: 400 12.5px/1.5 var(--font-ui); color: var(--text-secondary); }
.cv-when { font: 500 12.5px var(--font-mono); color: var(--text-body); border-bottom: 1px dashed var(--border-strong); cursor: default; white-space: nowrap; }
.cv-gapbadge { display: inline-flex; align-items: center; gap: 4px; height: 18px; padding: 0 6px; border-radius: 8px; background: transparent; border: 1px dotted var(--border-strong); color: var(--text-secondary); font: 600 10px var(--font-mono); letter-spacing: 0.04em; white-space: nowrap; }
.cv-stale { display: inline-flex; align-items: center; gap: 4px; height: 18px; padding: 0 6px; border-radius: 8px; background: var(--stale-bg); border: 1px solid var(--stale-border); color: var(--stale-fg); font: 600 10px var(--font-mono); letter-spacing: 0.04em; white-space: nowrap; line-height: 1; }
.cv-stale .b { font-weight: 400; opacity: 0.8; }
.cv-table { width: 100%; border-collapse: separate; border-spacing: 0; }
.cv-table th { padding: 8px 16px; font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); border-bottom: 1px solid var(--border-default); white-space: nowrap; background: var(--surface); text-align: left; }
.cv-table td { padding: 7px 16px; font: 400 13px var(--font-ui); color: var(--text-body); vertical-align: middle; white-space: nowrap; border-top: 1px solid var(--row-sep); }
.cv-table tbody tr:first-child td { border-top: none; }
.cv-table td.mono { font: 400 12.5px var(--font-mono); }
.cv-rules { display: flex; flex-direction: column; gap: 12px; }
.cv-rule { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.cv-rulechip { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 8px; line-height: 1; background: var(--surface-sunken); border: 1px solid var(--border-default); color: var(--text-body); font: 500 11.5px var(--font-mono); cursor: default; }
.cv-rule .why { font: 400 12px/1.6 var(--font-ui); color: var(--text-muted); }
.cv-callout { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; background: var(--warn-soft); border: 1px solid var(--warn-border); border-radius: 12px; font-family: var(--font-ui); }
.cv-callout .ic { color: var(--warn); display: inline-flex; margin-top: 1px; flex: none; }
.cv-callout .ct { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.cv-callout .ct b { font: 600 13px var(--font-ui); color: var(--text-ink); }
.cv-callout .ct span { font: 400 13px/1.55 var(--font-ui); color: var(--text-body); }
.cv-btn-sm { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 10px; font: 600 12px var(--font-ui); cursor: pointer; white-space: nowrap; text-decoration: none; background: var(--surface); color: var(--text-body); border: 1px solid var(--border-strong); transition: background var(--dur-fast) var(--ease-out); }
.cv-btn-sm:hover { background: var(--surface-sunken); }
.cv-empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 36px 24px; font-family: var(--font-ui); }
.cv-empty .ico { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 999px; background: var(--accent-softer); border: 1px solid var(--accent-soft); color: var(--accent); margin-bottom: 8px; }
.cv-empty .msg { font: 600 14px var(--font-ui); color: var(--text-ink); }
.cv-empty .det { font: 400 13px/1.5 var(--font-ui); color: var(--text-secondary); max-width: 380px; }
.cv-empty .act { margin-top: 14px; }
.cv-ret { display: flex; flex-direction: column; gap: 22px; }
.cv-retlede { font: 400 12.5px/1.6 var(--font-ui); color: var(--text-secondary); max-width: 78ch; }
.cv-dials { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
.cv-dial { display: flex; flex-direction: column; gap: 9px; }
.cv-dialhead { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.cv-floor { margin-left: auto; font: 400 11.5px var(--font-mono); color: var(--text-secondary); white-space: nowrap; }
.cv-track { display: flex; align-items: stretch; border: 1px solid var(--border-default); border-radius: var(--r-md); background: var(--surface-sunken); overflow: hidden; }
.cv-ground { flex: none; width: 44px; border-right: 1px dashed var(--border-strong); background: repeating-linear-gradient(45deg, var(--border-default) 0 4px, transparent 4px 9px); }
.cv-stops { display: flex; flex: 1 1 auto; flex-wrap: wrap; gap: 2px; padding: 5px; }
.cv-stop { display: inline-flex; align-items: center; }
.cv-stop input { position: absolute; opacity: 0; width: 0; height: 0; }
.cv-stop span { display: inline-flex; align-items: center; height: 26px; padding: 0 10px; border-radius: 8px; font: 400 11.5px var(--font-mono); color: var(--text-secondary); white-space: nowrap; cursor: pointer; transition: background var(--dur-fast) var(--ease-out); }
.cv-stop span:hover { background: var(--surface); }
.cv-stop input:checked + span { background: var(--accent); color: var(--on-accent); font-weight: 500; }
.cv-stop input:focus-visible + span { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus-ring); }
.cv-stop.term { margin-left: auto; }
.cv-stop.term span { border: 1px solid var(--border-strong); }
.cv-stop.term input:checked + span { border-color: transparent; }
.cv-hint, .cv-horizon { font: 400 11.5px/1.6 var(--font-ui); color: var(--text-muted); }
.cv-pairs { display: flex; flex-direction: column; margin-top: 2px; }
.cv-pair { display: grid; grid-template-columns: minmax(0, 200px) 1fr auto; gap: 12px; align-items: baseline; padding: 7px 0; }
.cv-pair + .cv-pair { border-top: 1px solid var(--row-sep); }
.cv-pair .k { font: 500 12px var(--font-mono); color: var(--text-ink); overflow: hidden; text-overflow: ellipsis; }
.cv-pair .f { font: 400 11.5px var(--font-mono); color: var(--text-secondary); }
.cv-pair.uncov .f { color: var(--text-muted); }
.cv-pair .n { font: 400 11.5px var(--font-mono); color: var(--text-muted); text-align: right; white-space: nowrap; }
.cv-clamps { display: flex; flex-direction: column; margin: 0; padding: 0 0 0 22px; }
.cv-clamp { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding: 8px 0; }
.cv-clamps li::marker { font: 400 11px var(--font-mono); color: var(--text-muted); }
.cv-clamp + .cv-clamp { border-top: 1px solid var(--row-sep); }
.cv-clamp .ord { font: 400 11px var(--font-mono); color: var(--text-muted); }
.cv-clamp .lb { font: 400 12.5px var(--font-ui); color: var(--text-secondary); }
.cv-clamp .at { font: 400 11.5px var(--font-mono); color: var(--text-muted); white-space: nowrap; }
.cv-clamp .leaf { font: 400 11.5px var(--font-mono); color: var(--text-muted); }
.cv-clamp.ink .lb { color: var(--text-ink); font-weight: 600; }
.cv-clamp.ink .at, .cv-clamp.ink .leaf { color: var(--text-secondary); }
.cv-clamp.inert .lb, .cv-clamp.inert .at { color: var(--text-muted); text-decoration: line-through; }
.cv-proj { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; border-radius: var(--r-sm); background: var(--surface-sunken); border: 1px solid var(--border-default); }
.cv-proj .big { font: 600 20px var(--font-mono); color: var(--text-ink); }
.cv-proj .tx { font: 400 12px/1.6 var(--font-ui); color: var(--text-secondary); }
.cv-subhead { display: flex; align-items: baseline; gap: 10px; margin-top: 4px; }
@media (max-width: 900px) { .cv-dials { grid-template-columns: minmax(0, 1fr); } }
</style>
<main class="cv-main" data-screen-label="Coverage">
<header style="display:flex;flex-direction:column;gap:2px">
<h1>Coverage</h1>
<span class="cv-sub">Where "we cannot construct this claim" lives — a feature, not an error.</span>
</header>
<div class="cv-grid">
<div class="cv-col">
<section class="cv-card">
<div class="cv-cardhead"><span class="cv-micro">Aperture</span><h3>What the last batch walked</h3></div>
<div class="cv-body">
{{if .Meters}}
<div style="display:flex;flex-direction:column;gap:18px">
{{range .Meters}}
<div class="cv-meter">
<div class="top"><span class="lbl">{{.Label}}</span><span class="val">{{if .Withheld}}not measured{{else if .Total}}{{.Counted}} / {{.Total}}{{if .Unit}} {{.Unit}}{{end}}{{else}}census · {{.Counted}}{{if .Unit}} {{.Unit}}{{end}}{{end}}</span></div>
{{if .Withheld}}<div class="census" aria-label="Not measured — the read did not resolve"></div>{{else if .Total}}<div class="track" role="progressbar" aria-valuemin="0" aria-valuemax="{{.Total}}" aria-valuenow="{{.Counted}}"><span class="fill" style="width:{{.Pct}}%"></span></div>{{else}}<div class="census" aria-label="Census — no denominator"></div>{{end}}
{{if .Detail}}<span class="det">{{.Detail}}</span>{{end}}
{{if .AsOf}}<span class="det" title="{{.AsOfISO}}">oldest still current · {{.AsOf}}</span>{{end}}

{{if .SharedEdges}}<div class="evid"><span class="hd">Shared edges inside this scope</span><span class="tx">This scope covers {{.Covers}} address{{if ne .Covers "1"}}es{{end}}. {{if eq .SharedEdges "1"}}1 of them presents a fan-out above the threshold. <a href="/scope#exclusions">Exclude it from this scope</a> if it is not yours.{{else}}{{.SharedEdges}} of them present a fan-out above the threshold. <a href="/scope#exclusions">Exclude them from this scope</a> if they are not yours.{{end}}</span></div>{{end}}
</div>
{{end}}
</div>
{{else}}
<div class="cv-empty"><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19.07 4.93A10 10 0 0 0 6.99 3.34"></path><path d="M4 6h.01"></path><path d="M2.29 9.62a10 10 0 1 0 19.02-1.27"></path><path d="M16.24 7.76a6 6 0 1 0-8.01 8.91"></path><path d="M12 18h.01"></path><path d="M17.99 11.66a6 6 0 0 1-2.22 5.01"></path><circle cx="12" cy="12" r="2"></circle><path d="m13.41 10.59 5.66-5.66"></path></svg></span>
<span class="msg">No scope to walk yet</span>
<span class="det">No scope is declared, so the last batch walked nothing. Declare a name or address scope and the aperture fills as the batch reports at its cadence.</span>
<span class="act"><a class="cv-btn-sm" href="/scope">Go to Scope</a></span></div>
{{end}}
</div>
</section>
<section class="cv-card">
<div class="cv-cardhead"><span class="cv-micro">Currency</span><h3>Coverage messages</h3></div>
<div class="cv-body">
{{if .Messages}}
<div class="cv-msgs">
{{range .Messages}}
<div class="cv-msg">
<span style="padding-top:1px">{{if eq .Kind "gap"}}<span class="cv-gapbadge"><svg viewBox="0 0 10 10" width="9" height="9" style="flex:none"><rect x="1.6" y="1.6" width="6.8" height="6.8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.6 1.6"></rect></svg>{{.Badge}}</span>{{else}}<span class="cv-stale"><svg viewBox="0 0 10 10" width="9" height="9" style="flex:none"><circle cx="5" cy="5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M5 3.2V5l1.4 1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>{{.Badge}}{{if .Bound}}<span class="b">· {{.Bound}}</span>{{end}}</span>{{end}}</span>
<span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span class="sbj">{{.Subject}}</span><span class="txt">{{.Text}}</span></span>
{{if .When}}<span class="cv-when" title="{{.ISO}}">{{.When}}</span>{{end}}
</div>
{{end}}
</div>
{{else}}
<div class="cv-empty"><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>
<span class="msg">No coverage messages</span>
<span class="det">Nothing has aged past its currency and no position has gone silent. A gap, a stale source, or a vantage we could not look from would surface here.</span></div>
{{end}}
</div>
</section>
</div>
<div class="cv-col">
<section class="cv-card flush">
<div class="cv-cardhead"><span class="cv-micro">Gaps</span><h3>Expected, not observed</h3></div>
{{if .Gaps}}
<table class="cv-table">
<thead><tr><th>Subject</th><th style="width:130px">Gap</th><th style="width:190px">Expected</th><th style="width:60px;text-align:right">Since</th></tr></thead>
<tbody>
{{range .Gaps}}<tr>
<td class="mono">{{.Subject}}</td>
<td><span class="cv-gapbadge"><svg viewBox="0 0 10 10" width="9" height="9" style="flex:none"><rect x="1.6" y="1.6" width="6.8" height="6.8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.6 1.6"></rect></svg>{{.Gap}}</span></td>
<td>{{.Expected}}</td>
<td class="mono" style="text-align:right;color:var(--text-muted)">{{.Since}}</td>
</tr>{{end}}
</tbody>
</table>
{{else}}
<div class="cv-empty"><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>
<span class="msg">No gaps this batch</span>
<span class="det">Every expected observation arrived. A subject we expected to observe but did not — a name with no address, a service with no origin behind its edge — would appear here.</span></div>
{{end}}
</section>
<section class="cv-card">
<div class="cv-cardhead"><span class="cv-micro">Rules</span><h3>Unevaluable this batch</h3></div>
<div class="cv-body">
{{if .Unevaluable}}
<div class="cv-rules">
{{range .Unevaluable}}
<div class="cv-rule">
<span class="cv-rulechip" title="Rule {{.ID}} v{{.Version}} — definition in source"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12.5 8 15l2 2.5"></path><path d="m14 12.5 2 2.5-2 2.5"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"></path></svg>{{.ID}}@{{.Version}}</span>
<span class="why">{{.Why}}</span>
</div>
{{end}}
</div>
{{else}}
<div class="cv-empty"><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>
<span class="msg">Every rule could evaluate</span>
<span class="det">No rule was blocked from evaluating this batch. A rule that needs a reading the batch did not commit — a handshake never completed, a zone that aged into a gap — would be listed here with what it was waiting on.</span></div>
{{end}}
</div>
</section>
{{range .StaleZones}}
<div class="cv-callout"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span>
<span class="ct"><b>Zone gone stale</b><span>{{.Zone}}'s zone file is {{.Age}} old — removal detection is suspended for that scope until a fresh upload.<span style="display:block;margin-top:10px"><a class="cv-btn-sm" href="/scope">Upload zone</a></span></span></span></div>
{{end}}
</div>
</div>
{{with .Retention}}
<section class="cv-card" id="retention">
<div class="cv-cardhead"><span class="cv-micro">Retention</span><h3>How far back this answer reaches</h3></div>
<div class="cv-body">
<div class="cv-ret">
<span class="cv-retlede">Retention is what may still be read, never age. These two dials change nothing operational — they change how far back Coverage's own answer reaches, which is this screen's question in the time axis.</span>
{{if .Withheld}}
<span class="cv-hint">{{.Withheld}}</span>
{{else}}
{{if .IsAdmin}}
<form method="post" action="/coverage/retention" style="margin:0;display:flex;flex-direction:column;gap:22px">{{template "backfield" $}}
<div class="cv-dials">
{{template "cv-dial" .Observation}}
{{template "cv-dial" .Dispatch}}
</div>
<div><button type="submit" class="cv-btn-sm">Save dials</button></div>
</form>
{{else}}
<div class="cv-dials">
<div class="cv-dial"><div class="cv-dialhead"><span class="cv-micro">{{.Observation.Title}}</span><span class="cv-floor">floor · {{.Observation.FloorText}}</span></div><span class="cv-horizon">{{.Observation.HorizonText}}</span></div>
<div class="cv-dial"><div class="cv-dialhead"><span class="cv-micro">{{.Dispatch.Title}}</span><span class="cv-floor">floor · {{.Dispatch.FloorText}}</span></div><span class="cv-horizon">{{.Dispatch.HorizonText}}</span></div>
</div>
{{end}}

<div>
<div class="cv-subhead"><span class="cv-micro">What the observation dial reaches</span></div>
{{if .Pairs}}
<div class="cv-pairs">
{{range .Pairs}}<div class="cv-pair{{if not .Covered}} uncov{{end}}">
<span class="k">{{.Facet}} · {{.Source}}</span>
<span class="f">{{.FloorText}}{{if .Uncovered}} · {{.Uncovered}}{{end}}</span>
<span class="n">{{.Rows}} rows</span>
</div>{{end}}
</div>
{{else if .PairsWithheld}}
<span class="cv-hint">{{.PairsWithheld}}</span>
{{else}}
<span class="cv-hint">No observation has been recorded yet, so no facet-source pair carries a floor. A row appears here for each pair the batch writes, with the Scan supplying its bound.</span>
{{end}}
</div>

<div>
<div class="cv-subhead"><span class="cv-micro">Every clamp in force</span></div>
{{if .Clamps}}
<ol class="cv-clamps">
{{range .Clamps}}<li class="cv-clamp{{if .Binding}} ink{{end}}{{if .Inert}} inert{{end}}">
<span class="lb">{{.Label}}{{if .Names}} <span class="leaf">— {{.Names}} moved</span>{{end}}</span>
<span class="at"{{if .ISO}} title="{{.ISO}}"{{end}}>{{.At}}</span>
</li>{{end}}
</ol>
<span class="cv-hint">Tightest first. Only the binding clamp is drawn in ink, and it names the leaf that moved. A retention row sorting above it is drawn inert: retention may never be the tighter clamp.</span>
{{else if .ClampsWithheld}}
<span class="cv-hint">{{.ClampsWithheld}}</span>
{{else}}
<span class="cv-hint">No clamp is in force yet. The first batch, each Break, and each retention dial appear here in one list once the batch has run.</span>
{{end}}
</div>

<div>
<div class="cv-subhead"><span class="cv-micro">What this costs</span></div>
{{if .Projection.Withheld}}
<span class="cv-hint">{{.Projection.Withheld}}</span>
{{else}}
<div class="cv-proj">
<span class="big">{{.Projection.Held}} rows · {{.Projection.HeldBytes}}</span>
{{if .Projection.HasDenominator}}
<span class="tx">Held now. Your declared address scope covers {{.Projection.Denominator}} addresses, so a year at the enabled cadences is {{.Projection.PerYear}} rows, about {{.Projection.PerYearBytes}} in one compose volume.</span>
{{else}}
<span class="tx">Held now. {{.Projection.Reason}}</span>
{{end}}
</div>
{{end}}
</div>

<div>
<div class="cv-subhead"><span class="cv-micro">Discarded</span></div>
{{if .AnyBounded}}
<span class="cv-hint">A dial is bounded, so each sweep retires rows older than it that are also outside their own bound. No per-row record of a retirement is kept, so this group lists nothing by name. A live row is never among them: the floor sits at the tightest bound in force.</span>
{{else}}
<span class="cv-hint">Nothing has been discarded. Both dials are parked on keep everything, and the floor sits at the tightest bound in force, so no derivation has lost a row it may still read. This group renders whether or not it is empty.</span>
{{end}}
</div>

{{if .UpdatedAt}}<span class="cv-hint">Last changed {{.UpdatedAt}}.</span>{{end}}
{{end}}
</div>
</div>
</section>
{{end}}
</main>
{{template "foot" .}}{{end}}

{{define "cv-dial"}}
<div class="cv-dial">
<div class="cv-dialhead"><span class="cv-micro">{{.Title}}</span><span class="cv-floor">floor · {{.FloorText}}</span></div>
<div class="cv-track">
{{if .HasFloor}}<div class="cv-ground" title="{{.FloorHint}}" aria-hidden="true"></div>{{end}}
<div class="cv-stops">
{{range .Stops}}<label class="cv-stop"><input type="radio" name="{{$.Field}}" value="{{.Value}}"{{if .Selected}} checked{{end}}><span>{{.Label}}</span></label>{{end}}
<label class="cv-stop term"><input type="radio" name="{{$.Field}}" value="0"{{if .Terminal.Selected}} checked{{end}}><span>{{.Terminal.Label}}</span></label>
</div>
</div>
<span class="cv-hint">{{.FloorHint}}</span>
<span class="cv-horizon">{{.HorizonText}}</span>
</div>
{{end}}
