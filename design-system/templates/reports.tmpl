{{/*
  DESIGN-OWNED ARTIFACT — reports.tmpl · package v3.11.0 · WORKFLOW.md v4
  Source of truth: examples/console/Reports.jsx · shot 09 (+ wizard overlay, shot 09b). Replaces
  templates_reports.go (defines "reports" + "schedulewizard" + "deltachip" + "spark" + "barchart"
  kept). "sevbadge" (signals.tmpl) is NOT used here — severity rows are the bar treatment.
  Holes kept: .RangeLabel .HasOpenSignals .OpenSignals .OpenDelta{Has,Text,Dir,Tone} .HasOpenSpark
  .OpenSpark{W,H,Area,Line,Color,DotX,DotY} .HasDiscovery .DiscoveryCount .DiscoveryDelta
  .DiscoveryNames .DiscoveryServices .DiscoveryBars{Bars[{HeightPct,Title,Last}],LeftLabel,
  RightLabel} (≤31 bars — aggregate to weekly beyond a month) .HasMTTW .MTTW .MTTWDelta .HasMTTWSpark .MTTWSpark .HasSignalSeries
  .SignalSeries{W,H,N,Grid[{Y,X1,X2,Stroke,LabelX,Label}],AllOpen,CritHigh,XLabels[{X,Y,Text}],
  LabelsAttr,SeriesJSON} .HasSeverity .BySeverity[{Sev,Label,Pct,Count}] .HasHeat
  .Heat[{Title,Bg,Border}] .RangeWeeks .Schedules[{ID,Name,Cadence,Delivery,Format,LastSent,
  LastMins,HasDelivery,DeliveryHref}].
  Reconciliations (SPEC-CHANGE #23, ruled): the third KPI is "Mean time to withdrawal" — the
  mock's "resolve" predates the withdrawal ontology (#23a); the period control is the spec range
  picker (preset token links + custom ISO pair, GET /reports?period= | ?start=&end= — drift #20b
  mechanism; .Periods/.Period/.PeriodLabel join, .RangeOptions/weeks retire) (#23b); Export is the
  spec SplitButton — primary CSV + menu JSON/PDF; format=pdf renders the period document via
  internal/message.RenderArtifactPDF (BUILD the route wiring) (#23c); the discovery caption keeps
  the estate vocabulary (names · services — the mock's "domains · IPs" predates the subject
  ontology) (#23d); the schedules table gains client-side sort on Report + Last sent (view JS,
  ADR-0105 precedent; .LastMins is the sort value) (#23e); the row menu is the spec kebab dropdown
  (view JS; routes kept). Sparkline draw-in and bar rise are the component's own motion, CSS-only.
*/}}
{{define "deltachip"}}<span class="rp-delta {{.Tone}}">{{if .Dir}}<svg viewBox="0 0 10 10" width="8" height="8" aria-hidden="true"{{if eq .Dir "down"}} style="transform:rotate(180deg)"{{end}}><path d="M5 8.5V1.5M1.8 4.7L5 1.5l3.2 3.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>{{end}}{{.Text}}</span>{{end}}

{{define "spark"}}<svg width="100%" height="{{.H}}" viewBox="0 0 {{.W}} {{.H}}" preserveAspectRatio="none" style="display:block;width:100%;overflow:visible" aria-hidden="true"><path d="{{.Area}}" fill="{{.Color}}" class="rp-sparkarea"></path><polyline points="{{.Line}}" fill="none" stroke="{{.Color}}" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" pathLength="100" stroke-dasharray="100" class="rp-sparkline"></polyline><circle cx="{{.DotX}}" cy="{{.DotY}}" r="2.5" fill="{{.Color}}" class="rp-sparkdot"></circle></svg>{{end}}

{{define "barchart"}}<div style="display:flex;flex-direction:column;gap:6px" aria-hidden="true"><div style="display:flex;align-items:flex-end;gap:4px;height:44px;border-bottom:1px solid var(--chart-grid);padding-bottom:1px;min-width:0;overflow:hidden">{{range .Bars}}<span title="{{.Title}}" class="rp-bar" style="height:{{.HeightPct}}%;{{if not .Last}}opacity:0.45{{end}}"></span>{{end}}</div><div style="display:flex;justify-content:space-between;gap:8px"><span style="font:400 9.5px var(--font-mono);color:var(--text-muted);white-space:nowrap">{{.LeftLabel}}</span><span style="font:400 9.5px var(--font-mono);color:var(--text-muted);white-space:nowrap">{{.RightLabel}}</span></div></div>{{end}}

{{define "reports"}}{{template "head" .}}
{{template "chrome" .}}
<style>
@keyframes rp-pop { from { opacity: 0; transform: translateY(6px) scale(0.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes rp-draw { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
@keyframes rp-fadein { from { opacity: 0; } }
@keyframes rp-rise { from { transform: scaleY(0.04); } }
.rp-main { max-width: 1440px; margin: 0 auto; padding: 32px; display: flex; flex-direction: column; gap: 24px; }
.rp-main h1 { margin: 0; font: 600 21px var(--font-ui); letter-spacing: var(--heading-tracking); color: var(--text-ink); }
.rp-sub { font: 400 12.5px var(--font-ui); color: var(--text-muted); white-space: nowrap; }
.rp-card { background: var(--surface); border: 1px solid var(--border-default); border-radius: 16px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
.rp-cardhead { display: flex; align-items: center; gap: 12px; padding: 20px 20px 0; }
.rp-cardhead .hd { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.rp-micro { font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
.rp-cardhead h3 { margin: 0; font: 600 15px var(--font-ui); letter-spacing: var(--heading-tracking); color: var(--text-ink); }
.rp-body { padding: 20px; }
.rp-kpi { background: var(--surface); border: 1px solid var(--border-default); border-radius: 16px; box-shadow: var(--shadow-sm); padding: 20px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.rp-kpi .top { display: flex; align-items: baseline; gap: 10px; }
.rp-kpi .per { margin-left: auto; font: 400 11px var(--font-mono); color: var(--text-muted); white-space: nowrap; }
.rp-kpi .vr { display: flex; align-items: baseline; gap: 8px; }
.rp-kpi .num { font: 600 28px var(--font-mono); color: var(--text-ink); line-height: 1.1; }
.rp-kpi .cap { font: 400 11.5px var(--font-ui); color: var(--text-muted); }
.rp-kpi .chart { margin-top: auto; }
.rp-delta { display: inline-flex; align-items: center; gap: 4px; height: 18px; padding: 0 7px; border-radius: 999px; border: 1px solid transparent; font: 600 11px var(--font-mono); line-height: 1; white-space: nowrap; transform: translateY(-2px); }
.rp-delta.bad { background: var(--danger-soft); border-color: var(--danger-border); color: var(--danger); }
.rp-delta.good { background: var(--ok-soft); border-color: var(--ok-border); color: var(--ok); }
.rp-delta.neutral { background: var(--surface-sunken); border-color: var(--border-default); color: var(--text-secondary); }
.rp-sparkarea { opacity: 0.1; animation: rp-fadein 400ms var(--ease-out) 250ms backwards; }
.rp-sparkline { animation: rp-draw 550ms var(--ease-out); }
.rp-sparkdot { animation: rp-fadein 250ms var(--ease-out) 480ms backwards; }
.rp-bar { flex: 1; min-width: 3px; min-height: 2px; border-radius: 3px 3px 0 0; background: var(--chart-1); transform-origin: bottom; animation: rp-rise 450ms var(--ease-out); }
.rp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 36px; padding: 0 16px; border-radius: 12px; font: 600 13px var(--font-ui); cursor: pointer; white-space: nowrap; text-decoration: none; background: var(--surface); color: var(--text-body); border: 1px solid var(--border-strong); transition: background var(--dur-fast) var(--ease-out); }
.rp-btn:hover { background: var(--surface-sunken); }
.rp-btn .mono { font: 500 12px var(--font-mono); }
.rp-split { display: inline-flex; }
.rp-split .main { border-top-right-radius: 0; border-bottom-right-radius: 0; border-right: none; }
.rp-split .caret { border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 0 8px; border-left: 1px solid var(--border-strong); }
.rp-pop { position: relative; display: inline-flex; }
.rp-panel { position: absolute; top: 100%; right: 0; margin-top: 6px; z-index: 95; background: var(--surface-raised); border: 1px solid var(--border-default); border-radius: 12px; box-shadow: var(--shadow-md); padding: 5px; animation: rp-pop var(--dur-base) var(--ease-out); display: flex; flex-direction: column; gap: 2px; font-family: var(--font-ui); min-width: 170px; }
.rp-panel[hidden] { display: none; }
.rp-panel.range { width: 232px; padding: 14px; gap: 3px; }
.rp-mi { display: flex; align-items: center; gap: 9px; width: 100%; height: 30px; padding: 0 10px; border: none; border-radius: 8px; text-align: left; cursor: pointer; background: transparent; color: var(--text-body); font: 500 12.5px var(--font-ui); text-decoration: none; box-sizing: border-box; transition: background var(--dur-fast) var(--ease-out); }
.rp-mi:hover { background: var(--surface-sunken); }
.rp-mi.danger { color: var(--danger); }
.rp-mi.danger:hover { background: var(--danger-soft); }
.rp-mi .mic { display: inline-flex; color: var(--text-secondary); flex: none; }
.rp-mi.danger .mic { color: var(--danger); }
.rp-mi[aria-disabled="true"] { opacity: 0.5; cursor: default; }
.rp-mi[aria-disabled="true"]:hover { background: transparent; }
.rp-sep { height: 1px; background: var(--row-sep); margin: 5px 4px; }
.rp-preset { display: flex; align-items: center; gap: 8px; width: 100%; height: 30px; padding: 0 10px; border: none; border-radius: 8px; text-align: left; cursor: pointer; text-decoration: none; background: transparent; color: var(--text-body); font: 500 12.5px var(--font-ui); transition: background var(--dur-fast) var(--ease-out); }
.rp-preset:hover { background: var(--surface-sunken); }
.rp-preset.on { background: var(--accent-soft); color: var(--link); font-weight: 600; }
.rp-preset .ck { margin-left: auto; display: inline-flex; color: var(--link); }
.rp-panel .lbl { font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); padding: 2px 2px 4px; }
.rp-panel input.iso { width: 100%; height: 28px; padding: 0 8px; border: 1px solid var(--border-default); border-radius: 8px; background: var(--surface); color: var(--text-ink); font: 400 11.5px var(--font-mono); outline: none; box-sizing: border-box; }
.rp-apply { display: inline-flex; align-items: center; justify-content: center; height: 30px; padding: 0 12px; border-radius: 10px; font: 600 12px var(--font-ui); cursor: pointer; white-space: nowrap; background: var(--accent); color: var(--on-accent); border: 1px solid transparent; margin-top: 8px; width: 100%; transition: background var(--dur-fast) var(--ease-out); }
.rp-apply:hover { background: var(--accent-hover); }
.rp-apply[disabled] { opacity: 0.45; cursor: default; }
.rp-apply[disabled]:hover { background: var(--accent); }
.rp-btn-ghost { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 10px; font: 600 12px var(--font-ui); cursor: pointer; white-space: nowrap; text-decoration: none; background: transparent; color: var(--text-secondary); border: 1px solid transparent; transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
.rp-btn-ghost:hover { background: var(--surface-sunken); color: var(--text-body); }
.rp-sevrow { display: flex; align-items: center; gap: 12px; }
.rp-sevrow .sl { width: 72px; font: 500 11px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
.rp-sevrow .st { flex: 1; height: 8px; border-radius: 999px; background: var(--surface-sunken); overflow: hidden; }
.rp-sevrow .sf { display: block; height: 100%; border-radius: 999px; }
.rp-sevrow .sn { width: 26px; text-align: right; font: 500 12.5px var(--font-mono); color: var(--text-body); }
.rp-table { width: 100%; border-collapse: separate; border-spacing: 0; }
.rp-table th { padding: 8px 16px; font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); border-bottom: 1px solid var(--border-default); white-space: nowrap; background: var(--surface); text-align: left; }
.rp-table th button { border: none; background: transparent; padding: 0; cursor: pointer; font: inherit; color: inherit; letter-spacing: inherit; text-transform: inherit; display: inline-flex; align-items: center; }
.rp-table td { padding: 7px 16px; font: 400 13px var(--font-ui); color: var(--text-body); vertical-align: middle; white-space: nowrap; border-top: 1px solid var(--row-sep); }
.rp-table tbody tr:first-child td { border-top: none; }
.rp-table td.mono { font: 400 12.5px var(--font-mono); }
.rp-caret { margin-left: 5px; vertical-align: -1px; }
.rp-tag { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 8px; background: var(--surface-sunken); border: 1px solid var(--border-default); color: var(--text-secondary); font-family: var(--font-mono); font-size: 11.5px; white-space: nowrap; }
.rp-kebab { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border: 1px solid transparent; border-radius: 10px; background: transparent; color: var(--text-secondary); cursor: pointer; transition: background var(--dur-fast) var(--ease-out); padding: 0; }
.rp-kebab:hover { background: var(--surface-sunken); color: var(--text-body); }
.rp-empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 36px 24px; font-family: var(--font-ui); }
.rp-empty .msg { font: 600 14px var(--font-ui); color: var(--text-ink); }
.rp-empty .det { font: 400 13px/1.5 var(--font-ui); color: var(--text-secondary); max-width: 400px; }
.rp-empty .act { margin-top: 12px; }
.rp-tip { position: absolute; background: var(--surface); border: 1px solid var(--border-default); border-radius: 10px; box-shadow: var(--shadow-md); padding: 8px 10px; pointer-events: none; display: flex; flex-direction: column; gap: 5px; min-width: 110px; z-index: 5; }
.rp-tip[hidden] { display: none; }
.rp-tip .tl { font: 500 10.5px var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
.rp-tip .row { display: flex; align-items: center; gap: 6px; }
.rp-tip .sw { width: 8px; height: 8px; border-radius: 2px; flex: none; }
.rp-tip .nm { font: 400 12px var(--font-ui); color: var(--text-secondary); }
.rp-tip .vl { margin-left: auto; font: 500 12px var(--font-mono); color: var(--text-ink); padding-left: 10px; }
.rp-legend { display: flex; gap: 16px; flex-wrap: wrap; padding-left: 40px; margin-top: 10px; }
.rp-legend .it { display: inline-flex; align-items: center; gap: 6px; }
.rp-legend .sw { width: 8px; height: 8px; border-radius: 2px; }
.rp-legend .nm { font: 400 12px var(--font-ui); color: var(--text-secondary); }
</style>
<main class="rp-main" data-screen-label="Reports">
<header style="display:flex;align-items:center;gap:16px">
<div style="display:flex;flex-direction:column;gap:2px">
<h1>Reports</h1>
<span class="rp-sub">Trends and scheduled exports for the selected period.</span>
</div>
<div style="margin-left:auto;display:flex;gap:8px;align-items:center">
<span class="rp-pop">
<button type="button" class="rp-btn" id="rp-range-btn" aria-haspopup="true" aria-expanded="false"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg><span class="mono">{{.PeriodLabel}}</span></button>
<div class="rp-panel range" id="rp-range-panel" hidden>
{{range .Periods}}<a class="rp-preset{{if eq .Token $.Period}} on{{end}}" href="/reports?period={{.Token}}">{{.Label}}{{if eq .Token $.Period}}<span class="ck"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>{{end}}</a>{{end}}
<div class="rp-sep"></div>
<span class="lbl">Custom (ISO 8601)</span>
<form method="get" action="/reports" style="display:flex;flex-direction:column;gap:3px;margin:0">
<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px">
<input class="iso" name="start" placeholder="2026-08-01" autocomplete="off">
<input class="iso" name="end" placeholder="2026-08-22" autocomplete="off">
</div>
<button type="submit" class="rp-apply" disabled>Apply range</button>
</form>
</div>
</span>
<span class="rp-split rp-pop">
<a class="rp-btn main" href="/reports/export?format=csv&period={{.Period}}"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>Export CSV</a>
<button type="button" class="rp-btn caret" id="rp-export-btn" aria-haspopup="menu" aria-expanded="false" aria-label="More formats"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></button>
<div class="rp-panel" id="rp-export-panel" hidden role="menu">
<a class="rp-mi" role="menuitem" href="/reports/export?format=json&period={{.Period}}"><span class="mic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"></path><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"></path></svg></span>Export JSON</a>
<a class="rp-mi" role="menuitem" href="/reports/export?format=pdf&period={{.Period}}"><span class="mic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path><path d="M14 2v6h6"></path></svg></span>Export PDF</a>
</div>
</span>
</div>
</header>
<div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:24px">
<section class="rp-kpi">
<div class="top"><span class="rp-micro">Open signals</span><span class="per">{{.RangeLabel}}</span></div>
<div style="display:flex;flex-direction:column;gap:2px">
<span class="vr"><span class="num">{{if .HasOpenSignals}}{{.OpenSignals}}{{else}}—{{end}}</span>{{if .OpenDelta.Has}}{{template "deltachip" .OpenDelta}}{{end}}</span>
<span class="cap">vs previous period</span>
</div>
{{if .HasOpenSpark}}<div class="chart">{{template "spark" .OpenSpark}}</div>{{end}}
</section>
<section class="rp-kpi">
<div class="top"><span class="rp-micro">New assets discovered</span><span class="per">{{.RangeLabel}}</span></div>
<div style="display:flex;flex-direction:column;gap:2px">
<span class="vr"><span class="num">{{if .HasDiscovery}}{{.DiscoveryCount}}{{else}}—{{end}}</span>{{if .DiscoveryDelta.Has}}{{template "deltachip" .DiscoveryDelta}}{{end}}</span>
<span class="cap">{{if .HasDiscovery}}{{.DiscoveryNames}} names · {{.DiscoveryServices}} services{{else}}first appearances over the period{{end}}</span>
</div>
{{if .HasDiscovery}}<div class="chart">{{template "barchart" .DiscoveryBars}}</div>{{end}}
</section>
<section class="rp-kpi">
<div class="top"><span class="rp-micro">Mean time to withdrawal</span><span class="per">{{.RangeLabel}}</span></div>
<div style="display:flex;flex-direction:column;gap:2px">
<span class="vr"><span class="num">{{if .HasMTTW}}{{.MTTW}}{{else}}—{{end}}</span>{{if .MTTWDelta.Has}}{{template "deltachip" .MTTWDelta}}{{end}}</span>
<span class="cap">critical + high only</span>
</div>
{{if .HasMTTWSpark}}<div class="chart">{{template "spark" .MTTWSpark}}</div>{{end}}
</section>
</div>
<section class="rp-card">
<div class="rp-cardhead"><div class="hd"><span class="rp-micro">Trend</span><h3>Open signals over time</h3></div></div>
<div class="rp-body">
{{if .HasSignalSeries}}
{{with .SignalSeries}}
<div id="rp-chart" style="position:relative" data-n="{{.N}}" data-w="{{.W}}" data-h="{{.H}}" data-labels="{{.LabelsAttr}}" data-series="{{.SeriesJSON}}">
<svg id="rp-ts" width="100%" height="{{.H}}" viewBox="0 0 {{.W}} {{.H}}" role="img" aria-label="Open signals over time" style="display:block;overflow:visible;max-width:100%">
{{range .Grid}}<line x1="{{.X1}}" x2="{{.X2}}" y1="{{.Y}}" y2="{{.Y}}" stroke="{{.Stroke}}" stroke-width="1"></line><text x="{{.LabelX}}" y="{{.Y}}" dy="3" text-anchor="end" style="font:400 10.5px var(--font-mono);fill:var(--text-muted)">{{.Label}}</text>
{{end}}<g id="rp-cross"></g>
<polyline points="{{.AllOpen}}" fill="none" stroke="var(--chart-1)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></polyline>
<polyline points="{{.CritHigh}}" fill="none" stroke="var(--chart-2)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></polyline>
{{range .XLabels}}<text x="{{.X}}" y="{{.Y}}" text-anchor="middle" style="font:400 10.5px var(--font-mono);fill:var(--text-muted)">{{.Text}}</text>
{{end}}</svg>
<div class="rp-tip" id="rp-tip" hidden></div>
</div>
<div class="rp-legend">
<span class="it"><span class="sw" style="background:var(--chart-1)"></span><span class="nm">All open</span></span>
<span class="it"><span class="sw" style="background:var(--chart-2)"></span><span class="nm">Critical + high</span></span>
</div>
{{end}}
{{else}}
<div class="rp-empty">
<span class="msg">No signal history</span>
<span class="det">Open-signal history builds here as signals are first raised over the period. Declare a scope on Scope and run a scan to start the series.</span>
<span class="act"><a class="rp-btn-ghost" href="/signals">Go to Signals</a></span>
</div>
{{end}}
</div>
</section>
<div style="display:grid;grid-template-columns:380px 1fr;gap:24px;align-items:start">
<div style="display:flex;flex-direction:column;gap:24px">
<section class="rp-card">
<div class="rp-cardhead"><div class="hd"><span class="rp-micro">Open signals</span><h3>By severity</h3></div></div>
<div class="rp-body">
{{if .HasSeverity}}
<div style="display:flex;flex-direction:column;gap:12px">
{{range .BySeverity}}
<div class="rp-sevrow">
<span class="sl">{{.Label}}</span>
<span class="st"><span class="sf" style="width:{{.Pct}}%;background:var(--sev-{{.Sev}}-dot)"></span></span>
<span class="sn">{{.Count}}</span>
</div>
{{end}}
</div>
{{else}}
<div class="rp-empty" style="padding:24px 12px">
<span class="msg">No signals firing</span>
<span class="det">Nothing is firing across the rule set right now. When a rule raises a signal it appears here, ranked by severity.</span>
<span class="act"><a class="rp-btn-ghost" href="/signals">Go to Signals</a></span>
</div>
