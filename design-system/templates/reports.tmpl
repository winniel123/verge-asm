<span class="act"><a class="rp-btn-ghost" href="/scans">Go to Scans</a></span>
</div>
{{end}}
</div>
</section>
</div>
<section class="rp-card" style="overflow:visible">
<div class="rp-cardhead" style="padding-bottom:14px"><div class="hd"><span class="rp-micro">Scheduled</span><h3>Recurring reports</h3></div><a class="rp-btn-ghost" href="/reports/schedule/new" style="margin-left:auto"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>New schedule</a></div>
{{if .Schedules}}
<table class="rp-table" id="rp-sched">
<thead><tr>
<th><button type="button" data-sort="name">Report<svg class="rp-caret" viewBox="0 0 10 14" width="8" height="11"><path d="M5 1.5L8 5H2Z" fill="var(--border-strong)"></path><path d="M5 12.5L2 9h6Z" fill="var(--border-strong)"></path></svg></button></th>
<th style="width:150px">Cadence</th>
<th style="width:175px">Delivery</th>
<th style="width:76px">Format</th>
<th style="width:90px;text-align:right"><button type="button" data-sort="last" style="justify-content:flex-end;width:100%">Last sent<svg class="rp-caret" viewBox="0 0 10 14" width="8" height="11"><path d="M5 1.5L8 5H2Z" fill="var(--border-strong)"></path><path d="M5 12.5L2 9h6Z" fill="var(--border-strong)"></path></svg></button></th>
<th style="width:58px" aria-label="Actions"></th>
</tr></thead>
<tbody>
{{range .Schedules}}
<tr data-name="{{.Name}}" data-last="{{.LastMins}}">
<td><span style="font:500 13px var(--font-ui);color:var(--text-ink)">{{.Name}}</span></td>
<td class="mono">{{.Cadence}}</td>
<td class="mono">{{.Delivery}}</td>
<td><span class="rp-tag">{{.Format}}</span></td>
<td class="mono" style="text-align:right">{{.LastSent}}</td>
<td style="text-align:right;overflow:visible">
<span class="rp-pop">
<button type="button" class="rp-kebab" data-row-menu aria-haspopup="menu" aria-expanded="false" aria-label="Actions"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="19" cy="12" r="1.6"></circle></svg></button>
<div class="rp-panel" hidden role="menu" style="min-width:190px">
{{if .HasDelivery}}<a class="rp-mi" role="menuitem" href="{{.DeliveryHref}}"><span class="mic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></span>View last delivery</a>
{{else}}<span class="rp-mi" role="menuitem" aria-disabled="true" title="No delivery yet"><span class="mic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></span>View last delivery</span>{{end}}
<form method="post" action="/reports/schedule/run" style="margin:0"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" class="rp-mi" role="menuitem" style="width:100%"><span class="mic"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" stroke="none"><path d="M8 5v14l11-7z"></path></svg></span>Run now</button></form>
<a class="rp-mi" role="menuitem" href="/reports/schedule/{{.ID}}/edit"><span class="mic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></span>Edit schedule</a>
<div class="rp-sep"></div>
<form method="post" action="/reports/schedule/delete" style="margin:0"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" class="rp-mi danger" role="menuitem" style="width:100%"><span class="mic"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></span>Delete schedule</button></form>
</div>
</span>
</td>
</tr>
{{end}}
</tbody>
</table>
{{else}}
<div class="rp-empty">
<span class="msg">No recurring reports</span>
<span class="det">No recurring reports yet. Create one with New schedule — it runs on its cadence and its last delivery shows in this table.</span>
</div>
{{end}}
</section>
</div>
</main>
<script>
(function(){
  function wirePop(btn,panel){
    btn.addEventListener("click",function(e){e.stopPropagation();var open=panel.hasAttribute("hidden");closeAll();if(open){panel.removeAttribute("hidden");btn.setAttribute("aria-expanded","true");}});
    document.addEventListener("mousedown",function(e){if(!panel.hasAttribute("hidden")&&!panel.contains(e.target)&&!btn.contains(e.target)){panel.setAttribute("hidden","");btn.setAttribute("aria-expanded","false");}});
  }
  var pops=[];
  function closeAll(){pops.forEach(function(p){p[1].setAttribute("hidden","");p[0].setAttribute("aria-expanded","false");});}
  var rb=document.getElementById("rp-range-btn"),rp=document.getElementById("rp-range-panel");
  if(rb&&rp){pops.push([rb,rp]);wirePop(rb,rp);
    var form=rp.querySelector("form"),inputs=form.querySelectorAll("input"),apply=form.querySelector(".rp-apply");
    function chk(){var ok=true;[].forEach.call(inputs,function(i){if(!i.value)ok=false;});if(ok)apply.removeAttribute("disabled");else apply.setAttribute("disabled","");}
    [].forEach.call(inputs,function(i){i.addEventListener("input",chk);});
  }
  var eb=document.getElementById("rp-export-btn"),ep=document.getElementById("rp-export-panel");
  if(eb&&ep){pops.push([eb,ep]);wirePop(eb,ep);}
  [].forEach.call(document.querySelectorAll("[data-row-menu]"),function(b){var p=b.parentNode.querySelector(".rp-panel");pops.push([b,p]);wirePop(b,p);});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")closeAll();});
  var chart=document.getElementById("rp-chart");
  if(chart){
    var svg=document.getElementById("rp-ts"),tip=document.getElementById("rp-tip"),cross=document.getElementById("rp-cross");
    var N=+chart.getAttribute("data-n"),W=+chart.getAttribute("data-w"),H=+chart.getAttribute("data-h");
    var labels=chart.getAttribute("data-labels").split("|");
    var series=JSON.parse(chart.getAttribute("data-series"));
    var PL=40,PR=8,PT=10,PB=22,iw=W-PL-PR;
    var top=0;series.forEach(function(s){s.data.forEach(function(v){if(v>top)top=v;});});
    var raw=(top||1)/4,mag=Math.pow(10,Math.floor(Math.log10(raw))),norm=raw/mag;
    var step=(norm<=1?1:norm<=2?2:norm<=5?5:10)*mag;
    var yTop=Math.max(step,Math.ceil(top/step)*step);
    function x(i){return PL+(i/(N-1))*iw;}
    function y(v){return PT+(1-v/yTop)*(H-PT-PB);}
    svg.addEventListener("mousemove",function(e){
      var r=svg.getBoundingClientRect(),sx=W/r.width;
      var i=Math.round(((e.clientX-r.left)*sx-PL)/iw*(N-1));
      i=Math.max(0,Math.min(N-1,i));
      var ns="http://www.w3.org/2000/svg",h="";
      h='<line x1="'+x(i)+'" x2="'+x(i)+'" y1="'+PT+'" y2="'+(H-PB)+'" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="2 3"></line>';
      series.forEach(function(s){h+='<circle cx="'+x(i)+'" cy="'+y(s.data[i])+'" r="3" fill="'+s.color+'" stroke="var(--surface)" stroke-width="1.5"></circle>';});
      cross.innerHTML=h;
      var t='<span class="tl">'+(labels[i]||"")+'</span>';
      series.forEach(function(s){t+='<span class="row"><span class="sw" style="background:'+s.color+'"></span><span class="nm">'+s.label+'</span><span class="vl">'+s.data[i]+'</span></span>';});
      tip.innerHTML=t;tip.removeAttribute("hidden");
      var px=x(i)/sx,flip=px>r.width-150;
      tip.style.top=PT/sx+"px";
      tip.style.left=(flip?px-10:px+10)+"px";
      tip.style.transform=flip?"translateX(-100%)":"none";
    });
    svg.addEventListener("mouseleave",function(){tip.setAttribute("hidden","");cross.innerHTML="";});
  }
  var tbl=document.getElementById("rp-sched");
  if(tbl){
    var state={key:null,dir:1};
    [].forEach.call(tbl.querySelectorAll("[data-sort]"),function(btn){
      btn.addEventListener("click",function(){
        var k=btn.getAttribute("data-sort");
        state.dir=state.key===k?-state.dir:1;state.key=k;
        var tb=tbl.querySelector("tbody"),rows=[].slice.call(tb.querySelectorAll("tr"));
        rows.sort(function(a,b){
          if(k==="last")return((+a.getAttribute("data-last"))-(+b.getAttribute("data-last")))*state.dir;
          return a.getAttribute("data-name").localeCompare(b.getAttribute("data-name"))*state.dir;
        });
        rows.forEach(function(r){tb.appendChild(r);});
        [].forEach.call(tbl.querySelectorAll("[data-sort]"),function(o){
          var up=o.querySelector(".rp-caret path:first-child"),dn=o.querySelector(".rp-caret path:last-child");
          var on=o===btn;
          up.setAttribute("fill",on&&state.dir===1?"var(--accent)":"var(--border-strong)");
          dn.setAttribute("fill",on&&state.dir===-1?"var(--accent)":"var(--border-strong)");
        });
      });
    });
  }
})();
</script>
{{template "foot" .}}{{end}}

{{define "schedulewizard"}}{{template "head" .}}
{{template "chrome" .}}
<style>
@keyframes sw-pop { from { opacity: 0; transform: translateY(6px) scale(0.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
.sw-wrap { display: flex; justify-content: center; padding: 48px 32px; }
.sw-panel { background: var(--surface); border: 1px solid var(--border-default); border-radius: 24px; box-shadow: var(--shadow-lg); padding: 24px; width: 560px; max-width: 100%; box-sizing: border-box; font-family: var(--font-ui); }
.sw-panel h1 { margin: 0 0 4px; font: 600 16px var(--font-ui); letter-spacing: var(--heading-tracking); color: var(--text-ink); }
.sw-desc { margin: 0 0 20px; color: var(--text-secondary); font: 400 13px/1.5 var(--font-ui); }
.sw-steps { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
.sw-conn { flex: 1; min-width: 12px; height: 1px; background: var(--row-sep); }
.sw-conn.lit { background: var(--accent); opacity: 0.4; }
.sw-step { display: inline-flex; align-items: center; gap: 8px; }
.sw-num { width: 22px; height: 22px; border-radius: 999px; flex: none; display: inline-flex; align-items: center; justify-content: center; font: 600 11px var(--font-mono); border: 1px solid var(--border-strong); color: var(--text-muted); background: transparent; box-sizing: border-box; }
.sw-num.cur { border: 1.5px solid var(--accent); color: var(--link); }
.sw-num.done { background: var(--accent-soft); border: 1px solid transparent; color: var(--link); }
.sw-step .lbl { font: 400 12.5px var(--font-ui); color: var(--text-secondary); white-space: nowrap; }
.sw-step.cur .lbl { font-weight: 600; color: var(--text-ink); }
.sw-body { display: flex; flex-direction: column; gap: 16px; }
.sw-flabel { font: 500 12.5px var(--font-ui); color: var(--text-body); display: block; margin-bottom: 6px; }
.sw-input { display: flex; align-items: center; height: 36px; padding: 0 12px; background: var(--surface); border: 1px solid var(--border-default); border-radius: 12px; box-sizing: border-box; width: 100%; transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
.sw-input:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 18%, transparent); }
.sw-input input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; color: var(--text-ink); font: 400 13px var(--font-ui); }
.sw-input input.mono { font: 400 12px var(--font-mono); }
.sw-secs { display: flex; flex-direction: column; gap: 10px; }
.sw-check { display: flex; align-items: center; gap: 8px; font: 400 13px var(--font-ui); color: var(--text-body); cursor: pointer; }
.sw-check .box { width: 18px; height: 18px; flex: none; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; background: var(--surface); border: 1px solid var(--border-strong); transition: background var(--dur-fast) var(--ease-out); }
.sw-check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.sw-check input:checked + .box { background: var(--accent); border-color: var(--accent); }
.sw-check .box svg { display: none; }
.sw-check input:checked + .box svg { display: block; }
.sw-check input:focus-visible + .box { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus-ring); }
.sw-listbox { position: relative; display: flex; width: 100%; }
.sw-listbox .trig { display: flex; align-items: center; gap: 8px; width: 100%; height: 36px; padding: 0 12px; background: var(--surface); color: var(--text-ink); font: 400 13px var(--font-ui); text-align: left; border: 1px solid var(--border-default); border-radius: 12px; cursor: pointer; box-sizing: border-box; }
.sw-listbox .trig .cv { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sw-listbox .trig .chev { color: var(--text-muted); flex: none; transition: transform var(--dur-base) var(--ease-out); }
.sw-listbox .trig[aria-expanded="true"] { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 18%, transparent); }
.sw-listbox .trig[aria-expanded="true"] .chev { transform: rotate(180deg); }
.sw-listbox .panel { position: absolute; top: 100%; left: 0; margin-top: 6px; width: 100%; z-index: 95; background: var(--surface-raised); border: 1px solid var(--border-default); border-radius: 12px; box-shadow: var(--shadow-md); padding: 5px; animation: sw-pop var(--dur-base) var(--ease-out); display: flex; flex-direction: column; gap: 2px; box-sizing: border-box; }
.sw-listbox .panel[hidden] { display: none; }
.sw-listbox .opt { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; width: 100%; padding: 6px 10px; border: none; border-radius: 8px; text-align: left; cursor: pointer; background: transparent; color: var(--text-body); font: 500 12.5px var(--font-ui); box-sizing: border-box; transition: background var(--dur-fast) var(--ease-out); }
.sw-listbox .opt:hover { background: var(--surface-sunken); }
.sw-listbox .opt.on { color: var(--link); font-weight: 600; }
.sw-listbox .opt .hint { font: 400 11px var(--font-ui); color: var(--text-muted); }
.sw-help { margin: 0; font: 400 12px/1.5 var(--font-ui); color: var(--text-muted); }
.sw-kv { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 20px; padding: 16px; background: var(--surface-sunken); border-radius: 12px; }
.sw-kv .cell { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.sw-kv .k { font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
.sw-kv .v { font: 400 12.5px var(--font-mono); color: var(--text-body); overflow-wrap: anywhere; }
.sw-foot { display: flex; align-items: center; gap: 8px; margin-top: 24px; }
.sw-count { margin-right: auto; font: 500 11px var(--font-mono); letter-spacing: 0.06em; color: var(--text-muted); }
.sw-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 36px; padding: 0 16px; border-radius: 12px; font: 600 13px var(--font-ui); cursor: pointer; white-space: nowrap; text-decoration: none; border: 1px solid transparent; transition: background var(--dur-fast) var(--ease-out); }
.sw-btn.pri { background: var(--accent); color: var(--on-accent); }
.sw-btn.pri:hover { background: var(--accent-hover); }
.sw-btn.pri[disabled] { opacity: 0.45; cursor: default; }
.sw-btn.pri[disabled]:hover { background: var(--accent); }
.sw-btn.sec { background: var(--surface); color: var(--text-body); border-color: var(--border-strong); }
.sw-btn.sec:hover { background: var(--surface-sunken); }
.sw-btn.ghost { background: transparent; color: var(--text-secondary); }
.sw-btn.ghost:hover { background: var(--surface-sunken); color: var(--text-body); }
.sw-micro { font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
</style>
<main class="sw-wrap" data-screen-label="Report schedule wizard">
<section class="sw-panel">
<h1>{{.WizardTitle}}</h1>
<p class="sw-desc">A recurring export, delivered on cadence.</p>
<div class="sw-steps">
{{range $i, $s := .Steps}}
{{if $i}}<span class="sw-conn{{if or $s.Done $s.Current}} lit{{end}}"></span>{{end}}
<span class="sw-step{{if $s.Current}} cur{{end}}">
<span class="sw-num{{if $s.Done}} done{{else if $s.Current}} cur{{end}}">{{if $s.Done}}<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{{else}}{{$s.Num}}{{end}}</span>
<span class="lbl">{{$s.Title}}</span>
</span>
{{end}}
</div>
<form method="post" action="{{.FormAction}}" id="sw-form">
<input type="hidden" name="step" value="{{.Step}}">
{{if .EditMode}}<input type="hidden" name="id" value="{{.ID}}">{{end}}
{{if ne .Step 0}}<input type="hidden" name="name" value="{{.Name}}">
{{range .SectionsKeys}}<input type="hidden" name="sections" value="{{.}}">{{end}}{{end}}
{{if ne .Step 1}}<input type="hidden" name="cad" value="{{.Cad}}">
<input type="hidden" name="cron" value="{{.Cron}}">{{end}}
{{if ne .Step 2}}<input type="hidden" name="channel" value="{{.ChannelID}}">{{end}}
<div class="sw-body">
{{if eq .Step 0}}
<label><span class="sw-flabel">Report name</span>
<span class="sw-input"><input type="text" name="name" value="{{.Name}}" placeholder="Weekly exposure summary" spellcheck="false" autocomplete="off" data-sw-req></span>
</label>
<div class="sw-secs">
<span class="sw-micro">Sections</span>
{{range .Sections}}<label class="sw-check"><input type="checkbox" name="sections" value="{{.Key}}"{{if .Checked}} checked{{end}} data-sw-sec><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>{{.Label}}</label>{{end}}
</div>
{{end}}
{{if eq .Step 1}}
<div>
<span class="sw-flabel">Cadence</span>
<input type="hidden" name="cad" value="{{.Cad}}" id="sw-cad">
<span class="sw-listbox">
<button type="button" class="trig" id="sw-cad-btn" aria-haspopup="listbox" aria-expanded="false"><span class="cv">{{.Cad}}</span><svg class="chev" viewBox="0 0 16 16" width="14" height="14"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
<div class="panel" id="sw-cad-panel" hidden>
{{range .Cads}}<button type="button" class="opt{{if .Selected}} on{{end}}" data-cad="{{.Value}}">{{.Value}}</button>{{end}}
</div>
</span>
</div>
<span class="sw-input" id="sw-cron-wrap"{{if not .Custom}} hidden{{end}}><input class="mono" type="text" name="cron" value="{{.Cron}}" placeholder="0 8 * * 1" spellcheck="false" aria-label="Cron expression" id="sw-cron"></span>
{{end}}
{{if eq .Step 2}}
<div>
<span class="sw-flabel">Destination</span>
<input type="hidden" name="channel" value="{{.ChannelID}}" id="sw-channel">
<span class="sw-listbox">
<button type="button" class="trig" id="sw-ch-btn" aria-haspopup="listbox" aria-expanded="false"><span class="cv">{{.ChannelLabel}}</span><svg class="chev" viewBox="0 0 16 16" width="14" height="14"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
<div class="panel" id="sw-ch-panel" hidden>
{{range .Channels}}<button type="button" class="opt{{if .Selected}} on{{end}}" data-ch="{{.Value}}" data-label="{{.Label}}">{{.Label}}{{if .Hint}}<span class="hint">{{.Hint}}</span>{{end}}</button>{{end}}
</div>
</span>
</div>
<p class="sw-help">A channel receives a link-only ready-message — the report body never leaves the instance. Channels are declared in Settings → Channels.</p>
{{end}}
{{if eq .Step 3}}
<div class="sw-kv">
{{range .Review}}<div class="cell"><span class="k">{{.K}}</span><span class="v">{{.V}}</span></div>{{end}}
</div>
{{end}}
</div>
<div class="sw-foot">
<span class="sw-count">{{.StepNum}} / {{.StepTotal}}</span>
<a class="sw-btn ghost" href="/reports">Cancel</a>
{{if gt .Step 0}}<button type="submit" class="sw-btn sec" name="action" value="back" formnovalidate>Back</button>{{end}}
{{if .Last}}<button type="submit" class="sw-btn pri" name="action" value="finish" id="sw-next">{{.FinishLabel}}</button>{{else}}<button type="submit" class="sw-btn pri" name="action" value="next" id="sw-next">Next</button>{{end}}
</div>
</form>
</section>
</main>
<script>
(function(){
  var next=document.getElementById("sw-next");
  function gate(){
    if(!next)return;
    var ok=true;
    var req=document.querySelector("[data-sw-req]");
    if(req&&!req.value.trim())ok=false;
    var secs=document.querySelectorAll("[data-sw-sec]");
    if(secs.length){var any=false;[].forEach.call(secs,function(c){if(c.checked)any=true;});if(!any)ok=false;}
    var cad=document.getElementById("sw-cad"),cron=document.getElementById("sw-cron");
    if(cad&&cad.value==="Custom…"&&cron&&!cron.value.trim())ok=false;
    if(ok)next.removeAttribute("disabled");else next.setAttribute("disabled","");
  }
  gate();
  document.addEventListener("input",gate);
  document.addEventListener("change",gate);
  function listbox(btnId,panelId,hidId,onPick){
    var b=document.getElementById(btnId),p=document.getElementById(panelId),h=document.getElementById(hidId);
    if(!b||!p||!h)return;
    b.addEventListener("click",function(e){e.stopPropagation();var open=p.hasAttribute("hidden");if(open)p.removeAttribute("hidden");else p.setAttribute("hidden","");b.setAttribute("aria-expanded",open?"true":"false");});
    document.addEventListener("mousedown",function(e){if(!p.hasAttribute("hidden")&&!p.contains(e.target)&&!b.contains(e.target)){p.setAttribute("hidden","");b.setAttribute("aria-expanded","false");}});
    [].forEach.call(p.querySelectorAll(".opt"),function(o){
      o.addEventListener("click",function(){
        onPick(o,h,b);
        [].forEach.call(p.querySelectorAll(".opt"),function(x){x.classList.toggle("on",x===o);});
        p.setAttribute("hidden","");b.setAttribute("aria-expanded","false");gate();
      });
    });
  }
  listbox("sw-cad-btn","sw-cad-panel","sw-cad",function(o,h,b){
    h.value=o.getAttribute("data-cad");
    b.querySelector(".cv").textContent=h.value;
    var w=document.getElementById("sw-cron-wrap");
    if(w){if(h.value==="Custom…")w.removeAttribute("hidden");else w.setAttribute("hidden","");}
  });
  listbox("sw-ch-btn","sw-ch-panel","sw-channel",function(o,h,b){
    h.value=o.getAttribute("data-ch");
    b.querySelector(".cv").textContent=o.getAttribute("data-label");
  });
  document.addEventListener("keydown",function(e){
    if(e.key!=="Escape")return;
    [].forEach.call(document.querySelectorAll(".sw-listbox .panel"),function(p){p.setAttribute("hidden","");});
    [].forEach.call(document.querySelectorAll(".sw-listbox .trig"),function(t){t.setAttribute("aria-expanded","false");});
  });
})();
</script>
{{template "foot" .}}{{end}}
