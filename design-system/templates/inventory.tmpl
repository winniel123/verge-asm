
{{define "inventory"}}{{template "head" .}}
{{template "chrome" .}}
<style>
/* inventory.tmpl scoped styles — exact values from the design system components */
.inv-main { max-width: 1440px; width: 100%; margin: 0 auto; padding: 32px; display: flex; flex-direction: column; gap: 20px; }
.inv-head { display: flex; align-items: flex-start; gap: 16px; }
.inv-head h1 { margin: 0; font: 600 21px var(--font-ui); letter-spacing: var(--heading-tracking); color: var(--text-ink); }
.inv-sub { font: 400 12.5px var(--font-ui); color: var(--text-muted); }
.inv-actions { margin-left: auto; display: flex; gap: 8px; }
.inv-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 36px; padding: 0 16px; border-radius: 12px; font: 600 13px var(--font-ui); cursor: pointer; white-space: nowrap; transition: background var(--dur-fast) var(--ease-out); box-shadow: none; text-decoration: none; }
.inv-btn:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus-ring); }
.inv-btn.primary { background: var(--accent); color: var(--on-accent); border: 1px solid transparent; }
.inv-btn.primary:hover { background: var(--accent-hover); }
.inv-btn.primary:active { background: var(--accent-active); }
.inv-btn.secondary { background: var(--surface); color: var(--text-body); border: 1px solid var(--border-strong); }
.inv-btn.secondary:hover { background: var(--surface-sunken); }
.inv-btn.sm { height: 30px; padding: 0 12px; border-radius: 10px; font-size: 12px; gap: 6px; }
.inv-btn[disabled] { opacity: 0.45; cursor: default; }
.inv-intro { margin: 0; max-width: 82ch; font: 400 13px/1.6 var(--font-ui); color: var(--text-secondary); }
.inv-toolbar { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; position: sticky; top: 0; z-index: 6; padding: 12px 0; background: color-mix(in srgb, var(--bg-page) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--row-sep); }
.inv-seg { display: inline-flex; gap: 2px; padding: 2px; background: var(--surface-sunken); border: 1px solid var(--border-default); border-radius: 10px; }
.inv-seg button { height: 22px; padding: 0 10px; display: inline-flex; align-items: center; gap: 6px; background: transparent; color: var(--text-secondary); border: none; border-radius: 8px; cursor: pointer; font: 500 12px var(--font-ui); white-space: nowrap; transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
.inv-seg button[aria-checked="true"] { background: var(--surface); color: var(--text-ink); font-weight: 600; box-shadow: var(--shadow-xs); }
.inv-switch { display: inline-flex; gap: 10px; align-items: center; cursor: pointer; font-family: var(--font-ui); }
.inv-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.inv-switch .track { width: 36px; height: 20px; flex: none; border-radius: 999px; position: relative; background: var(--neutral-300); transition: background var(--dur-base) var(--ease-out); }
.inv-switch input:checked + .track { background: var(--accent); }
.inv-switch input:focus-visible + .track { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus-ring); }
.inv-switch .knob { position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 999px; background: #ffffff; box-shadow: 0 1px 2px rgba(35,31,25,0.2); transition: left var(--dur-base) var(--ease-out); }
.inv-switch input:checked + .track .knob { left: 18px; }
.inv-switch .lbl { font-size: 13px; color: var(--text-body); }
.inv-filter { display: flex; align-items: center; gap: 8px; height: 36px; width: 230px; padding: 0 12px; background: var(--surface); border: 1px solid var(--border-default); border-radius: 12px; transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
.inv-filter:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 18%, transparent); }
.inv-filter input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; color: var(--text-ink); font: 400 13px var(--font-ui); }
.inv-filter input::placeholder { color: var(--text-muted); }
.inv-right { margin-left: auto; display: inline-flex; gap: 8px; align-items: center; }
.inv-pop { position: relative; display: inline-flex; }
.inv-pop-panel { position: absolute; z-index: 95; top: 100%; margin-top: 6px; right: 0; width: 210px; background: var(--surface-raised); border: 1px solid var(--border-default); border-radius: 12px; box-shadow: var(--shadow-md); padding: 14px; animation: vg-pop-in var(--dur-base) var(--ease-out); font-family: var(--font-ui); display: flex; flex-direction: column; gap: 2px; }
.inv-pop-panel[hidden] { display: none; }
.inv-check { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; padding: 5px 4px; border-radius: 8px; font-family: var(--font-ui); }
.inv-check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.inv-check .box { width: 18px; height: 18px; flex: none; margin-top: 1px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; background: var(--surface); border: 1px solid var(--border-strong); transition: background var(--dur-fast) var(--ease-out); }
.inv-check input:checked + .box { background: var(--accent); border-color: var(--accent); }
.inv-check input:focus-visible + .box { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus-ring); }
.inv-check .box svg { display: none; }
.inv-check input:checked + .box svg { display: block; }
.inv-check .clbl { font-size: 13px; color: var(--text-body); line-height: 1.4; }
.inv-check[data-locked] { cursor: default; opacity: 0.45; }
.inv-section { display: flex; flex-direction: column; gap: 10px; }
.inv-grouplabel { font: 500 10.5px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
.inv-grouphead { display: flex; align-items: baseline; gap: 8px; position: sticky; top: 60px; z-index: 4; padding: 4px 0; background: color-mix(in srgb, var(--bg-page) 92%, transparent); }
.inv-groupcount { font: 400 10.5px var(--font-mono); color: var(--text-muted); }
.inv-showall { align-self: flex-start; padding: 2px 0; background: none; border: none; cursor: pointer; font: 500 12px var(--font-ui); color: var(--link); text-decoration: none; }
.inv-showall:hover { text-decoration: underline; }
.inv-proxybadge { display: inline-flex; align-items: center; height: 18px; padding: 0 7px; border-radius: 999px; background: var(--surface-sunken); border: 1px solid var(--border-default); font: 500 10px var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); }
.inv-main[data-hideproxy="1"] tr[data-proxy="1"] { display: none; }
.inv-card { background: var(--surface); border: 1px solid var(--border-default); border-radius: 16px; box-shadow: var(--shadow-xs); overflow: hidden; }
.inv-table { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
.inv-table th { padding: 8px 16px; font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); border-bottom: 1px solid var(--border-default); white-space: nowrap; background: var(--surface); text-align: left; }
.inv-table td { padding: 7px 16px; font: 400 13px var(--font-ui); color: var(--text-body); vertical-align: middle; white-space: nowrap; overflow: hidden; border-top: 1px solid var(--row-sep); }
.inv-main[data-density="comfortable"] .inv-table td { padding-top: 10px; padding-bottom: 10px; }
.inv-table tbody tr:first-child td { border-top: none; }
.inv-table tbody tr[data-href] { cursor: pointer; transition: background var(--dur-fast) var(--ease-out); }
.inv-table tbody tr[data-href]:hover { background: var(--surface-sunken); }
.inv-table tbody tr:focus-visible { outline: none; box-shadow: inset 0 0 0 1.5px var(--accent); }
.inv-main.hide-type [data-col="type"], .inv-main.hide-holds [data-col="holds"], .inv-main.hide-since [data-col="since"] { display: none; }
.inv-subject { font: 500 12.5px var(--font-mono); color: var(--text-ink); text-decoration: none; }
a.inv-subject { color: var(--link); }
.inv-type { width: 110px; }
.inv-tag { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 8px; background: var(--surface-sunken); border: 1px solid var(--border-default); color: var(--text-secondary); font: 400 11.5px var(--font-mono); white-space: nowrap; }
.inv-holds { display: flex; flex-direction: column; gap: 4px; }
.inv-facet { display: flex; gap: 10px; align-items: baseline; }
.inv-facetlabel { font: 500 10.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); min-width: 168px; white-space: nowrap; }
.inv-exp { display: inline-flex; align-items: center; gap: 5px; background: none; border: none; padding: 0; cursor: pointer; font: inherit; }
.inv-exp:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus-ring); border-radius: 8px; }
.inv-exp svg { color: var(--text-muted); transition: transform var(--dur-fast) var(--ease-out); }
.inv-exp[aria-expanded="true"] svg { transform: rotate(180deg); }
.inv-records { display: grid; grid-template-rows: 0fr; opacity: 0; margin-top: 0; transition: grid-template-rows var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out), margin-top var(--dur-base) var(--ease-out); }
.inv-records.open { grid-template-rows: 1fr; opacity: 1; margin-top: 4px; }
.inv-records .rin { min-height: 0; overflow: hidden; display: flex; flex-direction: column; gap: 3px; padding-left: 2px; }
.inv-none { font: 400 11.5px var(--font-mono); color: var(--text-muted); }
.inv-record { display: grid; grid-template-columns: 56px 1fr; gap: 8px; align-items: baseline; }
.inv-rectype { font: 500 10px var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
.inv-recdata { font: 400 12px var(--font-mono); color: var(--text-body); white-space: normal; overflow-wrap: anywhere; }
.inv-gapbadge { display: inline-flex; align-items: center; gap: 4px; height: 18px; padding: 0 6px; border-radius: 8px; background: transparent; border: 1px dotted var(--border-strong); color: var(--text-secondary); font: 600 10px var(--font-mono); letter-spacing: 0.04em; white-space: nowrap; }
.inv-gapsince { font: 400 11px var(--font-mono); color: var(--text-muted); }
.inv-since { text-align: right; width: 112px; font: 400 12.5px var(--font-mono); color: var(--text-muted); white-space: nowrap; }
.inv-empty { display: none; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 48px 24px; font-family: var(--font-ui); }
.inv-main[data-empty="1"] .inv-empty { display: flex; }
.inv-main[data-empty="1"] .inv-section { display: none; }
.inv-empty .ico { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 999px; background: var(--accent-softer); border: 1px solid var(--accent-soft); color: var(--accent); margin-bottom: 8px; }
.inv-empty .msg { font: 600 14px var(--font-ui); color: var(--text-ink); }
.inv-empty .det { font: 400 13px/1.5 var(--font-ui); color: var(--text-secondary); max-width: 380px; }
.inv-empty .act { margin-top: 14px; }
</style>
<main class="inv-main" id="inv" data-density="compact" data-screen-label="Inventory">
<div class="inv-head">
<div style="display:flex;flex-direction:column;gap:2px">
<h1>Inventory</h1>
<span class="inv-sub">Everything you expose, watched for drift — the actual values behind the verdicts.</span>
</div>
<div class="inv-actions">
{{if .HasData}}<a class="inv-btn secondary" href="/inventory/export" title="Download the folded inventory as CSV"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>Export CSV</a>
{{else}}<button class="inv-btn secondary" disabled title="Nothing to export until a value is folded"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>Export CSV</button>{{end}}
<a class="inv-btn primary" href="/scope"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Add seed</a>
</div>
</div>
<p class="inv-intro">What your estate holds right now — the addresses a name resolves to, the records it carries, the certificate a service presents, the identity an endpoint returns. Each row is a subject; open it for its full record, or expand a value to its individual records. A withdrawn subject holds no current span and so is not here. There is no total: your estate’s completeness is yours alone to state.</p>
<div class="inv-toolbar">
<div class="inv-seg" role="radiogroup" aria-label="Kind" id="inv-kind">
<button type="button" role="radio" aria-checked="true" data-kind="all">All subjects</button>
<button type="button" role="radio" aria-checked="false" data-kind="name">Names</button>
<button type="button" role="radio" aria-checked="false" data-kind="service">Services</button>
<button type="button" role="radio" aria-checked="false" data-kind="endpoint">Endpoints</button>
<button type="button" role="radio" aria-checked="false" data-kind="address">Addresses</button>
</div>
<label class="inv-switch"><input type="checkbox" role="switch" id="inv-gaps"><span class="track" aria-hidden="true"><span class="knob"></span></span><span class="lbl">Gaps only</span></label>
<label class="inv-switch" title="Provider-fronted (blanket-responder) spans are shown by default, demoted below real values"><input type="checkbox" role="switch" id="inv-proxy"><span class="track" aria-hidden="true"><span class="knob"></span></span><span class="lbl">Hide proxy edge</span></label>
<span class="inv-filter"><input type="text" id="inv-q" placeholder="Filter subjects…" autocomplete="off"></span>
<span class="inv-right">
<div class="inv-seg" role="radiogroup" aria-label="Row density" id="inv-dens">
<button type="button" role="radio" aria-checked="false" data-density="comfortable">Comfortable</button>
<button type="button" role="radio" aria-checked="true" data-density="compact">Compact</button>
</div>
<span class="inv-pop">
<button type="button" class="inv-btn secondary sm" id="inv-cols-btn" aria-expanded="false"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path><path d="M15 3v18"></path></svg>Columns</button>
<div class="inv-pop-panel" id="inv-cols" hidden>
<label class="inv-check" data-locked><input type="checkbox" checked disabled><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="clbl">Subject</span></label>
<label class="inv-check"><input type="checkbox" checked data-col-toggle="type"><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="clbl">Type</span></label>
<label class="inv-check"><input type="checkbox" checked data-col-toggle="holds"><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="clbl">Holds</span></label>
<label class="inv-check"><input type="checkbox" checked data-col-toggle="since"><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="clbl">Since</span></label>
</div>
</span>
</span>
</div>
{{range .Groups}}
<section class="inv-section" data-kind="{{.Kind}}" id="{{.Kind}}">
<div class="inv-grouphead"><span class="inv-grouplabel">{{.Label}}</span><span class="inv-groupcount">{{.Total}}</span></div>
<div class="inv-card">
<table class="inv-table">
<thead><tr><th style="width:300px">Subject</th><th data-col="type" style="width:110px">Type</th><th data-col="holds">Holds</th><th data-col="since" style="width:112px;text-align:right">Since</th></tr></thead>
<tbody>
{{range .Subjects}}<tr data-key="{{.Key}}"{{if .ProxyEdge}} data-proxy="1"{{end}}{{if .Link}} data-href="{{.Link}}" tabindex="0" role="link" aria-label="Open {{.Key}}"{{end}}>
<td>{{if .Link}}<a class="inv-subject" href="{{.Link}}">{{.Key}}</a>{{else}}<span class="inv-subject">{{.Key}}</span>{{end}}</td>
<td data-col="type" class="inv-type"><span class="inv-tag">{{.Type}}</span></td>
<td data-col="holds"><div class="inv-holds">
{{range .Facets}}<div class="inv-facet">
<span class="inv-facetlabel">{{.Label}}</span>
{{if .IsGap}}<span style="display:inline-flex;gap:8px;align-items:baseline"><span class="inv-gapbadge"><svg viewBox="0 0 10 10" width="9" height="9" style="flex:none"><rect x="1.6" y="1.6" width="6.8" height="6.8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.6 1.6"></rect></svg>gap</span>{{if .ProxyEdge}}<span class="inv-proxybadge">proxy edge</span>{{end}}<span class="inv-gapsince">since {{.Since}}</span></span>
{{else if .Details}}<span style="display:flex;flex-direction:column"><button type="button" class="inv-exp" aria-expanded="false"><span class="inv-tag">{{.Summary}}</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></button>
<span class="inv-records"><span class="rin">{{range .Details}}<span class="inv-record"><span class="inv-rectype">{{.Type}}</span><span class="inv-recdata">{{.Data}}</span></span>{{end}}</span></span></span>
{{else if .Summary}}<span class="inv-tag">{{.Summary}}</span>{{else}}<span class="inv-none">none</span>{{end}}
</div>{{end}}
</div></td>
<td data-col="since" class="inv-since">{{with index .Facets 0}}{{.Since}}{{end}}</td>
</tr>{{end}}
</tbody>
</table>
</div>
{{if .More}}<a class="inv-showall" href="{{.ShowAllHref}}">Show all {{.Total}} — {{.More}} more</a>{{end}}
</section>
{{end}}
<div class="inv-empty">
<span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></span>
<span class="msg">No subjects match this scope.</span>
<span class="det">The corpus is unaffected — only the view is scoped.</span>
<span class="act"><button type="button" class="inv-btn secondary" id="inv-clear">Clear filters</button></span>
</div>
{{if not .Groups}}
<div class="inv-empty" style="display:flex">
<span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></span>
<span class="msg">No population measured yet</span>
<span class="det">No subject holds an open span yet. Declare a scope on Scope and let a Scan measure a value; the inventory fills as facets are folded.</span>
</div>
{{end}}
<script>
(function () {
  var main = document.getElementById("inv");
  if (!main) return;
  var state = { kind: "all", gaps: false, q: "" };
  main.setAttribute("data-hideproxy", "0");
  var rows = Array.prototype.slice.call(main.querySelectorAll("tbody tr"));
  rows.forEach(function (tr) { if (tr.querySelector(".inv-gapbadge")) tr.setAttribute("data-gap", "1"); });
  function apply() {
    var any = false;
    Array.prototype.forEach.call(main.querySelectorAll(".inv-section"), function (sec) {
      var kindOk = state.kind === "all" || sec.getAttribute("data-kind") === state.kind;
      var vis = 0;
      Array.prototype.forEach.call(sec.querySelectorAll("tbody tr"), function (tr) {
        var ok = kindOk && (!state.gaps || tr.hasAttribute("data-gap")) &&
          !(main.getAttribute("data-hideproxy") === "1" && tr.getAttribute("data-proxy") === "1") &&
          (!state.q || (tr.getAttribute("data-key") || "").toLowerCase().indexOf(state.q) !== -1);
        tr.style.display = ok ? "" : "none";
        if (ok) vis++;
      });
      sec.style.display = vis ? "" : "none";
      if (vis) any = true;
    });
    main.setAttribute("data-empty", any ? "0" : "1");
  }
  document.getElementById("inv-kind").addEventListener("click", function (e) {
    var b = e.target.closest("button[data-kind]"); if (!b) return;
    state.kind = b.getAttribute("data-kind");
    Array.prototype.forEach.call(this.querySelectorAll("button"), function (x) { x.setAttribute("aria-checked", x === b ? "true" : "false"); });
    apply();
  });
  document.getElementById("inv-gaps").addEventListener("change", function () { state.gaps = this.checked; apply(); });
  document.getElementById("inv-proxy").addEventListener("change", function () { main.setAttribute("data-hideproxy", this.checked ? "1" : "0"); apply(); });
  document.getElementById("inv-q").addEventListener("input", function () { state.q = this.value.trim().toLowerCase(); apply(); });
  var clear = document.getElementById("inv-clear");
  if (clear) clear.addEventListener("click", function () {
    state = { kind: "all", gaps: false, q: "" };
    document.getElementById("inv-q").value = "";
    document.getElementById("inv-gaps").checked = false;
    var pf = document.getElementById("inv-proxy"); if (pf) pf.checked = false;
    main.setAttribute("data-hideproxy", "0");
    var kb = document.getElementById("inv-kind");
    Array.prototype.forEach.call(kb.querySelectorAll("button"), function (x) { x.setAttribute("aria-checked", x.getAttribute("data-kind") === "all" ? "true" : "false"); });
    apply();
  });
  document.getElementById("inv-dens").addEventListener("click", function (e) {
    var b = e.target.closest("button[data-density]"); if (!b) return;
    main.setAttribute("data-density", b.getAttribute("data-density"));
    Array.prototype.forEach.call(this.querySelectorAll("button"), function (x) { x.setAttribute("aria-checked", x === b ? "true" : "false"); });
  });
  var colsBtn = document.getElementById("inv-cols-btn"), colsPanel = document.getElementById("inv-cols");
  colsBtn.addEventListener("click", function () {
    var open = colsPanel.hasAttribute("hidden");
    if (open) colsPanel.removeAttribute("hidden"); else colsPanel.setAttribute("hidden", "");
    colsBtn.setAttribute("aria-expanded", open ? "true" : "false");
  });
  document.addEventListener("mousedown", function (e) {
    if (!colsPanel.hasAttribute("hidden") && !e.target.closest(".inv-pop")) { colsPanel.setAttribute("hidden", ""); colsBtn.setAttribute("aria-expanded", "false"); }
  });
  Array.prototype.forEach.call(main.querySelectorAll("[data-col-toggle]"), function (cb) {
    cb.addEventListener("change", function () { main.classList.toggle("hide-" + cb.getAttribute("data-col-toggle"), !cb.checked); });
  });
  Array.prototype.forEach.call(main.querySelectorAll(".inv-exp"), function (btn) {
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var rec = btn.parentNode.querySelector(".inv-records");
      var open = !rec.classList.contains("open");
      rec.classList.toggle("open", open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
  });
  function go(tr) { var h = tr.getAttribute("data-href"); if (h) window.location.assign(h); }
  rows.forEach(function (tr) {
    if (!tr.hasAttribute("data-href")) return;
    tr.addEventListener("click", function (e) { if (e.target.closest("button, a")) return; go(tr); });
    tr.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); go(tr); } });
  });
  document.addEventListener("keydown", function (e) {
    var pal = document.getElementById("cmdk");
    if (pal && !pal.hasAttribute("hidden")) return;
    var t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    var nav = rows.filter(function (tr) { return tr.hasAttribute("data-href") && tr.style.display !== "none" && tr.closest(".inv-section").style.display !== "none"; });
    if (!nav.length) return;
    var i = nav.indexOf(document.activeElement);
    if (e.key === "j" || e.key === "ArrowDown") { e.preventDefault(); nav[i < 0 ? 0 : Math.min(i + 1, nav.length - 1)].focus(); }
    else if (e.key === "k" || e.key === "ArrowUp") { e.preventDefault(); nav[i < 0 ? nav.length - 1 : Math.max(i - 1, 0)].focus(); }
  });
})();
</script>
</main>
{{template "foot" .}}{{end}}

{{define "recordrows"}}<table class="records"><tbody>
{{range .}}<tr>{{if .Type}}<td class="rrtype"><span class="badge">{{.Type}}</span></td>{{else}}<td class="rrtype"></td>{{end}}<td class="mono">{{.Data}}</td></tr>{{end}}
</tbody></table>{{end}}

{{define "subject-missing"}}{{template "head" .}}
{{template "chrome" .}}
<main>
<div class="microlabel">No such subject</div>
<h1 class="mono">{{.Name}}</h1>
<div class="section">
<p>No subject is keyed under that name. Nothing has ever measured it into the
estate — this is not a withdrawn subject, which would still be reachable here by
its own key.</p>
<p><a href="/inventory">Back to inventory</a></p>
</div>
</main>
{{template "foot" .}}{{end}}
