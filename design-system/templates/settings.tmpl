.st-drawer { position: fixed; top: 0; bottom: 0; right: 0; z-index: 101; width: min(430px, 92%); background: var(--surface); border-left: 1px solid var(--border-default); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; animation: st-slide var(--dur-slow) var(--ease-out); }
.st-drawer .dh { display: flex; align-items: flex-start; gap: 12px; padding: 20px 24px 0; flex: none; }
.st-drawer .dh h2 { margin: 0; font: 600 16px var(--font-ui); letter-spacing: var(--heading-tracking); color: var(--text-ink); }
.st-drawer .db { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 24px 24px; display: flex; flex-direction: column; gap: 18px; }
.st-drawer .df { flex: none; display: flex; gap: 8px; padding: 14px 24px; border-top: 1px solid var(--row-sep); background: var(--surface); }
.st-x { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 10px; background: transparent; color: var(--text-secondary); border: 1px solid transparent; cursor: pointer; text-decoration: none; margin-left: auto; flex: none; transition: background var(--dur-fast) var(--ease-out); }
.st-x:hover { background: var(--surface-sunken); color: var(--text-body); }
.st-grant { display: flex; gap: 10px; align-items: flex-start; }
.st-grant .gic { display: inline-flex; color: var(--text-muted); flex: none; margin-top: 2px; }
.st-grant .gt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.st-grant .g1 { font: 500 12.5px var(--font-ui); color: var(--text-ink); display: inline-flex; align-items: center; gap: 8px; }
.st-grant .g2 { font: 400 12px/1.5 var(--font-ui); color: var(--text-secondary); }
.st-msg { display: flex; flex-direction: column; gap: 8px; padding: 14px 2px; }
.st-msg + .st-msg { border-top: 1px solid var(--row-sep); }
.st-msg .mh { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.st-msg .cause { font: 600 12px var(--font-mono); color: var(--text-ink); }
.st-msg .when { margin-left: auto; font: 400 11px var(--font-mono); color: var(--text-muted); }
.st-msg .hl { margin: 0; font: 400 13px/1.55 var(--font-ui); color: var(--text-body); }
.st-msg.unread .hl { font-weight: 500; }
.st-census { display: flex; flex-direction: column; background: var(--surface-sunken); border-radius: 12px; padding: 6px 14px; }
.st-census .crow { display: flex; align-items: center; gap: 12px; padding: 8px 0; }
.st-census .crow + .crow { border-top: 1px solid var(--row-sep); }
.st-census .k { width: 88px; flex: none; font: 500 11px var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-muted); }
.st-census .v { font: 500 12.5px var(--font-mono); color: var(--text-ink); overflow-wrap: anywhere; }
.st-census a.v { color: var(--link); text-decoration: none; }
.st-census a.v:hover { text-decoration: underline; }
.st-delrow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font: 400 12.5px var(--font-ui); color: var(--text-secondary); }
.st-delrow .host { font: 400 12px var(--font-mono); color: var(--text-body); }
.st-delrow .why { border-bottom: 1px dashed var(--border-strong); cursor: default; color: var(--text-muted); }
</style>
