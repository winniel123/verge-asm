<script>
(function(){
  [].forEach.call(document.querySelectorAll("[data-st-menu]"),function(b){
    var p=b.parentNode.querySelector(".st-panel");
    if(!p)return;
    b.addEventListener("click",function(e){e.stopPropagation();var open=p.hasAttribute("hidden");if(open)p.removeAttribute("hidden");else p.setAttribute("hidden","");b.setAttribute("aria-expanded",open?"true":"false");});
    document.addEventListener("mousedown",function(e){if(!p.hasAttribute("hidden")&&!p.contains(e.target)&&!b.contains(e.target)){p.setAttribute("hidden","");b.setAttribute("aria-expanded","false");}});
  });
  [].forEach.call(document.querySelectorAll("[data-st-copy]"),function(b){
    b.addEventListener("click",function(){
      var sel=b.getAttribute("data-st-copy"),src=sel?document.querySelector(sel):null;
      var v=src?src.textContent:(b.getAttribute("data-st-copy-text")||"");
      if(navigator.clipboard&&window.isSecureContext)navigator.clipboard.writeText(v);else{var ta=document.createElement("textarea");ta.value=v;ta.style.position="fixed";ta.style.opacity="0";document.body.appendChild(ta);ta.select();try{document.execCommand("copy");}catch(err){}document.body.removeChild(ta);}
      b.classList.add("ok");var t=b.textContent;b.textContent="copied";setTimeout(function(){b.classList.remove("ok");b.textContent=t;},1600);
    });
  });
  [].forEach.call(document.querySelectorAll("input[data-typed-confirm]"),function(inp){
    var btn=inp.form&&inp.form.querySelector('button[type="submit"]');
    if(!btn)return;
    inp.addEventListener("input",function(){btn.disabled=inp.value.trim()!==inp.getAttribute("data-typed-confirm");});
  });
  var tn=document.getElementById("st-typed-name");
  if(tn){var ti=document.querySelector(".st-dialog input.typed"),ts=document.querySelector("[data-st-typed-submit]");
    if(ti&&ts){ti.addEventListener("input",function(){if(ti.value===tn.textContent)ts.removeAttribute("disabled");else ts.setAttribute("disabled","");});ti.focus();}}
  // The consent submit ships ENABLED and is disabled here on load, never in the markup
  // (ADR-0130 ticket #975, the ruling #971 made for the /signals declare button). The
  // acceptance box is the `accept_terms` carrier the handler reads, so with JavaScript
  // off the operator can still tick it and submit, and an unticked submit is refused by
  // settingsSources rather than silently enabling the source.
  var cc=document.getElementById("st-consent-check"),cs=document.querySelector("[data-st-consent-submit]");
  if(cc&&cs){
    var csSync=function(){if(cc.checked)cs.removeAttribute("disabled");else cs.setAttribute("disabled","");};
    cc.addEventListener("change",csSync);csSync();
  }
  var rs=document.getElementById("st-role-select");
  if(rs){var rb=document.getElementById("st-role-save");
    rs.addEventListener("change",function(){if(rs.value===rs.getAttribute("data-current"))rb.setAttribute("disabled","");else rb.removeAttribute("disabled");});}
  document.addEventListener("keydown",function(e){
    if(e.key!=="Escape")return;
    var open=false;
    [].forEach.call(document.querySelectorAll(".st-panel"),function(p){if(!p.hasAttribute("hidden")){p.setAttribute("hidden","");open=true;}});
    if(open)return;
    var sc=document.querySelector(".st-scrim");
    if(sc)window.location=sc.getAttribute("href");
  });
})();
</script>
{{template "foot" .}}{{end}}

{{/* scans — holes: .Active[{ID,Href,ScanKind,DispatchedAt,Completed,Live,Percent,Rollup{Ready,Running,Done,Dead,Total}}] .StopTarget{ID,ScanKind,Pending,Running} (nullable) .TerminateTarget{ID,ScanKind,Running} (nullable) .History[{Href (nullable),ScanKind,DispatchedAt,Live,Completed,Dead}] .Truncated .HistoryLimit .ColdEnabled .ColdError .ColdScopes[{ID,Scope,IsAddress,OptedIn}] .IsAdmin — calls repo "scantrigger". */}}
{{define "settings-scans"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Scanning · scans</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Scans</h2>
<p class="st-lede">What the queue is doing right now. A scan runs as a fan-out of jobs — one per vantage, or per supplied zone file — and each job commits its own batch of observations. This is a read of the queue alone: it records what the system did, never what is true of your estate. Scans run on their own cadence; an admin may also dispatch an enabled one on demand.</p>
</header>
{{template "scantrigger" .}}
<section class="st-card{{if .Active}} flush{{end}}">
<div class="st-cardhead"{{if .Active}} style="padding-bottom:14px"{{end}}><div class="hd"><span class="st-micro">In flight</span><h3>Running now</h3></div></div>
{{if .Active}}
{{range .Active}}
<div style="padding:0 20px 16px;display:flex;flex-direction:column;gap:10px">
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
<span class="st-dotlive"></span>
<a href="{{.Href}}" style="font:600 12.5px var(--font-mono);color:var(--link);text-decoration:none">{{.ScanKind}}</a>
<span style="font:400 11.5px var(--font-mono);color:var(--text-muted)">dispatched {{.DispatchedAt}}</span>
<span style="margin-left:auto;font:400 11.5px var(--font-mono);color:var(--text-secondary)">{{.Completed}} / {{.Live}} jobs · {{.Percent}}%</span>
{{if $.IsAdmin}}<a class="st-btn-sm" href="/settings?tab=scans&amp;stop={{.ID}}">Stop dispatch</a><a class="st-btn-sm" style="color:var(--danger)" href="/settings?tab=scans&amp;terminate={{.ID}}">Terminate</a>{{end}}
</div>
<div class="st-meter"><span class="fill" style="width:{{.Percent}}%"></span></div>
<div class="st-rollup">
<span class="st-badge accent"><span class="d"></span><span class="n">{{.Rollup.Running}}</span>running</span>
{{if gt .Rollup.Ready 0}}<span class="st-badge neutral"><span class="d"></span><span class="n">{{.Rollup.Ready}}</span>ready</span>{{end}}
<span class="st-badge ok"><span class="d"></span><span class="n">{{.Rollup.Done}}</span>done</span>
{{if gt .Rollup.Dead 0}}<span class="st-badge danger"><span class="d"></span><span class="n">{{.Rollup.Dead}}</span>dead</span>{{end}}
<a class="st-btn-sm" style="margin-left:auto" href="{{.Href}}">View all {{.Rollup.Total}} jobs</a>
</div>
</div>
{{end}}
{{else}}
<div class="st-body"><div class="st-empty" style="padding:24px 12px">
<span class="msg">No scan running</span>
<span class="det">Nothing is dispatched right now. When a scan's cadence comes due the worker fans it out, and it appears here with its progress while it runs. This view refreshes on its own while a scan is in flight.</span>
</div></div>
{{end}}
</section>
<section class="st-card{{if .History}} flush{{end}}">
<div class="st-cardhead"{{if .History}} style="padding-bottom:14px"{{end}}><div class="hd"><span class="st-micro">Batches</span><h3>Recent dispatches</h3></div></div>
{{if .History}}
<table class="st-table">
<thead><tr><th style="width:40px"></th><th>Scan</th><th style="width:180px">Dispatched</th><th style="width:70px">Jobs</th><th style="width:100px">Completed</th><th style="width:70px;text-align:right">Dead</th></tr></thead>
<tbody>
{{range .History}}<tr>
<td><span class="st-dot{{if gt .Dead 0}} dead{{else}} done{{end}}"></span></td>
<td class="mono">{{if .Href}}<a href="{{.Href}}" style="color:var(--link);text-decoration:none">{{.ScanKind}}</a>{{else}}{{.ScanKind}}{{end}}</td>
<td class="mono">{{.DispatchedAt}}</td>
<td class="mono">{{.Live}}</td>
<td class="mono">{{.Completed}}</td>
<td class="mono" style="text-align:right">{{if gt .Dead 0}}{{.Dead}}{{else}}<span style="color:var(--text-muted)">0</span>{{end}}</td>
</tr>{{end}}
</tbody>
</table>
{{if .Truncated}}<div style="padding:14px 20px 16px"><div class="st-callout"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span>
<span class="ct"><span>Showing the {{.HistoryLimit}} most recent dispatches.</span></span></div></div>{{end}}
{{else}}
<div class="st-body"><div class="st-empty" style="padding:24px 12px">
<span class="msg">No dispatches yet</span>
<span class="det">No scan has been dispatched. Once a scan runs — on its cadence, or on the first batch after onboarding — its completed dispatches are listed here.</span>
</div></div>
{{end}}
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Configured · full-range scan</span><h3>Cold tier</h3></div><span style="margin-left:auto">{{if .ColdEnabled}}<span class="st-badge ok"><span class="d"></span>tier on</span>{{else}}<span class="st-badge neutral">tier off — no scope opted in</span>{{end}}</span></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:14px">
<p class="st-lede" style="max-width:none">The cold scan connects to every TCP port, 1–65535, monthly. It ships <strong>disabled</strong> with no scopes: a full-range sweep runs only where you ask for it, per scope — never at onboarding, never on save. Opting a scope in enables the tier for that scope on its own monthly cadence; opting the last scope out returns it to off. Only Custody-admitted addresses are ever probed, so opting in widens what is measured, never who.</p>
{{if .ColdError}}<div class="st-error">{{.ColdError}}</div>{{end}}
{{if .ColdScopes}}
<div style="display:flex;flex-direction:column;gap:8px">
{{range .ColdScopes}}
<div class="st-row">
<span style="font:500 12px var(--font-mono);color:var(--text-ink)">{{.Scope}}</span>
<span class="st-tag">{{if .IsAddress}}address{{else}}name{{end}}</span>
<span style="margin-left:auto;display:inline-flex;align-items:center;gap:10px">
{{if .OptedIn}}<span class="st-badge ok"><span class="d"></span>opted in</span>{{else}}<span class="st-badge neutral">off</span>{{end}}
{{if $.IsAdmin}}<form method="post" action="/settings/cold" style="margin:0"><input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="opt_in" value="{{if .OptedIn}}false{{else}}true{{end}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm">{{if .OptedIn}}Opt out{{else}}Opt in{{end}}</button></form>{{end}}
</span>
</div>
{{end}}
</div>
{{else}}
<span class="st-note">The full-range tier opts in a declared scope. Declare a name or address scope on <a href="/scope">Scope</a>, then opt it into the cold scan here.</span>
{{end}}
</div>
</div>
</section>
{{with .CapControl}}
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Configured · address-scope cap</span><h3>Address-scope cap</h3></div><span style="margin-left:auto"><span class="st-badge neutral">{{.CapLabel}} addresses</span></span></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:14px">
<p class="st-lede" style="max-width:none">The cap bounds how many addresses one address scope may cover, checked when you declare it. Raising it admits a wider blind sweep — the cost is priced here, so the declaration stays a flat confirm. There is no upper limit; you choose the lag you accept when you set the cap, not when you declare.</p>
<div class="st-kv">
<div class="cell"><span class="st-micro">Largest scope</span><span class="v">{{.LargestScopeV4}} IPv4 · {{.LargestScopeV6}} IPv6</span></div>
<div class="cell"><span class="st-micro">Evidential disk</span><span class="v">{{.DiskProjection}}</span></div>
</div>
{{if .SweepLoad}}
<div style="display:flex;flex-direction:column;gap:8px">
<span class="st-micro">Sweep load — a cap-sized scope, per enabled address-scope scan</span>
{{range .SweepLoad}}
<div class="st-row">
<span style="font:500 12px var(--font-mono);color:var(--text-ink)">{{.Scan}}</span>
<span class="st-tag">{{.Cadence}}</span>
<span style="margin-left:auto;font:400 11.5px var(--font-mono);color:var(--text-secondary)">{{.Probes}} probes / cadence</span>
</div>
{{if .Effective}}<span class="st-note">One full pass runs <span class="mono">{{.Effective}}</span> at the 200 pkt/s ceiling{{if .Outpaces}} — longer than its {{.Cadence}} cadence, so the trailing edge lags; Coverage reports the shortfall.{{else}} — inside its {{.Cadence}} cadence.{{end}}</span>{{end}}
{{end}}
</div>
{{else}}
<span class="st-note">No address-scope scan is enabled, so a cap-sized scope dispatches nothing yet. Enable the hot or cold tier to sweep a declared range.</span>
{{end}}
{{if $.CapError}}<div class="st-error">{{$.CapError}}</div>{{end}}
{{if $.IsAdmin}}
<form method="post" action="/settings/address-cap" style="margin:0;display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap">{{template "backfield" $}}
<span class="st-input" style="width:240px"><span class="lb">Address-scope cap</span><span class="iw"><input name="address_cap" inputmode="numeric" value="{{$.CapValue}}" required><span style="font:400 11.5px var(--font-mono);color:var(--text-muted);flex:none">addresses</span></span></span>
<button type="submit" class="st-btn sec">Save cap</button>
</form>
{{else}}
<div class="st-kv">
<div class="cell"><span class="st-micro">Address-scope cap</span><span class="v">{{.CapLabel}} addresses</span></div>
</div>
{{end}}
{{if .UpdatedAt}}<span class="st-note">Last changed {{.UpdatedAt}}{{if .UpdatedBy}} by <span style="font-family:var(--font-mono)">{{.UpdatedBy}}</span>{{end}}.</span>{{end}}
</div>
</div>
</section>
{{end}}
{{with .StopTarget}}
<a class="st-scrim" href="/settings?tab=scans" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Stop dispatch">
<h2>Stop dispatching {{.ScanKind}}</h2>
<p class="detail">{{.Pending}} pending jobs are cancelled. {{.Running}} running jobs finish and commit their batches; nothing already observed is discarded.</p>
<p class="detail" style="color:var(--text-secondary)">The dispatch is recorded as stopped · partial. The scan runs again on its normal cadence.</p>
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=scans">Cancel</a>
<form method="post" action="/scans/stop" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn">Stop dispatch</button></form>
</div>
</div></div>
{{end}}
{{with .TerminateTarget}}
<a class="st-scrim" href="/settings?tab=scans" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Terminate scan">
<h2>Terminate {{.ScanKind}} now</h2>
<p class="detail">{{.Running}} running jobs are stopped where they stand and their uncommitted work discards. Batches already committed stand — observations are append-only.</p>
<p class="detail" style="color:var(--text-secondary)">The dispatch is recorded as terminated. Anything half-measured is simply absent until the next run.</p>
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=scans">Cancel</a>
<form method="post" action="/scans/terminate" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn danger">Terminate</button></form>
</div>
</div></div>
{{end}}
{{end}}

{{/* vantages — holes: .Vantages[{Name,Class,Resolver,Latency,Availability,Unverified}] .Probers[{Endpoint,Username,Availability,HostKeyPinned,HostKeyFingerprint,Platform,KeySet,PublicKey,Egress}] .IsAdmin .ProberError .ProberHost .ProberPort .ProberUser */}}
{{define "settings-vantages"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Scanning · vantages</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Vantages</h2>
<p class="st-lede">The network positions a scan measures from. A vantage carries a verified class — internet or internal — and the recursive resolver it looks through; provisioning one declares it sits on the internet and opens the Reach and Exposure timelines.</p>
</header>
{{if .Vantages}}
<div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:16px">
{{range .Vantages}}
<section class="st-vcard{{if .Unverified}} unv{{end}}">
<div style="display:flex;align-items:center;gap:8px">
<span style="font:600 13px var(--font-mono);color:var(--text-ink);white-space:nowrap;flex:none">{{.Name}}</span>
<span class="st-tag">{{.Class}}</span>
</div>
<div style="display:flex;align-items:center;gap:12px;font:400 11.5px var(--font-mono);color:var(--text-secondary);min-height:20px">
{{if .Resolver}}<span style="flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">resolver {{.Resolver}}</span>{{end}}
{{if .Latency}}<span style="flex:none">{{.Latency}}</span>{{end}}
<span style="margin-left:auto;flex:none"><span class="st-av {{.Availability}}"><span class="d"></span>{{.Availability}}</span></span>
</div>
{{if .Unverified}}<span class="st-note">Unverified — this vantage makes no exposure claims until re-verified.</span>{{end}}
</section>
{{end}}
</div>
{{else}}
<section class="st-card"><div class="st-body"><div class="st-empty">
<span class="msg">No vantage provisioned</span>
<span class="det">Only the shipped resolver position exists, so the Reach and Exposure timelines have not opened. Provision a prober below to measure from the internet.</span>
</div></div></section>
{{end}}
{{if .Probers}}
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Probers</span><h3>Provisioned internet vantages</h3></div></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:16px">
<span class="st-note">The worker owns the keypair and generates it out of band; only the public half is published here — the private half never leaves the instance. A host key is pinned on first connection, and a later change is a hard failure, never a prompt.</span>
{{range $i, $p := .Probers}}
<div style="display:flex;flex-direction:column;gap:12px;{{if $i}}padding-top:16px;border-top:1px solid var(--row-sep){{end}}">
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
<span style="font:600 13px var(--font-mono);color:var(--text-ink)">{{$p.Endpoint}}</span>
<span style="font:400 11.5px var(--font-mono);color:var(--text-muted)">username <span style="color:var(--text-body)">{{$p.Username}}</span></span>
<span style="margin-left:auto"><span class="st-av {{$p.Availability}}"><span class="d"></span>{{$p.Availability}}</span></span>
</div>
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
{{if $p.HostKeyPinned}}<span class="st-badge ok"><span class="d"></span>host key pinned</span>{{if $p.HostKeyFingerprint}}<span style="font:400 11.5px var(--font-mono);color:var(--text-muted)">{{$p.HostKeyFingerprint}}</span>{{end}}{{else}}<span class="st-badge neutral">awaiting first connection</span>{{end}}
{{if $p.Platform}}<span class="st-badge ok"><span class="d"></span>{{$p.Platform}} — accepted</span>{{end}}
</div>
{{if $p.KeySet}}
<span class="st-note">Install the <strong>public</strong> key in <span style="font-family:var(--font-mono);font-size:11.5px;color:var(--text-body)">{{$p.Username}}@{{$p.Endpoint}}</span>'s authorized_keys — the restrict and from= options are already in place.</span>
<div class="st-code">
<div class="ttl">authorized_keys</div>
<pre><code id="st-pub-{{$i}}">{{$p.PublicKey}}</code></pre>
<button type="button" class="cp" data-st-copy="#st-pub-{{$i}}" aria-label="Copy">copy</button>
</div>
{{else}}
<span class="st-note">Public key not set — the worker has not published one yet.</span>
{{end}}
{{if $p.Egress}}
<div class="st-callout accent">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span>
<span class="ct"><b>Its egress is {{$p.Egress}}</b><span>Observed from SSH_CLIENT on first connection. Declare it as an address scope on <a href="/scope">Scope</a> so the estate knows its own outbound address.</span></span>
</div>
{{end}}
</div>
{{end}}
<span class="st-note">A host that is not Linux on x86_64/aarch64 is refused, with the reason.</span>
</div>
</div>
</section>
{{end}}
{{if .IsAdmin}}
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Probers</span><h3>Provision an internet vantage</h3></div></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:14px">
{{if .ProberError}}<div class="st-error">{{.ProberError}}</div>{{end}}
<form method="post" action="/settings/probers" style="margin:0;display:grid;grid-template-columns:2fr 90px 1.4fr auto;gap:12px;align-items:end">{{template "backfield" $}}
<span class="st-input"><span class="lb">Host</span><span class="iw"><input name="host" value="{{.ProberHost}}" placeholder="probe-1.example.net" autocomplete="off" spellcheck="false" required></span></span>
<span class="st-input"><span class="lb">Port</span><span class="iw"><input name="port" value="{{if .ProberPort}}{{.ProberPort}}{{else}}22{{end}}" autocomplete="off"></span></span>
<span class="st-input"><span class="lb">Username</span><span class="iw"><input name="username" value="{{.ProberUser}}" placeholder="verge" autocomplete="off" spellcheck="false" required></span></span>
<button type="submit" class="st-btn pri">Provision</button>
</form>
<span class="st-note">Four non-secret values; the instance generates the keypair and publishes only the public half above. Don't hand-roll the host — deploy/prober/ is the hardened compose recipe.</span>
</div>
</div>
</section>
{{end}}
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Reach</span><h3>What a vantage can conclude</h3></div></div>
<div class="st-body">
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
<span class="st-av exposed" style="height:20px;padding:0 9px;font-size:10.5px;background:var(--danger-soft);border:1px solid var(--danger-border);color:var(--danger)">exposed</span>
<span class="st-av firewalled" style="height:20px;padding:0 9px;font-size:10.5px;background:var(--ok-soft);border:1px solid var(--ok-border);color:var(--ok)">firewalled</span>
<span class="st-av" style="height:20px;padding:0 9px;font-size:10.5px;background:var(--surface-sunken);border:1px solid var(--border-default);color:var(--text-secondary)">not reached</span>
<span class="st-av unverified" style="height:20px;padding:0 9px;font-size:10.5px">unverified</span>
<span class="st-note">states, never a score — concluded across two reach legs</span>
</div>
</div>
</section>
{{end}}

{{/* sso — holes: .SSOError .SSOProviders[{ID,Name,Slug,Issuer,ClientID,HasSecret,Enabled,CreatedBy,CreatedAt}] .SSOName .SSOSlug .SSOIssuer .SSOClientID .SSOBindings[{ID,ProviderName,Account,DisplayName,LinkedAt}] .IsAdmin */}}
{{define "settings-sso"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Access · single sign-on</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Single sign-on</h2>
<p class="st-lede">Sign-on via <strong>OpenID Connect</strong>. A provider authenticates an existing account by a linked, verified identity — bound to the provider's stable subject, never a mutable username — and never creates accounts; header-trust reverse-proxy auth stays refused. A user links a provider from their own <a href="/profile">Profile</a>; each enabled provider renders a button on the sign-in screen, and accounts can still sign in with a password and two-factor.</p>
</header>
{{if .SSOError}}<div class="st-error">{{.SSOError}}</div>{{end}}
<section class="st-card{{if .SSOProviders}} flush{{end}}">
<div class="st-cardhead"{{if .SSOProviders}} style="padding-bottom:14px"{{end}}><div class="hd"><span class="st-micro">OpenID Connect</span><h3>Identity providers</h3></div></div>
{{if .SSOProviders}}
<table class="st-table">
<thead><tr><th>Provider</th><th>Issuer</th><th style="width:150px">Client</th><th style="width:80px">Secret</th><th style="width:96px">State</th><th style="width:150px">Declared by</th>{{if .IsAdmin}}<th style="width:70px"></th>{{end}}</tr></thead>
<tbody>
{{range .SSOProviders}}<tr>
<td><span style="font:500 13px var(--font-ui);color:var(--text-ink)">{{.Name}}</span> <span style="font:400 11.5px var(--font-mono);color:var(--text-muted)">/{{.Slug}}</span></td>
<td class="mono" style="overflow:hidden;text-overflow:ellipsis;max-width:220px">{{.Issuer}}</td>
<td class="mono">{{.ClientID}}</td>
<td>{{if .HasSecret}}<span class="st-badge ok">set</span>{{else}}<span style="color:var(--text-muted)">none</span>{{end}}</td>
<td>{{if .Enabled}}<span class="st-badge ok"><span class="d"></span>enabled</span>{{else}}<span class="st-badge neutral">disabled</span>{{end}}</td>
<td class="mono">{{.CreatedBy}}<br><span style="color:var(--text-muted)">{{.CreatedAt}}</span></td>
{{if $.IsAdmin}}<td style="overflow:visible">
<details class="st-disc" style="position:relative">
<summary><span class="st-btn-sm">Edit</span></summary>
<div class="sheet" style="position:absolute;right:0;z-index:95;width:340px;box-shadow:var(--shadow-md);border:1px solid var(--border-default);background:var(--surface-raised)">
<form method="post" action="/settings/sso/update" style="margin:0;display:flex;flex-direction:column;gap:10px">
<input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}
<span class="st-input"><span class="lb">Display name</span><span class="iw"><input name="name" value="{{.Name}}" required></span></span>
<span class="st-input"><span class="lb">Slug</span><span class="iw"><input name="slug" value="{{.Slug}}" required></span></span>
<span class="st-input"><span class="lb">Issuer URL</span><span class="iw"><input name="issuer" value="{{.Issuer}}" required></span></span>
<span class="st-input"><span class="lb">Client ID</span><span class="iw"><input name="client_id" value="{{.ClientID}}" autocomplete="off" required></span></span>
<label class="st-check"><input type="checkbox" name="enabled"{{if .Enabled}} checked{{end}}><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>enabled</label>
<div><button type="submit" class="st-btn-sm">Save provider</button></div>
</form>
<form method="post" action="/settings/sso/secret" style="margin:0;display:flex;flex-direction:column;gap:10px">
<input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}
<span class="st-input"><span class="lb">Replace client secret</span><span class="iw"><input name="client_secret" type="password" autocomplete="off" placeholder="{{if .HasSecret}}set — leave blank to keep{{else}}not set — leave blank for none{{end}}"></span></span>
{{if .HasSecret}}<label class="st-check"><input type="checkbox" name="clear_secret"><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>clear the secret</label>{{end}}
<div><button type="submit" class="st-btn-sm">Update secret</button></div>
</form>
<form method="post" action="/settings/sso/delete" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm" style="color:var(--danger);border-color:var(--danger-border)">Remove provider</button></form>
</div>
</details>
</td>{{end}}
</tr>{{end}}
</tbody>
</table>
{{else}}
<div class="st-body"><div class="st-empty">
<span class="msg">No identity provider configured</span>
<span class="det">Nothing is configured, so the sign-in screen offers no single-sign-on button and accounts sign in with a password and two-factor. Add an OpenID Connect provider below to enable SSO.</span>
</div></div>
{{end}}
</section>
{{if .IsAdmin}}
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">New provider</span><h3>Add an OpenID Connect provider</h3></div></div>
<div class="st-body">
<form method="post" action="/settings/sso" class="st-form" style="margin:0">
{{template "backfield" $}}
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
<span class="st-input"><span class="lb">Display name</span><span class="iw"><input name="name" value="{{.SSOName}}" placeholder="Okta" required></span></span>
<span class="st-input"><span class="lb">Slug</span><span class="iw"><input name="slug" value="{{.SSOSlug}}" placeholder="okta" autocomplete="off" required></span></span>
</div>
<span class="st-input"><span class="lb">Issuer URL</span><span class="iw"><input name="issuer" value="{{.SSOIssuer}}" placeholder="https://example.okta.com" autocomplete="off" required></span></span>
<span class="st-input"><span class="lb">Client ID</span><span class="iw"><input name="client_id" value="{{.SSOClientID}}" autocomplete="off" required></span></span>
<span class="st-input"><span class="lb">Client secret (optional)</span><span class="iw"><input name="client_secret" type="password" autocomplete="off" placeholder="confidential clients only — never shown again"></span></span>
<div><button type="submit" class="st-btn pri">Add provider</button></div>
</form>
</div>
</section>
{{end}}
<section class="st-card{{if .SSOBindings}} flush{{end}}">
<div class="st-cardhead"{{if .SSOBindings}} style="padding-bottom:14px"{{end}}><div class="hd"><span class="st-micro">Linked identities</span><h3>Who signs in with what</h3></div></div>
{{if .SSOBindings}}
<div style="padding:0 20px 8px"><span class="st-note">Every verified identity bound to a local account. Users link their own from their Profile; remove one here to offboard a departed user or reclaim a reassigned seat — the identity can no longer sign in as that account.</span></div>
<table class="st-table">
<thead><tr><th>Provider</th><th>Account</th><th>Identity</th><th style="width:120px">Linked</th><th style="width:90px"></th></tr></thead>
<tbody>
{{range .SSOBindings}}<tr>
<td>{{.ProviderName}}</td>
<td class="mono">{{.Account}}</td>
<td class="mono">{{if .DisplayName}}{{.DisplayName}}{{else}}<span style="color:var(--text-muted)">—</span>{{end}}</td>
<td class="mono">{{.LinkedAt}}</td>
<td style="text-align:right"><form method="post" action="/settings/sso/identity/remove" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm">Remove</button></form></td>
</tr>{{end}}
</tbody>
</table>
{{else}}
<div class="st-body"><span class="st-note">No identities are linked yet. A user links one from their Profile once a provider is enabled.</span></div>
{{end}}
</section>
{{end}}

{{/* team — holes: .TeamError .RoleError .RemoveError .Members[{ID,Username,Initials,Role,TotpEnabled,At,IsSelf}] .IsAdmin .RoleTarget{ID,Username,Role} .ReenrollTarget{ID,Username} .RemoveTarget{ID,Username} .InviteOpen .InviteRole .InviteLink */}}
{{define "settings-team"}}
<header style="display:flex;align-items:flex-start;gap:16px">
<div style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Access · team</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Who can sign in</h2>
</div>
{{if .IsAdmin}}<a class="st-btn pri" style="margin-left:auto" href="/settings?tab=team&invite=1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21a8 8 0 0 1 13.292-6"></path><circle cx="10" cy="8" r="5"></circle><path d="M19 16v6"></path><path d="M22 19h-6"></path></svg>Invite</a>{{end}}
</header>
{{if .TeamError}}<div class="st-error">{{.TeamError}}</div>{{end}}
{{if .RoleError}}<div class="st-error">{{.RoleError}}</div>{{end}}
<section class="st-card flush">
<div class="st-cardhead" style="padding-bottom:14px"><div class="hd"><span class="st-micro">Members</span><h3>Accounts</h3></div></div>
<table class="st-table">
<thead><tr><th>Member</th><th style="width:110px">Role</th><th style="width:152px">Two-factor</th><th style="width:140px">Member since</th>{{if .IsAdmin}}<th style="width:58px"></th>{{end}}</tr></thead>
<tbody>
{{range .Members}}<tr>
<td><span style="display:inline-flex;align-items:center;gap:10px"><span class="st-avatar">{{.Initials}}</span><span class="mono" style="font-size:12.5px;font-family:var(--font-mono)">{{.Username}}{{if .IsSelf}} <span style="color:var(--text-muted)">(you)</span>{{end}}</span></span></td>
<td><span class="st-tag">{{.Role}}</span></td>
<td>{{if .TotpEnabled}}<span class="st-badge ok"><span class="d"></span>enrolled</span>{{else}}<span class="st-badge warn"><span class="d"></span>not enrolled</span>{{end}}</td>
<td class="mono">{{if .At}}{{.At}}{{else}}<span style="color:var(--text-muted)">—</span>{{end}}</td>
{{if $.IsAdmin}}<td style="text-align:right;overflow:visible">{{if not .IsSelf}}
<span class="st-pop">
<button type="button" class="st-kebab" data-st-menu aria-haspopup="menu" aria-expanded="false" aria-label="Member actions"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="19" cy="12" r="1.6"></circle></svg></button>
<div class="st-panel" hidden role="menu">
<a class="st-mi" role="menuitem" href="/settings?tab=team&role={{.ID}}"><span class="mic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg></span>Change role</a>
<a class="st-mi" role="menuitem" href="/settings?tab=team&reenroll={{.ID}}"><span class="mic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></span>Require re-enrollment</a>
<div class="st-sep"></div>
<a class="st-mi danger" role="menuitem" href="/settings?tab=team&remove={{.ID}}"><span class="mic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21a8 8 0 0 1 11.873-7"></path><circle cx="10" cy="8" r="5"></circle><path d="M17 17h6"></path></svg></span>Remove member</a>
</div>
</span>
{{end}}</td>{{end}}
</tr>{{end}}
</tbody>
</table>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Roles</span><h3>What each role can do</h3></div></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:10px">
<div style="display:flex;align-items:baseline;gap:12px"><span style="width:76px;flex:none"><span class="st-tag">admin</span></span><span style="font:400 12.5px/1.6 var(--font-ui);color:var(--text-body)">performs declared acts — seeds, scans, channels, annotations, team, instance</span></div>
<div style="display:flex;align-items:baseline;gap:12px"><span style="width:76px;flex:none"><span class="st-tag">viewer</span></span><span style="font:400 12.5px/1.6 var(--font-ui);color:var(--text-body)">reads everything, changes nothing — including the sources catalogue</span></div>
</div>
</div>
</section>
{{with .RoleTarget}}
<a class="st-scrim" href="/settings?tab=team" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Change role">
<h2>Change role</h2>
<p class="desc" style="font-family:var(--font-mono);font-size:12.5px">{{.Username}}</p>
<form method="post" action="/settings/accounts/role" style="margin:16px 0 0;display:flex;flex-direction:column;gap:12px">
<input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}
<span class="st-input"><span class="lb">Role</span>
<select id="st-role-select" name="role" data-current="{{.Role}}" style="height:36px;padding:0 12px;background:var(--surface);color:var(--text-ink);font:400 13px var(--font-ui);border:1px solid var(--border-default);border-radius:12px;outline:none">
<option value="admin"{{if eq .Role "admin"}} selected{{end}}>admin — declared acts</option>
<option value="viewer"{{if eq .Role "viewer"}} selected{{end}}>viewer — read-only</option>
</select></span>
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=team">Cancel</a>
<button id="st-role-save" type="submit" class="st-btn pri" disabled>Save role</button>
</div>
</form>
</div></div>
{{end}}
{{with .ReenrollTarget}}
<a class="st-scrim" href="/settings?tab=team" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Require re-enrollment">
<h2>Require re-enrollment</h2>
<p class="desc" style="font-family:var(--font-mono);font-size:12.5px">{{.Username}}</p>
<p class="detail">Their current authenticator stops working immediately; the next sign-in walks them through two-factor setup again. Active sessions stay signed in.</p>
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=team">Cancel</a>
<form method="post" action="/settings/accounts/reenroll" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn sec">Require re-enrollment</button></form>
</div>
</div></div>
{{end}}
{{with .RemoveTarget}}
<a class="st-scrim" href="/settings?tab=team" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Remove member">
<h2>Remove member</h2>
<p class="desc">{{.Username}} loses access to this deployment.</p>
<p class="detail">Their annotations and audit history stay attributed. Personal API tokens are revoked.</p>
{{if $.RemoveError}}<div class="st-error" style="margin-top:12px">{{$.RemoveError}}</div>{{end}}
<form method="post" action="/settings/accounts/remove" style="margin:16px 0 0;display:flex;flex-direction:column;gap:6px">
<input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}
<span style="font:400 12.5px var(--font-ui);color:var(--text-secondary)">Type <span id="st-typed-name" style="font:600 12px var(--font-mono);color:var(--text-ink)">{{.Username}}</span> to confirm.</span>
<input class="typed" name="confirm_name" autocomplete="off" spellcheck="false" required aria-label="Type the username to confirm">
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=team">Cancel</a>
<button type="submit" class="st-btn danger" disabled data-st-typed-submit>Remove member</button>
</div>
</form>
</div></div>
{{end}}
{{if .InviteOpen}}
<a class="st-scrim" href="/settings?tab=team" aria-label="Close"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Invite a member">
{{if .InviteLink}}
<h2>Copy the join link now</h2>
<div class="st-callout warn" style="margin:16px 0 0">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span>
<span class="ct"><b>Shown once</b><span>Hand it to the invitee out of band. Verge keeps only a hash, so it cannot be shown again.</span></span>
</div>
<div style="display:flex;align-items:center;gap:8px;margin-top:14px">
<code id="st-invite-link" style="flex:1;min-width:0;word-break:break-all;background:var(--surface-sunken);border:1px solid var(--border-default);border-radius:10px;padding:10px 12px;font:400 12px/1.5 var(--font-mono);color:var(--text-body)">{{.InviteLink}}</code>
<button type="button" class="st-btn-sm" style="flex:none" data-st-copy="#st-invite-link">Copy</button>
</div>
<p class="detail" style="font-size:12px;color:var(--text-muted)">The role applies on acceptance; the link expires in 7 days.</p>
<div class="acts"><a class="st-btn pri" href="/settings?tab=team">Done</a></div>
{{else}}
<h2>Invite a member</h2>
<p class="desc">They get a join link; the role applies on acceptance. This build has no mail, so you hand the link over out of band.</p>
{{if .TeamError}}<div class="st-error" style="margin-top:12px">{{.TeamError}}</div>{{end}}
<form method="post" action="/settings/accounts" style="margin:16px 0 0;display:flex;flex-direction:column;gap:12px">
{{template "backfield" $}}<span class="st-input"><span class="lb">Role</span>
<select name="role" style="height:36px;padding:0 12px;background:var(--surface);color:var(--text-ink);font:400 13px var(--font-ui);border:1px solid var(--border-default);border-radius:12px;outline:none">
<option value="viewer"{{if eq .InviteRole "viewer"}} selected{{end}}>viewer — read-only</option>
<option value="admin"{{if eq .InviteRole "admin"}} selected{{end}}>admin — declared acts</option>
</select></span>
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=team">Cancel</a>
<button type="submit" class="st-btn pri">Create invite</button>
</div>
</form>
{{end}}
</div></div>
{{end}}
{{end}}

{{/* sessions — holes: .Sessions[{ID,AccountID,Account,Role,Device,IP,LastSeen,Current}] .IsAdmin .RevokeSessionTarget{ID,Account,Device,IP} .RevokeAccountTarget{AccountID,Username} .RevokeAccountError */}}
{{define "settings-sessions"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Access · sessions</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Active sessions</h2>
<p class="st-lede">Every account's live sessions across this deployment, newest activity first. Revoking one signs that browser out at once — its next request lands on the sign-in screen. Your own sessions live on your <a href="/profile">profile</a>.</p>
</header>
<section class="st-card{{if .Sessions}} flush{{end}}">
{{if .Sessions}}
<table class="st-table">
<thead><tr><th>Account</th><th style="width:96px">Role</th><th style="width:170px">Device</th><th style="width:140px">IP</th><th style="width:100px">Last active</th>{{if .IsAdmin}}<th style="width:84px"></th>{{end}}</tr></thead>
<tbody>
{{range .Sessions}}<tr>
<td class="mono">{{.Account}}{{if .Current}} <span style="color:var(--text-muted)">(you)</span>{{end}}</td>
<td><span class="st-badge neutral">{{.Role}}</span></td>
<td>{{.Device}}</td>
<td class="mono">{{.IP}}</td>
<td class="mono">{{.LastSeen}}</td>
{{if $.IsAdmin}}<td style="text-align:right;overflow:visible">{{if not .Current}}
<span style="display:inline-flex;gap:4px;align-items:center">
<a class="st-kebab" href="/settings?tab=sessions&revoke={{.ID}}" aria-label="Revoke session" title="Revoke session"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg></a>
<span class="st-pop">
<button type="button" class="st-kebab" data-st-menu aria-haspopup="menu" aria-expanded="false" aria-label="More"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="19" cy="12" r="1.6"></circle></svg></button>
<div class="st-panel" hidden role="menu">
<a class="st-mi danger" role="menuitem" href="/settings?tab=sessions&revoke-account={{.AccountID}}"><span class="mic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m4.9 4.9 14.2 14.2"></path></svg></span>Revoke all for {{.Account}}</a>
</div>
</span>
</span>
{{end}}</td>{{end}}
</tr>{{end}}
</tbody>
</table>
{{else}}
<div class="st-body"><div class="st-empty">
<span class="msg">No active sessions</span>
<span class="det">No account has a live session right now. A session opens when someone signs in and stays listed here until it is revoked or expires.</span>
</div></div>
{{end}}
</section>
{{with .RevokeSessionTarget}}
<a class="st-scrim" href="/settings?tab=sessions" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Revoke session">
<h2>Revoke this session</h2>
<p class="detail">{{.Account}}'s session on <span style="font-family:var(--font-mono);font-size:12.5px">{{.Device}}</span> from <span style="font-family:var(--font-mono);font-size:12.5px">{{.IP}}</span> is signed out immediately.</p>
<p class="detail" style="color:var(--text-secondary)">Its next request lands on the sign-in screen. The account's other sessions are unaffected.</p>
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=sessions">Cancel</a>
<form method="post" action="/settings/sessions/revoke" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn danger">Revoke session</button></form>
</div>
</div></div>
{{end}}
{{with .RevokeAccountTarget}}
<a class="st-scrim" href="/settings?tab=sessions" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Revoke all sessions">
<h2>Revoke every session for {{.Username}}</h2>
<p class="detail">Every live session {{.Username}} holds is signed out immediately.</p>
<p class="detail" style="color:var(--text-secondary)">Their membership, role and personal tokens are unaffected; remove the member on <a href="/settings?tab=team" style="color:var(--link)">Team</a> to fully offboard.</p>
{{if $.RevokeAccountError}}<div class="st-error" style="margin-top:12px">{{$.RevokeAccountError}}</div>{{end}}
<form method="post" action="/settings/sessions/revoke-account" style="margin:16px 0 0;display:flex;flex-direction:column;gap:6px">{{template "backfield" $}}
<input type="hidden" name="account_id" value="{{.AccountID}}">
<span style="font:400 12.5px var(--font-ui);color:var(--text-secondary)">Type <span id="st-typed-name" style="font:600 12px var(--font-mono);color:var(--text-ink)">{{.Username}}</span> to confirm.</span>
<input class="typed" name="confirm_name" autocomplete="off" spellcheck="false" required aria-label="Type the username to confirm">
<div class="acts">
<a class="st-btn ghost" href="/settings?tab=sessions">Cancel</a>
<button type="submit" class="st-btn danger" disabled data-st-typed-submit>Revoke all sessions</button>
</div>
</form>
</div></div>
{{end}}
{{end}}

{{/* audit — holes: .AuditRows[{When,Actor,Action,Subject}] (nullable) */}}
{{define "settings-audit"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Access · operational record</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Audit log</h2>
<p class="st-lede">Who did what, when. This build keeps no separate queryable log of admin acts — source enablement, for one, keeps no log line of its own and is dated by the batch whose recorded source set it moved.</p>
</header>
{{if .AuditRows}}
<section class="st-card flush">
<table class="st-table">
<thead><tr><th style="width:160px">When</th><th style="width:170px">Actor</th><th style="width:170px">Action</th><th>Subject</th></tr></thead>
<tbody>
{{range .AuditRows}}<tr>
<td class="mono">{{.When}}</td><td class="mono">{{.Actor}}</td><td class="mono">{{.Action}}</td><td class="mono">{{.Subject}}</td>
</tr>{{end}}
</tbody>
</table>
</section>
{{else}}
<section class="st-card"><div class="st-body"><div class="st-empty">
<span class="msg">No audit log</span>
<span class="det">The operational records this build does keep are the <a href="/settings?tab=delivery">delivery record</a> and the <a href="/settings?tab=messages">message store</a> — each fact is legible where it fired.</span>
</div></div></section>
{{end}}
{{end}}

{{/* sources — holes: .SourceError .Unencumbered/.OperatorAccepted/.Barred[{ID,Name,Kind,What,On}] .IsAdmin .Consent{ID,Name,Terms[]} (PRG ?consent={id}) */}}
{{define "settings-sources"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Discovery · sources</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Sources</h2>
<p class="st-lede">A source admits subjects on its own authority; a proposer only answers an org-name search with address scopes — nothing joins the estate until you confirm it into a seed. Consent tiers are release-authored.</p>
</header>
{{if .SourceError}}<div class="st-error">{{.SourceError}}</div>{{end}}
<div class="st-callout">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span>
<span class="ct"><b>Toggling is admin-only</b><span>Every account can read this catalogue. Enabling or disabling is an admin act — it keeps no log line of its own; it is dated by the batch whose recorded source set it moved.</span></span>
</div>
<section class="st-card">
<div class="st-cardhead">
<div class="hd"><span class="st-micro">certificate transparency · bulk-by-name</span><h3>Active source</h3></div>
<span style="margin-left:auto">{{if .CTHero.HasRun}}<span class="st-badge {{.CTHero.StatusClass}}">{{.CTHero.StatusLabel}}</span>{{else}}<span class="st-badge neutral">awaiting first scan</span>{{end}}</span>
</div>
<div class="st-body">{{with .CTHero}}
<div style="display:flex;flex-direction:column;gap:16px">
{{if .HasRun}}
<p class="st-note" style="font-family:var(--font-mono);font-size:12px;color:var(--text-secondary)">last ct scan · {{.Active.Name}} · {{.LastRunRel}} · {{.Names}} names admitted</p>
{{if .Degraded}}<div class="st-callout warn"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span><span class="ct"><b>Primary is under its reliability bar</b><span>Runtime failover is not built (deferred). The ct Scan keeps running {{.Active.Name}}; there is no silent swap to crt.sh. Reconfigure the worker to change the source.</span></span></div>{{end}}
{{if not .IsPrimary}}<div class="st-callout accent"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span><span class="ct"><b>crt.sh is the keyless default</b><span>Set <code>VERGE_CERTSPOTTER_TOKEN</code> on the worker to promote Cert Spotter as the bulk primary. crt.sh stays the keyless fallback, bar-exempt.</span></span></div>{{end}}
<div style="display:flex;gap:12px;flex-wrap:wrap">
<div class="st-kv" style="grid-template-columns:1fr;flex:1 1 160px"><div class="cell"><span class="st-micro">operator key</span><span class="v">{{.KeyLabel}}</span></div></div>
<div class="st-kv" style="grid-template-columns:1fr;flex:1 1 160px"><div class="cell"><span class="st-micro">{{.DormantRole}} · dormant</span><span class="v">{{.DormantName}}</span></div></div>
</div>
<div class="st-kv" style="grid-template-columns:repeat(3,minmax(0,1fr))">
<div class="cell" style="gap:6px"><span class="st-micro">success · {{$.CTReliabilityBar.SuccessTarget}}</span><span style="font:600 22px var(--font-mono);color:var(--text-ink)">{{.Active.SuccessPct}}</span>{{if .Active.Exempt}}<span class="st-badge neutral">bar-exempt</span>{{else if not .Active.HasData}}<span class="st-badge neutral">no data</span>{{else if .Active.SuccessPass}}<span class="st-badge ok">pass</span>{{else}}<span class="st-badge danger">under bar</span>{{end}}</div>
<div class="cell" style="gap:6px"><span class="st-micro">p95 latency · {{$.CTReliabilityBar.LatencyTarget}}</span><span style="font:600 22px var(--font-mono);color:var(--text-ink)">{{.Active.P95Display}}</span>{{if .Active.Exempt}}<span class="st-badge neutral">bar-exempt</span>{{else if not .Active.HasData}}<span class="st-badge neutral">no data</span>{{else if .Active.LatencyPass}}<span class="st-badge ok">pass</span>{{else}}<span class="st-badge danger">under bar</span>{{end}}</div>
<div class="cell" style="gap:6px"><span class="st-micro">false-empty · none</span><span style="font:600 22px var(--font-mono);color:var(--text-ink)">{{if .Active.HasData}}{{.Active.FalseEmpty}}{{else}}—{{end}}</span>{{if .Active.Exempt}}<span class="st-badge neutral">bar-exempt</span>{{else if not .Active.HasData}}<span class="st-badge neutral">no data</span>{{else if .Active.FalseEmptyPass}}<span class="st-badge ok">pass</span>{{else}}<span class="st-badge danger">under bar</span>{{end}}</div>
</div>
{{else}}
<div class="st-callout accent"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span><span class="ct"><b>No bulk ct scan has run yet</b><span>crt.sh is the keyless default and runs once the ct Scan fires. Set <code>VERGE_CERTSPOTTER_TOKEN</code> on the worker to promote Cert Spotter as the bulk primary.</span></span></div>
{{end}}
</div>
{{end}}</div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">certificate transparency · logs-direct</span><h3>More CT capabilities</h3></div></div>
<div class="st-body">{{with .CTCapabilities}}
<div style="display:flex;flex-direction:column;gap:16px">
<p class="st-note">Two keyless capabilities beside the bulk source. Neither is bulk-by-name, and neither carries the reliability bar.</p>
<div style="display:flex;flex-direction:column;gap:8px">
<div style="display:flex;align-items:center;gap:10px"><span class="st-micro">drift tail · opt-in scan</span><span style="margin-left:auto">{{if .TailEnabled}}<span class="st-badge ok">on</span>{{else}}<span class="st-badge neutral">off</span>{{end}}</span></div>
{{if .TailHasRun}}<p class="st-note" style="font-family:var(--font-mono);font-size:12px;color:var(--text-secondary)">last ct-tail scan · {{.TailLastRel}} · {{.TailNames}} names admitted</p>{{else if .TailEnabled}}<p class="st-note" style="font-family:var(--font-mono);font-size:12px;color:var(--text-secondary)">enabled · awaiting first poll</p>{{end}}
<span class="st-note">Reads CT logs directly, forward-only, and admits new issuance for names you already know. Ships off — enable the CT drift tail in the sources list to run it.</span>
</div>
<div style="display:flex;flex-direction:column;gap:8px;padding-top:16px;border-top:1px solid var(--row-sep)">
<div style="display:flex;align-items:center;gap:10px"><span class="st-micro">verification · point-check</span><span style="margin-left:auto">{{if .Captured}}<span class="st-badge ok">active</span>{{else}}<span class="st-badge neutral">awaiting captures</span>{{end}}</span></div>
<p class="st-note" style="font-family:var(--font-mono);font-size:12px;color:var(--text-secondary)">{{.Captured}} certificates captured · auto-verified once each</p>
<span class="st-note">Keyless and always on. Confirms a certificate you saw is logged in CT; a logged / not-logged result is an ephemeral event on the job line, not stored.</span>
</div>
</div>
{{end}}</div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">unencumbered</span><h3>Shipped on</h3></div></div>
<div class="st-body"><div style="display:flex;flex-direction:column;gap:8px">
{{range .Unencumbered}}
<div class="st-row">
<span style="font:500 13px var(--font-ui);color:var(--text-ink)">{{.Name}}</span>
<span class="st-tag">{{.Kind}}</span>
<span class="st-note">{{.What}}</span>
<span style="margin-left:auto;display:inline-flex;align-items:center;gap:10px">
<span class="st-badge ok">unencumbered</span>
{{if $.IsAdmin}}<form method="post" action="/settings/sources" style="margin:0"><input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="enable" value="{{if .On}}false{{else}}true{{end}}">{{template "backfield" $}}<button type="submit" role="switch" aria-checked="{{if .On}}true{{else}}false{{end}}" class="st-switch{{if .On}} on{{end}}" aria-label="{{if .On}}Disable{{else}}Enable{{end}} {{.Name}}"><span class="knob"></span></button></form>{{else}}<span class="st-switch{{if .On}} on{{end}}" role="switch" aria-checked="{{if .On}}true{{else}}false{{end}}"><span class="knob"></span></span>{{end}}
</span>
</div>
{{end}}
</div></div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">operator-accepted</span><h3>Ship off — accept the terms</h3></div></div>
<div class="st-body"><div style="display:flex;flex-direction:column;gap:8px">
{{range .OperatorAccepted}}
<div class="st-row">
<span style="font:500 13px var(--font-ui);color:var(--text-ink)">{{.Name}}</span>
<span class="st-tag">{{.Kind}}</span>
<span class="st-note">{{.What}}</span>
<span style="margin-left:auto;display:inline-flex;align-items:center;gap:10px">
<span class="st-badge warn">operator-accepted</span>
{{if $.IsAdmin}}{{if .On}}<form method="post" action="/settings/sources" style="margin:0"><input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="enable" value="false">{{template "backfield" $}}<button type="submit" role="switch" aria-checked="true" class="st-switch on" aria-label="Disable {{.Name}}"><span class="knob"></span></button></form>{{else}}<a href="/settings?tab=sources&consent={{.ID}}" role="switch" aria-checked="false" class="st-switch" aria-label="Enable {{.Name}} — accept the terms" style="text-decoration:none"><span class="knob"></span></a>{{end}}{{else}}<span class="st-switch{{if .On}} on{{end}}" role="switch" aria-checked="{{if .On}}true{{else}}false{{end}}"><span class="knob"></span></span>{{end}}
</span>
</div>
{{end}}
</div></div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">barred</span><h3>Not run for anyone</h3></div></div>
<div class="st-body"><div style="display:flex;flex-direction:column;gap:8px">
{{range .Barred}}
<div class="st-row">
<span style="font:500 13px var(--font-ui);color:var(--text-ink)">{{.Name}}</span>
<span class="st-tag">{{.Kind}}</span>
{{if .What}}<span class="st-note">{{.What}}</span>{{end}}
<span style="margin-left:auto"><span class="st-badge neutral">barred — excluded on terms</span></span>
</div>
{{end}}
</div></div>
</section>
{{with .Consent}}
<a class="st-scrim" href="/settings?tab=sources" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Enable {{.Name}}">
<h2>Enable {{.Name}}</h2>
<p class="desc">The project could not clear these terms on your behalf. Your acceptance, your reading.</p>
<div style="display:flex;flex-direction:column;gap:8px;margin-top:16px">
{{range .Terms}}
<div style="display:flex;gap:10px;align-items:flex-start">
<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:3px"><path d="M20 6 9 17l-5-5"></path></svg>
<span style="font:400 12.5px/1.6 var(--font-ui);color:var(--text-body)">{{.}}</span>
</div>
{{end}}
</div>
<form method="post" action="/settings/sources" style="margin:16px 0 0;display:flex;flex-direction:column;gap:14px">
<input type="hidden" name="id" value="{{.ID}}">
<input type="hidden" name="enable" value="true">{{template "backfield" $}}
<label class="st-check"><input type="checkbox" id="st-consent-check" name="accept_terms" value="true"><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>I accept these terms</label>
<div class="acts" style="margin-top:0">
<a class="st-btn ghost" href="/settings?tab=sources">Cancel</a>
<button type="submit" class="st-btn pri" data-st-consent-submit>Accept and enable</button>
</div>
</form>
</div></div>
{{end}}
{{end}}

{{/* aperture — holes: .UDPCount .Counts{Sensitive,Frequency,Union,TCP,UDP} .Sensitive[{Port,Transport,Service}] .Frequency[{Port,AlsoSensitive,Edited,EditAction}] .VCError .VCPort .IsAdmin */}}
{{define "settings-aperture"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Discovery · port aperture</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Port aperture</h2>
<p class="st-lede">The daily hot-tier port set the census walks: the union of a release-authored <em>sensitive</em> tier and an operator-editable <em>frequency</em> tier, plus any port previously seen on the subject. Only the TCP pairs are probed; the {{.UDPCount}} UDP pairs are recorded in scope and never probed.</p>
</header>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">verge-core</span><h3>Sensitive tier</h3></div><span style="margin-left:auto"><span class="st-badge neutral">locked</span></span></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:12px">
<div style="display:flex;gap:8px;flex-wrap:wrap">
{{range .Sensitive}}<span style="display:inline-flex;align-items:center;gap:7px;padding:5px 10px;background:var(--surface-sunken);border:1px solid var(--border-default);border-radius:999px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg><span style="font:500 12px var(--font-mono);color:var(--text-ink)">:{{.Port}}</span>{{if .Service}}<span style="font:400 11px var(--font-mono);color:var(--text-muted)">{{.Service}}</span>{{end}}</span>{{end}}
</div>
<div class="st-callout">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span>
<span class="ct"><b>Not editable, on purpose</b><span>A port you can hide is a signal you can silence. The sensitive tier is release-authored and moves only with the release — {{.Counts.Sensitive}} pairs, and there is no control to move one.</span></span>
</div>
</div>
</div>
</section>
<section class="st-card{{if .Frequency}} flush{{end}}">
<div class="st-cardhead" style="padding-bottom:14px"><div class="hd"><span class="st-micro">verge-core</span><h3>Frequency tier</h3></div></div>
<div style="padding:0 20px 14px;display:flex;flex-direction:column;gap:12px">
<span class="st-note">{{.Counts.Frequency}} TCP ports. Admins may widen or narrow this tier. A port also on the sensitive tier stays probed even if you remove it here — the union keeps it. Union: {{.Counts.Union}} pairs ({{.Counts.TCP}} TCP, {{.Counts.UDP}} UDP).</span>
{{if .VCError}}<div class="st-error">{{.VCError}}</div>{{end}}
{{if .IsAdmin}}
<form method="post" action="/verge-core/frequency" style="margin:0;display:flex;gap:8px;align-items:flex-end">
<input type="hidden" name="action" value="add">{{template "backfield" $}}
<span class="st-input" style="width:200px"><span class="lb">Add a frequency port</span><span class="iw"><input name="port" inputmode="numeric" value="{{.VCPort}}" placeholder="8443" autocomplete="off" required></span></span>
<button type="submit" class="st-btn sec">Add to frequency</button>
</form>
{{end}}
</div>
{{if .Frequency}}
<table class="st-table">
<thead><tr><th style="width:110px">Port</th><th style="width:140px">Also sensitive</th><th>Edit</th>{{if .IsAdmin}}<th style="width:170px"></th>{{end}}</tr></thead>
<tbody>
{{range .Frequency}}<tr>
<td class="mono">:{{.Port}}/tcp</td>
<td>{{if .AlsoSensitive}}<span class="st-badge neutral">sensitive</span>{{else}}<span style="color:var(--text-muted)">—</span>{{end}}</td>
<td>{{if .Edited}}<span class="st-badge accent">{{.EditAction}}</span>{{else}}<span style="color:var(--text-muted)">shipped</span>{{end}}</td>
{{if $.IsAdmin}}<td style="text-align:right"><span style="display:inline-flex;gap:6px">
<form method="post" action="/verge-core/frequency" style="margin:0"><input type="hidden" name="action" value="remove"><input type="hidden" name="port" value="{{.Port}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm">Remove</button></form>
{{if .Edited}}<form method="post" action="/verge-core/frequency" style="margin:0"><input type="hidden" name="action" value="reset"><input type="hidden" name="port" value="{{.Port}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm">Reset</button></form>{{end}}
</span></td>{{end}}
</tr>{{end}}
</tbody>
</table>
{{end}}
</section>
{{end}}

{{/* instance — holes (#391 — the .Update callout retired into Release): .Instance{Version,License,Uptime,QueueDepth,DiskPct,DiskDetail,PgLabel,PgDetail,Vantages[] (nullable),Backup{InProgress,Streamed,SizeHint,Percent,LastAt,LastSize} (nullable),RestoreError,Preflight{File,TakenAt,Subjects,Schema} (nullable),RestoreConfirm{File,TakenAt,Subjects} (nullable — ?restore-confirm=1),Migrations{Pending},Release{State(current|newer|disabled),CheckEnabled,CheckedAt,Latest{Version,Notes},Steps[]}} */}}
{{define "settings-instance"}}
{{with .Instance}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Instance · health</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Health</h2>
</header>

<div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:24px">
<section class="st-card"><div class="st-body" style="display:flex;flex-direction:column;gap:4px"><span class="st-micro">Version</span><span style="font:600 28px var(--font-mono);color:var(--text-ink);line-height:1.1">{{.Version}}</span><span class="st-note">{{.License}}</span></div></section>
<section class="st-card"><div class="st-body" style="display:flex;flex-direction:column;gap:4px"><span class="st-micro">Uptime</span><span style="font:600 28px var(--font-mono);color:var(--text-ink);line-height:1.1">{{.Uptime}}</span><span class="st-note">since last restart</span></div></section>
<section class="st-card"><div class="st-body" style="display:flex;flex-direction:column;gap:4px"><span class="st-micro">Queue depth</span><span style="font:600 28px var(--font-mono);color:var(--text-ink);line-height:1.1">{{.QueueDepth}}</span><span class="st-note">subjects waiting</span></div></section>
</div>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Host</span><h3>Storage &amp; database</h3></div></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:16px">
<div style="display:flex;flex-direction:column;gap:6px">
<div style="display:flex;align-items:baseline;gap:8px"><span style="font:500 12.5px var(--font-ui);color:var(--text-body)">Disk</span><span style="margin-left:auto;font:400 11.5px var(--font-mono);color:var(--text-secondary)">{{.DiskDetail}}</span></div>
<div class="st-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{.DiskPct}}"><span class="fill" style="width:{{.DiskPct}}%"></span></div>
</div>
<div style="display:flex;align-items:center;gap:10px">
<span class="st-dot done"></span>
<span style="font:400 12.5px var(--font-ui);color:var(--text-secondary)">{{.PgLabel}}</span>
<span style="font:400 11.5px var(--font-mono);color:var(--text-muted)">{{.PgDetail}}</span>
</div>
</div>
</div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Fleet</span><h3>Vantages</h3></div></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:10px">
{{range .Vantages}}
<div style="display:flex;align-items:center;gap:10px">
<span style="font:500 12.5px var(--font-mono);color:var(--text-ink)">{{.Name}}</span>
<span style="margin-left:auto;display:inline-flex;align-items:center;gap:8px">
<span style="font:400 11.5px var(--font-mono);color:var(--text-muted)">{{if .Latency}}{{.Latency}}{{else}}—{{end}}</span>
<span class="st-av {{.Avail}}"><span class="d"></span>{{.Avail}}</span>
</span>
</div>
{{else}}
<div class="st-empty" style="padding:20px 12px">
<span class="msg">No vantage provisioned</span>
<span class="det">Only the shipped resolver position exists. Provision a prober under <a href="/settings?tab=vantages">Scanning · Vantages</a> to measure from the internet.</span>
</div>
{{end}}
</div>
</div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Instance · data</span><h3>Backup</h3></div></div>
<div class="st-body"><div style="display:flex;flex-direction:column;gap:12px">
<p class="st-lede">A backup carries the estate and its configuration — data only, never a secret. The session key and the prober key are not in it: on restore both regenerate, and old sessions lapse. That is the design, not a caveat — a stolen backup cannot impersonate this instance.</p>
{{with .Backup}}{{if .InProgress}}
<div style="display:flex;align-items:center;gap:10px"><span class="st-dotlive"></span><span style="font:400 12.5px var(--font-ui);color:var(--text-secondary)">Preparing the archive — {{.Streamed}} of ~{{.SizeHint}}. Big estates stream; the download starts when the archive is sealed.</span></div>
<div class="st-meter"><span class="fill" style="width:{{.Percent}}%"></span></div>
{{else}}
<div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
{{if $.IsAdmin}}<form method="post" action="/settings/backup" style="margin:0"><button type="submit" class="st-btn">Download backup</button></form>{{end}}
<span class="st-note">{{if .LastAt}}Last backup {{.LastAt}} · {{.LastSize}}{{else}}No backup has been taken from this UI yet.{{end}}</span>
</div>
{{end}}{{end}}
</div></div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Instance · data</span><h3>Restore</h3></div></div>
<div class="st-body"><div style="display:flex;flex-direction:column;gap:12px">
<p class="st-lede">Restoring replaces the current estate and configuration with the archive’s — it overwrites what is here now. The archive is pre-flighted before anything is touched, and applying it takes a typed confirmation. Fresh session and prober keys are generated: every session signs in again, and probers re-pin.</p>
{{if .RestoreError}}<div class="st-error">{{.RestoreError}}</div>{{end}}
{{with .Preflight}}
<div class="st-callout warn">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span>
<span class="ct"><b>Pre-flight — {{.File}}</b><span>Taken {{.TakenAt}} · {{.Subjects}} subjects · schema {{.Schema}}. Applying it overwrites the current data. <a href="/settings?tab=instance&amp;restore-confirm=1">Continue to restore…</a> · <a href="/settings?tab=instance">Discard</a></span></span>
</div>
{{else}}
{{if $.IsAdmin}}
<form method="post" action="/settings/restore/preflight" enctype="multipart/form-data" style="margin:0;display:flex;align-items:center;gap:10px">{{template "backfield" $}}
<label class="st-btn ghost" style="cursor:pointer">Choose archive…<input type="file" name="archive" accept=".tar.gz,.vgbak" style="display:none" onchange="this.form.submit()"></label>
<span class="st-note">Pre-flight only — nothing is applied yet.</span>
</form>
{{end}}
{{end}}
</div></div>
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Instance · release</span><h3>Version &amp; updates</h3></div></div>
<div class="st-body"><div style="display:flex;flex-direction:column;gap:14px">
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
<span style="font:600 15px var(--font-mono);color:var(--text-ink)">{{.Version}}</span>
{{with .Migrations}}{{if .Pending}}<span class="st-badge warn">{{.Pending}} migrations pending</span>{{else}}<span class="st-badge ok">schema current</span>{{end}}{{end}}
</div>
{{with .Release}}
{{if eq .State "newer"}}
<div class="st-callout accent">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg></span>
<span class="ct"><b>{{.Latest.Version}} is available</b><span>{{.Latest.Notes}} Verge never rewrites its own image — the swap is a host action. The exact steps:</span></span>
</div>
<pre style="margin:0;padding:12px 14px;background:var(--surface-inverted);border-radius:12px;font:400 12px/1.7 var(--font-mono);color:var(--text-on-inverted);overflow-x:auto">{{range .Steps}}{{.}}
{{end}}</pre>
{{else if eq .State "current"}}
<span style="display:inline-flex;align-items:center;gap:8px;font:400 12.5px var(--font-ui);color:var(--text-secondary)"><span class="st-dot done"></span>Up to date — checked {{.CheckedAt}}.</span>
{{else}}
<span style="font:400 12.5px var(--font-ui);color:var(--text-muted)">Update checks are off — air-gap friendly; Verge never phones home while disabled. Compare {{$.Instance.Version}} against the releases page when you choose.</span>
{{end}}
<div style="display:flex;align-items:center;gap:12px">
{{if $.IsAdmin}}<form method="post" action="/settings/updates/check" style="margin:0"><input type="hidden" name="enabled" value="{{if .CheckEnabled}}false{{else}}true{{end}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm">{{if .CheckEnabled}}Disable update checks{{else}}Enable update checks{{end}}</button></form>{{end}}
<span class="st-note">Best-effort check against the release feed — a failed check reports nothing and never blocks.</span>
</div>
{{end}}
</div></div>
</section>
{{with .RestoreConfirm}}
<a class="st-scrim" href="/settings?tab=instance" aria-label="Cancel"></a>
<div class="st-dialog"><div class="panel" role="dialog" aria-modal="true" aria-label="Restore archive">
<h2>Restore {{.File}}</h2>
<p class="detail">This overwrites the current estate and configuration with the archive’s ({{.Subjects}} subjects, taken {{.TakenAt}}). Fresh session and prober keys are generated — every session signs in again, and probers re-pin.</p>
<p class="detail" style="color:var(--text-secondary)">Type <span style="font-family:var(--font-mono);font-size:12.5px">restore</span> to confirm.</p>
<form method="post" action="/settings/restore" style="margin:16px 0 0;display:flex;flex-direction:column;gap:16px">{{template "backfield" $}}
<input class="typed" name="confirm" autocomplete="off" spellcheck="false" aria-label="Type restore to confirm" data-typed-confirm="restore">
<div class="acts" style="margin-top:0">
<a class="st-btn ghost" href="/settings?tab=instance">Cancel</a>
<button type="submit" class="st-btn danger" disabled>Restore — overwrite current data</button>
</div>
</form>
</div></div>
{{end}}
{{end}}
{{end}}

{{/* api — holes: .API{Enabled,By,At} .IsAdmin (#390: read-only opt-in /api/v1; bearer path separate from sessions) */}}
{{define "settings-api"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Access · api access</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">API access</h2>
<p class="st-lede">A read-only JSON surface at <code>/api/v1</code>, authenticated by personal tokens — the bearer path is fully separate from browser sessions. It is <strong>off by default</strong>; minted tokens stay inert until an admin turns it on. A token can never mutate anything: leaked, it can read the inventory, but it cannot change the estate or its configuration.</p>
</header>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Read-only · opt-in</span><h3>/api/v1</h3></div></div>
<div class="st-body"><div style="display:flex;flex-direction:column;gap:12px">
{{with .API}}
<div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
{{if .Enabled}}<span class="st-badge ok">enabled</span>{{else}}<span class="st-badge neutral">disabled</span>{{end}}
{{if $.IsAdmin}}
<form method="post" action="/settings/api" style="margin:0"><input type="hidden" name="enabled" value="{{if .Enabled}}false{{else}}true{{end}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm">{{if .Enabled}}Disable API access{{else}}Enable API access{{end}}</button></form>
{{else}}<span class="st-note">You have read access. Enabling or disabling the API is admin-only.</span>{{end}}
{{if .Enabled}}<span class="st-note">Enabled by {{.By}} · {{.At}}</span>{{end}}
</div>
{{if .Enabled}}
<div class="st-callout accent"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="ct"><b>Live — read-only, always</b><span>Personal tokens now answer <span style="font-family:var(--font-mono);font-size:12px">GET /api/v1/…</span> with their account’s read access. No token can change the estate or its configuration — there is no write surface to enable.</span></span></div>
{{else}}
<div class="st-callout"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span><span class="ct"><b>Disabled — the default</b><span><span style="font-family:var(--font-mono);font-size:12px">/api/v1</span> answers nothing and every minted token is inert. Tokens are managed per-account in the Profile; enabling here is the single switch that makes them live.</span></span></div>
{{end}}
{{end}}
</div></div>
</section>
{{end}}

{{/* channels — holes: .ChanError .Channels[{ID,URL,Classes[],ClassStates[{Name,Checked}],HasSecret,Enabled,By,At}] .ClassOptions[{Name,Checked}] .ChanURL .IsAdmin (#26f — class vocabulary from the store; #757 — per-channel Send test POSTs /settings/channels/test {id}, no binding gate: a channel holds its own URL and posts through SendSigned directly, distinct from the integrations Send-test #38/#39 which needs a channel binding) */}}e store) */}}
{{define "settings-channels"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Delivery · channels</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Channels</h2>
<p class="st-lede">A channel is where messages go: an absolute <span style="font-family:var(--font-mono);font-size:12px">https</span> URL, an optional signing secret, and the subset of classes it carries. None ships configured, and a channel is one-way — it grants no read of anything. Routing is by class and nothing finer.</p>
</header>
{{if .ChanError}}<div class="st-error">{{.ChanError}}</div>{{end}}
<section class="st-card{{if .Channels}} flush{{end}}">
<div class="st-cardhead"{{if .Channels}} style="padding-bottom:14px"{{end}}><div class="hd"><span class="st-micro">Declared</span><h3>One-way delivery</h3></div></div>
{{if .Channels}}
<table class="st-table">
<thead><tr><th>URL</th><th>Classes</th><th style="width:80px">Secret</th><th style="width:96px">State</th><th style="width:150px">Declared by</th>{{if .IsAdmin}}<th style="width:150px"></th>{{end}}</tr></thead>
<tbody>
{{range .Channels}}<tr>
<td class="mono">{{.URL}}</td>
<td><span style="display:inline-flex;gap:6px;flex-wrap:wrap">{{range .Classes}}<span class="st-tag">{{.}}</span>{{end}}</span></td>
<td>{{if .HasSecret}}<span class="st-badge ok">set</span>{{else}}<span style="color:var(--text-muted)">not set</span>{{end}}</td>
<td>{{if .Enabled}}<span class="st-badge ok"><span class="d"></span>enabled</span>{{else}}<span class="st-badge neutral">disabled</span>{{end}}</td>
<td class="mono">{{.By}}<br><span style="color:var(--text-muted)">{{.At}}</span></td>
{{if $.IsAdmin}}<td style="overflow:visible">
<span style="display:inline-flex;gap:8px;align-items:center;justify-content:flex-end">
<form method="post" action="/settings/channels/test" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm">Send test</button></form>
<details class="st-disc" style="position:relative">
<summary><span class="st-btn-sm">Edit</span></summary>
<div class="sheet" style="position:absolute;right:0;z-index:95;width:340px;box-shadow:var(--shadow-md);border:1px solid var(--border-default);background:var(--surface-raised)">
<form method="post" action="/settings/channels/update" style="margin:0;display:flex;flex-direction:column;gap:10px">
<input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}
<span class="st-input"><span class="lb">URL</span><span class="iw"><input name="url" value="{{.URL}}" autocomplete="off" required></span></span>
<div style="display:flex;gap:16px;flex-wrap:wrap">
{{range .ClassStates}}<label class="st-check"><input type="checkbox" name="{{.Name}}"{{if .Checked}} checked{{end}}><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>{{.Name}}</label>{{end}}
</div>
<label class="st-check"><input type="checkbox" name="enabled"{{if .Enabled}} checked{{end}}><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>enabled</label>
<span class="st-input"><span class="lb">Replace secret</span><span class="iw"><input name="secret" type="password" autocomplete="off" placeholder="{{if .HasSecret}}set — leave blank to keep{{else}}not set — leave blank for none{{end}}"></span></span>
{{if .HasSecret}}<label class="st-check"><input type="checkbox" name="clear_secret"><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>clear the secret</label>{{end}}
<div style="display:flex;gap:8px"><button type="submit" class="st-btn-sm">Save channel</button></div>
</form>
<form method="post" action="/settings/channels/delete" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm" style="color:var(--danger);border-color:var(--danger-border)">Delete channel</button></form>
</div>
</details>
</span>
</td>{{end}}
</tr>{{end}}
</tbody>
</table>
{{else}}
<div class="st-body"><div class="st-empty">
<span class="msg">No channels declared</span>
<span class="det">Nothing is configured, so every message is written and rendered in the store and carried nowhere else. Declare a channel to have messages POSTed out.</span>
</div></div>
{{end}}
</section>
{{if .IsAdmin}}
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">New channel</span><h3>Declare a channel</h3></div></div>
<div class="st-body">
<form method="post" action="/settings/channels" class="st-form" style="margin:0">
{{template "backfield" $}}<span class="st-input"><span class="lb">Channel URL</span><span class="iw"><input name="url" value="{{.ChanURL}}" placeholder="https://ops.example/hook" autocomplete="off" required></span><span class="hint">One-way https delivery</span></span>
<span class="st-input"><span class="lb">Secret (optional)</span><span class="iw"><input name="secret" type="password" autocomplete="off" placeholder="signs the body — never shown again"></span></span>
<div style="display:flex;flex-direction:column;gap:8px">
<span style="font:500 12.5px var(--font-ui);color:var(--text-body)">Receives</span>
<div style="display:flex;gap:18px;flex-wrap:wrap">
{{range .ClassOptions}}<label class="st-check"><input type="checkbox" name="{{.Name}}"{{if .Checked}} checked{{end}}><span class="box"><svg viewBox="0 0 18 18" width="12" height="12"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="var(--on-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>{{.Name}}</label>{{end}}
</div>
<span class="hint" style="font:400 11.5px var(--font-ui);color:var(--text-muted)">Routing is by class and nothing finer.</span>
</div>
<div><button type="submit" class="st-btn pri">Declare channel</button></div>
</form>
</div>
</section>
{{end}}
{{end}}

{{/* integrations — holes: .IntCats[] .IntCat .IntQ .IntChannels[{Value,Label,Hint}] .Integrations[{ID,Name,Mark,Category,Description,State(installed|attention|available)}] .IntDrawer{ID,Name,Mark,Category,Description,State,Attention,Grants[{Scope,Detail,Write}],Installed,LastDelivery,Classes,BoundChannel} (#26j — PRG: ?cat=&q=&view=; #39 — channel bind POST /settings/integrations/channel {id,channel}, Send test gated on BoundChannel) */}}
{{define "settings-integrations"}}
<header style="display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap">
<div style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Delivery · integrations</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Integrations</h2>
<span class="st-note" style="font-size:12.5px">One-way where possible — Verge pushes, integrations receive. Write-backs are proposals, never acts.</span>
</div>
<div style="margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
<span class="st-seg" role="radiogroup" aria-label="Category">
{{range .IntCats}}<a class="{{if eq . $.IntCat}}on{{end}}" role="radio" aria-checked="{{if eq . $.IntCat}}true{{else}}false{{end}}" href="/settings?tab=integrations&cat={{.}}{{if $.IntQ}}&q={{$.IntQ}}{{end}}">{{.}}</a>{{end}}
</span>
<form method="get" action="/settings" style="margin:0">
<input type="hidden" name="tab" value="integrations">
<input type="hidden" name="cat" value="{{.IntCat}}">
<span class="st-input" style="width:220px"><span class="iw" style="height:30px;border-radius:10px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input type="search" name="q" value="{{.IntQ}}" placeholder="Search integrations" aria-label="Search integrations" style="font-size:12px"></span></span>
</form>
</div>
</header>
<div class="st-callout">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span>
<span class="ct"><b>Webhooks need no integration</b><span>Channels are built in — <a href="/settings?tab=channels">Settings → Channels</a> delivers raw JSON to any URL. Integrations add formatting, acks, and state mapping on top.</span></span>
</div>
{{if .Integrations}}
<div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));gap:16px">
{{range .Integrations}}
<a class="st-tile" href="/settings?tab=integrations&cat={{$.IntCat}}{{if $.IntQ}}&q={{$.IntQ}}{{end}}&view={{.ID}}">
<span style="display:flex;align-items:center;gap:10px">
<span class="mark">{{.Mark}}</span>
<span style="display:flex;flex-direction:column;gap:1px;min-width:0"><span class="nm">{{.Name}}</span><span style="font:400 11px var(--font-mono);color:var(--text-muted)">{{.Category}}</span></span>
<span style="margin-left:auto">{{if eq .State "installed"}}<span class="st-badge ok"><span class="d"></span>installed</span>{{else if eq .State "attention"}}<span class="st-badge warn"><span class="d"></span>needs attention</span>{{else}}<span class="st-badge neutral">available</span>{{end}}</span>
</span>
<span class="ds">{{.Description}}</span>
</a>
{{end}}
</div>
{{else}}
<section class="st-card"><div class="st-body"><div class="st-empty">
<span class="msg">Nothing matches</span>
<span class="det">No integration matches the filter. Clear the search or pick another category.</span>
</div></div></section>
{{end}}
{{with .IntDrawer}}
<a class="st-scrim" style="background:rgba(21,18,15,0.28)" href="/settings?tab=integrations&cat={{$.IntCat}}{{if $.IntQ}}&q={{$.IntQ}}{{end}}" aria-label="Close"></a>
<aside class="st-drawer" role="dialog" aria-modal="true" aria-label="{{.Name}}">
<div class="dh">
<h2>{{.Name}}</h2>
<a class="st-x" href="/settings?tab=integrations&cat={{$.IntCat}}{{if $.IntQ}}&q={{$.IntQ}}{{end}}" aria-label="Close"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></a>
</div>
<div class="db">
<div style="display:flex;align-items:center;gap:10px">
<span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;background:var(--surface-sunken);border:1px solid var(--border-default);font:600 12px var(--font-mono);color:var(--text-secondary)">{{.Mark}}</span>
<span style="font:400 12.5px var(--font-ui);color:var(--text-secondary)">{{.Category}}</span>
<span style="margin-left:auto">{{if eq .State "installed"}}<span class="st-badge ok"><span class="d"></span>installed</span>{{else if eq .State "attention"}}<span class="st-badge warn"><span class="d"></span>needs attention</span>{{else}}<span class="st-badge neutral">available</span>{{end}}</span>
</div>
<p style="margin:0;font:400 13px/1.6 var(--font-ui);color:var(--text-body)">{{.Description}}</p>
{{if .Attention}}
<div class="st-callout warn">
<span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span>
<span class="ct"><b>Delivery failing</b><span>{{.Attention}}</span></span>
</div>
{{end}}
{{if ne .State "available"}}
{{$bound := .BoundChannel}}
<form method="post" action="/settings/integrations/channel" style="margin:0;display:flex;flex-direction:column;gap:8px">{{template "backfield" $}}
<input type="hidden" name="id" value="{{.ID}}">
<span class="st-input"><span class="lb">Delivery channel</span>
<select name="channel" onchange="this.form.submit()" style="height:36px;padding:0 12px;background:var(--surface);color:var(--text-ink);font:400 13px var(--font-ui);border:1px solid var(--border-default);border-radius:12px;outline:none;cursor:pointer">
{{range $.IntChannels}}<option value="{{.Value}}"{{if eq .Value $bound}} selected{{end}}>{{.Label}}</option>{{end}}
</select></span>
<span class="st-note">{{.Name}} formats each message and delivers it through this channel — an integration adds formatting on top of a channel's transport, it isn't a channel itself. Manage channels in <a href="/settings?tab=channels">Settings → Channels</a>.</span>
</form>
{{end}}
<div style="display:flex;flex-direction:column;gap:8px">
<span class="st-micro">This integration can</span>
{{range .Grants}}
<div class="st-grant">
<span class="gic">{{if .Write}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>{{else}}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>{{end}}</span>
<span class="gt"><span class="g1">{{.Scope}}{{if .Write}}<span class="st-badge warn" style="height:18px;font-size:10.5px;padding:0 7px">writes</span>{{end}}</span>{{if .Detail}}<span class="g2">{{.Detail}}</span>{{end}}</span>
</div>
{{end}}
</div>
{{if ne .State "available"}}
<div class="st-kv" style="grid-template-columns:minmax(0,1fr)">
<div class="cell"><span class="st-micro">Installed</span><span class="v">{{.Installed}}</span></div>
<div class="cell"><span class="st-micro">Last delivery</span><span class="v">{{.LastDelivery}}</span></div>
<div class="cell"><span class="st-micro">Classes</span><span class="v">{{.Classes}}</span></div>
</div>
{{end}}
</div>
<div class="df">
{{if eq .State "available"}}
<form method="post" action="/settings/integrations/install" style="margin:0;width:100%"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn pri" style="width:100%">Install {{.Name}}</button></form>
{{else}}
<form method="post" action="/settings/integrations/remove" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn ghost">Remove</button></form>
{{if .BoundChannel}}
<form method="post" action="/settings/integrations/test" style="margin:0;margin-left:auto"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn sec">Send test</button></form>
{{else}}
<span style="margin-left:auto;display:inline-flex;align-items:center;gap:10px"><span class="st-note">Connect a channel to test</span><button type="button" class="st-btn sec" disabled style="opacity:0.45;cursor:default">Send test</button></span>
{{end}}
{{end}}
</div>
</aside>
{{end}}
{{end}}

{{/* messages — holes: .Messages[{ID,Read,Cause,Class,Instant,Headline,Href,LinkText,Census[{Kind,Key,Href}],Deliveries[{State,ChannelHost,Failed,LastError}]}] (#26g) */}}
{{define "settings-messages"}}
<header style="display:flex;align-items:flex-start;gap:16px">
<div style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Delivery · messages</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Messages</h2>
<p class="st-lede">Every message that has fired, newest first. Each names what moved — the estate's own object, our own aperture, your declared input, or a threshold crossed — and links to what it fired at. The store carries the message and never the estate: the fact itself is in the timelines. The <a href="/inbox">Inbox</a> is the reading surface; this is the operational record.</p>
</div>
{{if .Messages}}<form method="post" action="/messages/read-all" style="margin-left:auto;flex:none">{{template "backfield" $}}<button type="submit" class="st-btn sec">Mark all read</button></form>{{end}}
</header>
{{if .Messages}}
<section class="st-card">
<div class="st-body" style="padding-top:6px;padding-bottom:6px">
{{range .Messages}}
<div class="st-msg{{if not .Read}} unread{{end}}">
<div class="mh">
<span class="cause">{{.Cause}}</span>
<span class="st-tag">{{.Class}}</span>
{{if .Instant}}<span class="when">{{.Instant}}</span>{{end}}
</div>
<p class="hl">{{.Headline}}</p>
{{if .Census}}
<div class="st-census">
{{range .Census}}<div class="crow"><span class="k">{{.Kind}}</span>{{if .Href}}<a class="v" href="{{.Href}}">{{.Key}}</a>{{else}}<span class="v">{{.Key}}</span>{{end}}</div>{{end}}
</div>
{{end}}
{{if .Deliveries}}
<div style="display:flex;flex-direction:column;gap:6px">
{{range .Deliveries}}
<div class="st-delrow">
{{if .Failed}}<span class="st-badge danger"><span class="d"></span>undelivered</span><span>to <span class="host">{{.ChannelHost}}</span> — this message could not be delivered, not that nothing fired{{if .LastError}} <span class="why" title="{{.LastError}}">(reason)</span>{{end}}</span>
{{else}}<span>{{.State}} to <span class="host">{{.ChannelHost}}</span></span>{{end}}
</div>
{{end}}
</div>
{{end}}
<div style="display:flex;gap:10px;align-items:center">
<a class="st-btn-sm" href="{{.Href}}">{{.LinkText}}</a>
{{if not .Read}}<form method="post" action="/messages/read" style="margin:0"><input type="hidden" name="id" value="{{.ID}}">{{template "backfield" $}}<button type="submit" class="st-btn-sm" style="border-color:transparent;background:transparent;color:var(--text-secondary)">Mark read</button></form>{{end}}
</div>
</div>
{{end}}
</div>
</section>
{{else}}
<section class="st-card"><div class="st-body"><div class="st-empty">
<span class="msg">No message has fired</span>
<span class="det">Messages appear here as the estate moves — declare a seed and run the first batch to begin measuring.</span>
</div></div></section>
{{end}}
{{end}}

{{/* delivery — holes: .Deliveries[{ChannelHost,Class,Failed,State,When}] .Retention{ObservationCurrencyDays,DispatchCadenceMultiple,TranscriptCurrencyDays,UpdatedAt,UpdatedBy} .RetError .RetObs .RetDispatch .RetTranscript .IsAdmin (#26h) */}}
{{define "settings-delivery"}}
<header style="display:flex;flex-direction:column;gap:6px">
<span class="st-micro">Delivery · operational record</span>
<h2 style="margin:0;font:600 17px var(--font-ui);letter-spacing:var(--heading-tracking);color:var(--text-ink)">Deliveries</h2>
<p class="st-lede">The operational record: every message's outcome to each routed channel, and the retention dials that govern how long the record stays readable. A delivery has no cause and never touches Coverage — an undelivered POST is legible here, joined to the message it failed to carry.</p>
</header>
<section class="st-card{{if .Deliveries}} flush{{end}}">
<div class="st-cardhead"{{if .Deliveries}} style="padding-bottom:14px"{{end}}><div class="hd"><span class="st-micro">Operational record</span><h3>Delivery outcomes</h3></div></div>
{{if .Deliveries}}
<table class="st-table">
<thead><tr><th>Channel</th><th style="width:110px">Class</th><th style="width:130px">Outcome</th><th style="width:80px;text-align:right">When</th></tr></thead>
<tbody>
{{range .Deliveries}}<tr>
<td class="mono">{{.ChannelHost}}</td>
<td><span class="st-tag">{{.Class}}</span></td>
<td>{{if .Failed}}<span class="st-badge danger"><span class="d"></span>undelivered</span>{{else}}<span class="st-badge ok"><span class="d"></span>{{.State}}</span>{{end}}</td>
<td class="mono" style="text-align:right">{{.When}}</td>
</tr>{{end}}
</tbody>
</table>
{{else}}
<div class="st-body"><span class="st-note">No delivery has been attempted yet. Once a channel is declared and a message fires, each outbound POST's outcome is recorded here.</span></div>
{{end}}
</section>
<section class="st-card">
<div class="st-cardhead"><div class="hd"><span class="st-micro">Retention</span><h3>Retention dials</h3></div></div>
<div class="st-body">
<div style="display:flex;flex-direction:column;gap:14px">
<span class="st-note">Retention is what may still be read, never age. Dispatch retention is a multiple of the slowest enabled scan's cadence, floored at 2 cadences; 0 leaves it unbounded, the default. The observation-currency floor lands with later work; for now zero means no operator floor. Transcript retention is a whole number of days, floored at 1 day when positive; 0 leaves raw job output unbounded.</span>
{{if .RetError}}<div class="st-error">{{.RetError}}</div>{{end}}
{{if .IsAdmin}}
<form method="post" action="/settings/retention" style="margin:0;display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap">{{template "backfield" $}}
<span class="st-input" style="width:220px"><span class="lb">Observation-currency floor</span><span class="iw"><input name="observation_currency_days" inputmode="numeric" value="{{if .RetError}}{{.RetObs}}{{else}}{{.Retention.ObservationCurrencyDays}}{{end}}" required><span style="font:400 11.5px var(--font-mono);color:var(--text-muted);flex:none">days</span></span></span>
<span class="st-input" style="width:260px"><span class="lb">Dispatch retention</span><span class="iw"><input name="dispatch_cadence_multiple" inputmode="numeric" value="{{if .RetError}}{{.RetDispatch}}{{else}}{{.Retention.DispatchCadenceMultiple}}{{end}}" required><span style="font:400 11.5px var(--font-mono);color:var(--text-muted);flex:none">× slowest cadence</span></span></span>
<span class="st-input" style="width:220px"><span class="lb">Transcript retention</span><span class="iw"><input name="transcript_currency_days" inputmode="numeric" value="{{if .RetError}}{{.RetTranscript}}{{else}}{{.Retention.TranscriptCurrencyDays}}{{end}}" required><span style="font:400 11.5px var(--font-mono);color:var(--text-muted);flex:none">days</span></span></span>
<button type="submit" class="st-btn sec">Save dials</button>
</form>
{{else}}
<div class="st-kv">
<div class="cell"><span class="st-micro">Observation floor</span><span class="v">{{.Retention.ObservationCurrencyDays}} days</span></div>
<div class="cell"><span class="st-micro">Dispatch retention</span><span class="v">{{.Retention.DispatchCadenceMultiple}} × slowest scan cadence</span></div>
<div class="cell"><span class="st-micro">Transcript retention</span><span class="v">{{.Retention.TranscriptCurrencyDays}} days</span></div>
</div>
{{end}}
{{if .Retention.UpdatedAt}}<span class="st-note">Last changed {{.Retention.UpdatedAt}}{{if .Retention.UpdatedBy}} by <span style="font-family:var(--font-mono)">{{.Retention.UpdatedBy}}</span>{{end}}.</span>{{end}}
</div>
</div>
</section>
{{end}}
