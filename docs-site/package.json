{
  "name": "verge-asm-docs-site",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Verge ASM documentation site. Renders docs/guides/*.md inside the design-system DocsPage shell. Node/Astro build lane; no coupling to the Go app.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:screenshot": "node scripts/screenshot-check.mjs",
    "screenshot:update": "node scripts/screenshot-check.mjs --update"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "astro": "^5.5.0",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0"
  }
}
