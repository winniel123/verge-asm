{
  "name": "verge-asm-docs-site",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Verge ASM documentation site. Renders docs/guides/*.md inside the design-system DocsPage shell. Node/Astro build lane; no coupling to the Go app.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:doclint": "node scripts/doclint.mjs",
    "test:doclint": "node --test scripts/doclint.test.mjs",
    "check:screenshot": "node scripts/screenshot-check.mjs",
    "screenshot:update": "node scripts/screenshot-check.mjs --update"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.4",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "parse-english": "7.0.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "pos": "0.4.2",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2"
  }
}
