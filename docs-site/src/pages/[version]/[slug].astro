---
// Only this route wires all three pipeline stages, and no stage may be redefined here
// (docs-site/PIPELINE.md).
import DocsLayout from "../../layouts/DocsLayout.astro";
import Article from "../../pipeline/render.jsx";
import PrevNext from "../../components/PrevNext.astro";
import { Breadcrumb } from "@ds/components/navigation/Breadcrumb.jsx";
import { resolveSources, listVersions, canonicalPath } from "../../pipeline/source-resolution";
import { extractToc } from "../../pipeline/slug";
import { buildNav } from "../../pipeline/nav-build";

export async function getStaticPaths() {
  // listVersions() yields `latest`, every publishable release tag, and `main`, so one
  // build emits a page set per version (#351).
  const versions = listVersions();
  const paths = [];
  for (const v of versions) {
    const sources = await resolveSources(v.value);
    for (const source of sources) {
      paths.push({
        params: { version: v.value, slug: source.slug },
        props: { source, sources, versions },
      });
    }
  }
  return paths;
}

const { source, sources, versions } = Astro.props;

const toc = extractToc(source.rawMarkdown);
const sections = buildNav(sources, source.slug);
const pageTitle = `${source.frontmatter.title ?? source.slug} · Verge ASM docs`;
// Canonical URL points every version of a page at the `latest` alias (#351 point 4).
const canonical = canonicalPath(source.slug);
// Breadcrumb is driven from the SAME nav model as the rail: find the section that
// owns the active guide, and read its label straight off the built model so the trail
// and rail can never disagree. Form: Docs › <section> › <title>.
const activeSection = sections.find((s) => s.items.some((i) => i.active));
const activeItem = activeSection?.items.find((i) => i.active);
const crumbs = [
  { label: "Docs", href: "/" },
  ...(activeSection
    ? [{ label: activeSection.title, href: activeSection.items[0]?.href ?? "#" }]
    : []),
  { label: activeItem?.label ?? source.frontmatter.title ?? source.slug },
];
---
<DocsLayout
  title={pageTitle}
  description={source.frontmatter.description}
  sections={sections}
  toc={toc}
  versions={versions}
  version={source.version}
  canonical={canonical}
>
  <Breadcrumb items={crumbs} style={{ marginBottom: "24px" }} />
  <Article client:load markdown={source.rawMarkdown} version={source.version} slug={source.slug} versions={versions} />
  <PrevNext sections={sections} />
</DocsLayout>
